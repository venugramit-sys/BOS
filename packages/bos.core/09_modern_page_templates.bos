// ----------------------------------------------------------------------------
// TEMPLATE 5: DocumentCheckoutTemplate (Document / FastTabs & POS Checkout)
// ----------------------------------------------------------------------------
// High-speed order entry with real-time tax, discount cascading, and sticky summary totals.
// ----------------------------------------------------------------------------

page DocumentCheckoutTemplate {
    pageType = Document;
    caption = "High-Speed Document Order & Checkout";
    instructionalText = "Enter order header details, line items, and observe real-time tax, discount, and net totals.";

    variables {
        documentNo: String(30) = "SO-2026-1008";
        customerCode: String(30) = "CUST-0010";
        customerName: String(100) = "Apex Global Retailers";
        orderDate: Date = "2026-10-28";
        currencyCode: String(10) = "USD";
        paymentTerms: String(20) = "Net 30 Days";
        subtotalAmount: Decimal = 8500.00;
        discountPct: Decimal = 5.00;
        discountAmount: Decimal = 425.00;
        taxRatePct: Decimal = 18.00;
        taxAmount: Decimal = 1453.50;
        freightShipping: Decimal = 150.00;
        grandTotal: Decimal = 9678.50;
        documentStatus: String(20) = "Draft";
    }

    layout {
        area(Content) {
            group(GeneralFastTab) {
                caption = "General Order Information";
                field(documentNo) {
                    caption = "Order No";
                    editable = false;
                }
                field(customerCode) {
                    caption = "Customer No";
                    required = true;
                }
                field(customerName) {
                    caption = "Customer Legal Name";
                }
                field(orderDate) {
                    caption = "Order Date";
                }
                field(paymentTerms) {
                    caption = "Payment Terms";
                }
                field(documentStatus) {
                    caption = "Document Status";
                    editable = false;
                }
            }

            group(SummaryTotalsFastTab) {
                caption = "Sticky Checkout Totals & Tax Breakdown";
                instructionalText = "Calculated in real-time with exact decimal precision (zero floating point drift).";
                field(subtotalAmount) {
                    caption = "Gross Subtotal";
                }
                field(discountPct) {
                    caption = "Document Discount (%)";
                }
                field(discountAmount) {
                    caption = "Discount Deducted";
                    editable = false;
                }
                field(taxRatePct) {
                    caption = "Applicable GST / VAT Rate (%)";
                }
                field(taxAmount) {
                    caption = "Calculated Tax Amount";
                    editable = false;
                }
                field(freightShipping) {
                    caption = "Freight & Handling";
                }
                field(grandTotal) {
                    caption = "Net Payable Amount (Grand Total)";
                    editable = false;
                }
            }
        }
    }

    actions {
        action(CalculateTotals) {
            caption = "Recalculate Totals";
            icon = "Calculator";
            onAction(rec, ctx) {
                const vars = (ctx.page && ctx.page.variables) || {};
                const sub = Number(vars.subtotalAmount) || 0;
                const discPct = Number(vars.discountPct) || 0;
                const taxPct = Number(vars.taxRatePct) || 0;
                const freight = Number(vars.freightShipping) || 0;
                const disc = (sub * discPct) / 100;
                const taxable = sub - disc;
                const tax = (taxable * taxPct) / 100;
                const grand = taxable + tax + freight;

                if (ctx.page && ctx.page.variables) {
                    ctx.page.variables.discountAmount = disc;
                    ctx.page.variables.taxAmount = tax;
                    ctx.page.variables.grandTotal = grand;
                }
                ctx.ui.notify("info", "Recalculated totals: Grand Total = $" + grand.toFixed(2));
                return { grandTotal: grand };
            }
        }

        action(ReleaseOrder) {
            caption = "Release Order";
            icon = "Send";
            inFooterBar = true;
            onAction(rec, ctx) {
                if (ctx.page && ctx.page.variables) {
                    ctx.page.variables.documentStatus = "Released";
                }
                ctx.ui.notify("success", "Order released for warehouse fulfillment.");
                return { status: "Released" };
            }
        }

        action(PostAndPrint) {
            caption = "Post and Print Invoice";
            icon = "Printer";
            primary = true;
            inFooterBar = true;
            onAction(rec, ctx) {
                if (ctx.page && ctx.page.variables) {
                    ctx.page.variables.documentStatus = "Posted";
                }
                ctx.ui.notify("success", "Document posted to immutable financial ledger. Dispatched PDF print job.");
                return { status: "Posted", posted: true };
            }
        }
    }
}

// ----------------------------------------------------------------------------
// TEMPLATE 6: AuditComplianceTimeline (NavigatePage / Activity Timeline)
// ----------------------------------------------------------------------------
// Chronological change log and ledger audit feed with cryptographic hash verification.
// ----------------------------------------------------------------------------

page AuditComplianceTimeline {
    pageType = NavigatePage;
    caption = "Compliance & Security Audit Timeline";
    instructionalText = "Chronological immutable ledger change feed, actor identity verification, and integrity signatures.";

    variables {
        totalAuditEvents: Integer = 1420;
        lastVerifiedHash: String(64) = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
        selectedActor: String(50) = "admin@system.local";
        selectedAction: String(30) = "UPDATE_RECORD";
        selectedTable: String(50) = "PurchaseHeader";
        timestampUtc: String(30) = "2026-10-28T18:30:00Z";
        ipAddress: String(45) = "192.168.1.104";
        diffOldValue: String(200) = "{\"status\": \"Draft\", \"amount\": 1200.00}";
        diffNewValue: String(200) = "{\"status\": \"Released\", \"amount\": 1200.00}";
        integrityStatus: String(20) = "VERIFIED_VALID";
    }

    layout {
        area(Content) {
            group(AuditTelemetry) {
                caption = "Audit Integrity Status";
                field(totalAuditEvents) {
                    caption = "Total Immutable Events";
                }
                field(integrityStatus) {
                    caption = "Ledger Cryptographic Status";
                    editable = false;
                }
            }

            group(FocusedEventCard) {
                caption = "Focused Ledger Change Event";
                field(timestampUtc) {
                    caption = "Timestamp (UTC)";
                    editable = false;
                }
                field(selectedActor) {
                    caption = "Authenticated User / Actor";
                    editable = false;
                }
                field(ipAddress) {
                    caption = "Origin IP / Gateway";
                    editable = false;
                }
                field(selectedAction) {
                    caption = "Audit Operation";
                    editable = false;
                }
                field(selectedTable) {
                    caption = "Target Meta-Object";
                    editable = false;
                }
                field(diffOldValue) {
                    caption = "Snapshot (xRec / Previous State)";
                    editable = false;
                }
                field(diffNewValue) {
                    caption = "Committed Mutation (Rec / New State)";
                    editable = false;
                }
                field(lastVerifiedHash) {
                    caption = "SHA-256 Checksum Signature";
                    editable = false;
                }
            }
        }
    }

    actions {
        action(VerifyLedgerSignatures) {
            caption = "Verify Cryptographic Chain";
            icon = "ShieldCheck";
            primary = true;
            inFooterBar = true;
            onAction(rec, ctx) {
                ctx.ui.notify("success", "All 1,420 audit blocks verified with zero hash chain drift.");
                return { verified: true };
            }
        }

        action(ExportAuditReport) {
            caption = "Export Compliance Report (CSV/JSON)";
            icon = "Download";
            inFooterBar = true;
            onAction(rec, ctx) {
                ctx.ui.notify("info", "Generating signed compliance audit manifest...");
                return { exported: true };
            }
        }
    }
}

// ----------------------------------------------------------------------------
// TEMPLATE 7: EnterpriseSettingsCenter (Card / Settings Hub)
// ----------------------------------------------------------------------------
// Centralized organization preferences, security policies, and numbering controls.
// ----------------------------------------------------------------------------

page EnterpriseSettingsCenter {
    pageType = Card;
    caption = "Enterprise Preferences & System Settings";
    instructionalText = "Manage system-wide configuration, password policies, numbering sequences, and webhook integrations.";

    variables {
        portalTitle: String(100) = "BOS Enterprise Cloud";
        defaultLanguage: String(10) = "en-US";
        systemTheme: String(10) = "system";
        passwordExpiryDays: Integer = 90;
        enforceMfa: Boolean = true;
        sessionTimeoutMinutes: Integer = 60;
        maxFailedLogins: Integer = 5;
        defaultInvoiceSeries: String(20) = "INV-2026";
        defaultOrderSeries: String(20) = "ORD-2026";
        webhookEndpointUrl: String(200) = "https://api.partner.com/webhooks/bos";
        enableEventOutbox: Boolean = true;
    }

    layout {
        area(Content) {
            group(GeneralSettingsFastTab) {
                caption = "General Branding & Appearance";
                field(portalTitle) {
                    caption = "Application Title";
                }
                field(defaultLanguage) {
                    caption = "Default Platform Language";
                }
                field(systemTheme) {
                    caption = "Theme Mode (light / dark / system)";
                }
            }

            group(SecurityPolicyFastTab) {
                caption = "Identity, Session & Password Policies";
                field(passwordExpiryDays) {
                    caption = "Password Expiry Interval (Days)";
                }
                field(enforceMfa) {
                    caption = "Mandatory Multi-Factor Authentication";
                }
                field(sessionTimeoutMinutes) {
                    caption = "Inactivity Session Timeout (Minutes)";
                }
                field(maxFailedLogins) {
                    caption = "Failed Login Lockout Threshold";
                }
            }

            group(NumberSeriesFastTab) {
                caption = "Sequential Document Numbering Defaults";
                field(defaultInvoiceSeries) {
                    caption = "Default Sales Invoice Series";
                }
                field(defaultOrderSeries) {
                    caption = "Default Sales Order Series";
                }
            }

            group(IntegrationFastTab) {
                caption = "Webhooks & Event Outbox Dispatcher";
                field(webhookEndpointUrl) {
                    caption = "External Webhook URL";
                }
                field(enableEventOutbox) {
                    caption = "Enable Transactional Event Outbox Worker";
                }
            }
        }
    }

    actions {
        action(SaveSettings) {
            caption = "Save Preferences";
            icon = "Save";
            primary = true;
            inFooterBar = true;
            onAction(rec, ctx) {
                ctx.ui.notify("success", "Enterprise system preferences saved successfully.");
                return { saved: true };
            }
        }

        action(TestWebhook) {
            caption = "Ping Webhook Endpoint";
            icon = "Radio";
            inFooterBar = true;
            onAction(rec, ctx) {
                ctx.ui.notify("info", "Dispatched ping test payload to external webhook gateway.");
                return { pinged: true };
            }
        }
