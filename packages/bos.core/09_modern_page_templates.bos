// ============================================================================
// BOS ENTERPRISE READY-MADE PAGE TEMPLATES COLLECTION
// ============================================================================
// Comprehensive modern page templates showcasing enterprise ERP patterns,
// SaaS UX standards, and full BOS meta-object engine capabilities:
//
// 1. ExecutiveDashboardTemplate  (RoleCenter / C-Suite & Operations Cockpit)
// 2. SetupWizardTemplate         (NavigatePage / Assisted Setup & Onboarding)
// 3. SplitMasterDetailWorklist   (NavigatePage / 2-Column Split Worklist)
// 4. KanbanPipelineTemplate      (NavigatePage / Visual Sales & Order Pipeline)
// 5. DocumentCheckoutTemplate    (Document / FastTabs & High-Speed POS Order)
// 6. AuditComplianceTimeline     (NavigatePage / Activity & Audit Trail)
// 7. EnterpriseSettingsCenter    (Card / FastTabs Settings & Preferences Hub)
// ============================================================================

// ----------------------------------------------------------------------------
// TEMPLATE 1: ExecutiveDashboardTemplate (RoleCenter)
// ----------------------------------------------------------------------------
// Operational overview, real-time financial metrics, KPI cue cards, and quick actions.
// ----------------------------------------------------------------------------

page ExecutiveDashboardTemplate {
    pageType = RoleCenter;
    caption = "Executive Operations Cockpit";
    instructionalText = "High-level overview of enterprise revenue, open transactions, and pending operational tasks.";

    variables {
        grossRevenueYtd: Decimal = 1845200.50;
        pendingApprovalsCount: Integer = 7;
        openOrdersCount: Integer = 24;
        systemHealthPct: Integer = 100;
        monthlyGrowthPct: Decimal = 14.8;
        activeTenantCount: Integer = 3;
    }

    layout {
        area(RoleCenter) {
            headline(WelcomeBanner) {
                caption = "Welcome to BOS Enterprise Operations";
                instructionalText = "All distributed ledgers are synchronized. System health is optimal at 99.99% uptime.";
            }

            cuegroup(FinancialKpis) {
                caption = "Real-Time Financial Cues";
                field(grossRevenueYtd) {
                    caption = "Gross Revenue YTD (USD)";
                }
                field(monthlyGrowthPct) {
                    caption = "MoM Growth Rate (%)";
                }
            }

            cuegroup(OperationalQueues) {
                caption = "Active Operational Queues";
                field(pendingApprovalsCount) {
                    caption = "Pending Approvals";
                }
                field(openOrdersCount) {
                    caption = "Open Orders In Flight";
                }
                field(activeTenantCount) {
                    caption = "Active Corporate Tenants";
                }
            }

            group(SystemOverview) {
                caption = "Platform Diagnostics & Integrity";
                field(systemHealthPct) {
                    caption = "Cluster Health Score (%)";
                    editable = false;
                }
            }
        }
    }

    actions {
        action(NewSalesOrder) {
            caption = "New Sales Order";
            icon = "PlusCircle";
            promoted = true;
            onAction(rec, ctx) {
                ctx.ui.notify("info", "Opening high-speed sales order document...");
                return { action: "open_document", target: "DocumentCheckoutTemplate" };
            }
        }

        action(ApprovePendingQueues) {
            caption = "Batch Review Approvals";
            icon = "CheckCircle2";
            promoted = true;
            onAction(rec, ctx) {
                ctx.ui.notify("success", "Dispatched approval review workflow.");
                return { reviewed: true };
            }
        }

        action(RefreshKpis) {
            caption = "Refresh Metrics";
            icon = "RefreshCw";
            onAction(rec, ctx) {
                ctx.ui.notify("info", "Synchronizing telemetry from database cluster...");
                return { refreshed: true };
            }
        }
    }
}

// ----------------------------------------------------------------------------
// TEMPLATE 2: SetupWizardTemplate (NavigatePage / Assisted Setup)
// ----------------------------------------------------------------------------
// Step-by-step guided onboarding wizard: Organization -> Fiscal -> Compliance -> Finish.
// ----------------------------------------------------------------------------

page SetupWizardTemplate {
    pageType = NavigatePage;
    caption = "Assisted Enterprise Setup Wizard";
    instructionalText = "Follow the guided steps below to configure your company, currency, and regulatory compliance.";

    variables {
        currentStep: Integer = 1;
        companyLegalName: String(100) = "Acme Global Industries Ltd";
        registrationTaxId: String(50) = "GSTIN27AAAAA0000A1Z5";
        industryVertical: String(50) = "Manufacturing & Logistics";
        baseCurrency: String(10) = "USD";
        fiscalStartMonth: Integer = 4;
        enableMultiCurrency: Boolean = true;
        dpdpConsentEnabled: Boolean = true;
        enforceMfaPolicy: Boolean = true;
        sessionTimeoutMinutes: Integer = 30;
        setupCompleted: Boolean = false;
    }

    layout {
        area(Content) {
            group(Step1Organization) {
                caption = "Step 1: Organization & Legal Identity";
                instructionalText = "Enter the primary registered legal entity name and taxation identifier.";
                field(companyLegalName) {
                    caption = "Legal Entity Name";
                    required = true;
                }
                field(registrationTaxId) {
                    caption = "Tax / VAT / GST Registration No";
                    required = true;
                }
                field(industryVertical) {
                    caption = "Industry Classification";
                }
            }

            group(Step2FiscalCalendar) {
                caption = "Step 2: Financial Calendar & Base Currency";
                instructionalText = "Define your functional reporting currency and fiscal accounting start period.";
                field(baseCurrency) {
                    caption = "Functional Base Currency";
                    required = true;
                }
                field(fiscalStartMonth) {
                    caption = "Fiscal Year Starting Month (1-12)";
                }
                field(enableMultiCurrency) {
                    caption = "Enable Multi-Currency Real-Time Conversions";
                }
            }

            group(Step3SecurityCompliance) {
                caption = "Step 3: Security, Governance & DPDP Compliance";
                instructionalText = "Configure data privacy, session protection, and two-factor authentication requirements.";
                field(dpdpConsentEnabled) {
                    caption = "Enforce India DPDP Act 2023 & GDPR Data Retention";
                }
                field(enforceMfaPolicy) {
                    caption = "Mandate Multi-Factor Authentication (TOTP / Passkey)";
                }
                field(sessionTimeoutMinutes) {
                    caption = "Session Idle Timeout (Minutes)";
                }
            }

            group(Step4Confirmation) {
                caption = "Step 4: Review & Initialize Platform";
                instructionalText = "Review your configuration parameters before applying them to the operational schema.";
                field(setupCompleted) {
                    caption = "Configuration Verified and Ready for Production";
                }
            }
        }
    }

    actions {
        action(PreviousStep) {
            caption = "Back";
            icon = "ArrowLeft";
            inFooterBar = true;
            onAction(rec, ctx) {
                const vars = (ctx.page && ctx.page.variables) || {};
                let step = Number(vars.currentStep) || 1;
                if (step > 1) {
                    step -= 1;
                    if (ctx.page && ctx.page.variables) ctx.page.variables.currentStep = step;
                    ctx.ui.notify("info", "Navigated to step " + step);
                }
                return { currentStep: step };
            }
        }

        action(NextStep) {
            caption = "Continue";
            icon = "ArrowRight";
            primary = true;
            inFooterBar = true;
            onAction(rec, ctx) {
                const vars = (ctx.page && ctx.page.variables) || {};
                let step = Number(vars.currentStep) || 1;
                if (step < 4) {
                    step += 1;
                    if (ctx.page && ctx.page.variables) ctx.page.variables.currentStep = step;
                    ctx.ui.notify("info", "Advanced to step " + step);
                } else {
                    ctx.ui.notify("success", "Setup steps complete. Click Finish to initialize.");
                }
                return { currentStep: step };
            }
        }

        action(FinishSetup) {
            caption = "Initialize Workspace";
            icon = "Check";
            promoted = true;
            inFooterBar = true;
            onAction(rec, ctx) {
                const vars = (ctx.page && ctx.page.variables) || {};
                if (ctx.page && ctx.page.variables) ctx.page.variables.setupCompleted = true;
                ctx.ui.notify("success", "Enterprise configuration committed successfully. Workspace initialized!");
                return { success: true, completed: true };
            }
        }
    }
}

// ----------------------------------------------------------------------------
// TEMPLATE 3: SplitMasterDetailWorklist (NavigatePage / 2-Column Split View)
// ----------------------------------------------------------------------------
// High-productivity inbox & ledger reviewer layout like Linear, Zendesk, or Outlook.
// ----------------------------------------------------------------------------

page SplitMasterDetailWorklist {
    pageType = NavigatePage;
    caption = "Master-Detail Split Worklist";
    instructionalText = "Review pending operational documents in the split list pane and inspect live line details on the right.";

    variables {
        selectedDocumentNo: String(30) = "DOC-2026-0042";
        documentStatus: String(20) = "PendingReview";
        customerName: String(100) = "Global Nexus Logistics Ltd";
        documentTotal: Decimal = 12450.00;
        documentCurrency: String(10) = "USD";
        urgencyLevel: String(20) = "High";
        auditNotes: String(250) = "Awaiting final credit limit clearance and tax exemption documentation.";
    }

    layout {
        area(Content) {
            group(WorklistHeader) {
                caption = "Queue Information";
                field(selectedDocumentNo) {
                    caption = "Active Document No";
                    editable = false;
                }
                field(documentStatus) {
                    caption = "Workflow Status";
                }
                field(urgencyLevel) {
                    caption = "Priority";
                }
            }

            group(DocumentSummaryCard) {
                caption = "Customer & Financial Overview";
                field(customerName) {
                    caption = "Customer Account";
                }
                field(documentTotal) {
                    caption = "Total Amount";
                }
                field(documentCurrency) {
                    caption = "Currency";
                }
                field(auditNotes) {
                    caption = "Reviewer Notes";
                }
            }
        }
    }

    actions {
        action(ApproveDocument) {
            caption = "Approve Record";
            icon = "CheckCircle";
            primary = true;
            inFooterBar = true;
            onAction(rec, ctx) {
                if (ctx.page && ctx.page.variables) {
                    ctx.page.variables.documentStatus = "Approved";
                }
                ctx.ui.notify("success", "Document approved and transitioned to next ledger stage.");
                return { status: "Approved" };
            }
        }

        action(RejectDocument) {
            caption = "Reject Record";
            icon = "XCircle";
            inFooterBar = true;
            onAction(rec, ctx) {
                if (ctx.page && ctx.page.variables) {
                    ctx.page.variables.documentStatus = "Rejected";
                }
                ctx.ui.notify("warning", "Document rejected with notification dispatched to submitter.");
                return { status: "Rejected" };
            }
        }

        action(PutOnHold) {
            caption = "Hold for Clarification";
            icon = "Clock";
            inFooterBar = true;
            onAction(rec, ctx) {
                if (ctx.page && ctx.page.variables) {
                    ctx.page.variables.documentStatus = "OnHold";
                }
                ctx.ui.notify("info", "Document placed on hold pending external clarification.");
                return { status: "OnHold" };
            }
        }
    }
}

// ----------------------------------------------------------------------------
