            ]
          ],
          "return_type": null,
          "script": "let conf = null;\ntry {\n    conf = AuthConfiguration.get(\"DEFAULT\");\n} catch (e) {}\nconst payload = (rec && Object.keys(rec).length > 0) ? rec : patchData;\nif (!conf) {\n    return AuthConfiguration.insert({\n        id: \"DEFAULT\",\n        applicationTitle: payload.applicationTitle || \"BOS Enterprise Platform\",\n        companyLogoUrl: payload.companyLogoUrl || \"\",\n        welcomeMessage: payload.welcomeMessage || \"Sign in to access your enterprise workspace.\",\n        primaryColor: payload.primaryColor || \"#4f46e5\",\n        allowRememberMe: payload.allowRememberMe !== undefined ? payload.allowRememberMe : true,\n        allowEmergencyFallback: payload.allowEmergencyFallback !== undefined ? payload.allowEmergencyFallback : true,\n        ssoEnabled: payload.ssoEnabled !== undefined ? payload.ssoEnabled : false,\n        ssoProviderName: payload.ssoProviderName || \"Corporate SSO\",\n        ssoLoginUrl: payload.ssoLoginUrl || \"\",\n        termsOfServiceUrl: payload.termsOfServiceUrl || \"\",\n        supportEmail: payload.supportEmail || \"admin@bos.local\",\n        customDisclaimer: payload.customDisclaimer || \"Authorized personnel only.\"\n    });\n}\nreturn AuthConfiguration.update(\"DEFAULT\", payload);",
