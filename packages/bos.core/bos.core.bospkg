        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "GenerateApiKey",
          "params": [
            [
              "name",
              "String"
            ],
            [
              "scopes",
              "String"
            ],
            [
              "expiryDays",
              "Integer"
            ],
            [
              "createdBy",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const n = (rec && rec.name !== undefined) ? rec.name : name;\nconst sc = (rec && rec.scopes !== undefined) ? rec.scopes : (scopes || \"api:read\");\nconst days = (rec && rec.expiryDays !== undefined) ? rec.expiryDays : (expiryDays || 365);\nconst user = (rec && rec.createdBy !== undefined) ? rec.createdBy : (createdBy || \"admin\");\n\nif (!n) throw new Error(\"Key name is required.\");\n\n// Generate 32-byte cryptographic entropy\nconst rawSecret = ctx.crypto.randomBytes(32).toHex();\nconst prefix = rawSecret.substring(0, 12);\nconst fullKey = `bos_live_${rawSecret}`;\nconst keyHash = ctx.crypto.sha256(fullKey);\n\nconst expiresAt = days > 0\n    ? new Date(Date.now() + days * 24 * 60 * 60 * 1000).toISOString()\n    : null;\n\nconst record = ApiKey.insert({\n    name: String(n).trim(),\n    keyPrefix: `bos_live_${prefix}`,\n    keyHash: keyHash,\n    scopes: sc,\n    expiresAt: expiresAt,\n    status: \"Active\",\n    createdBy: user\n});\n\nSecurityAuditLog.insert({\n    username: user,\n    action: \"RoleAssigned\",\n    details: `New API Key '${n}' generated with prefix 'bos_live_${prefix}...'.`,\n    isSuccess: true\n});\n\nreturn {\n    success: true,\n    id: record.id,\n    name: record.name,\n    prefix: record.keyPrefix,\n    apiKey: fullKey,\n    expiresAt: expiresAt,\n    warning: \"Store this key safely now. For security reasons, it cannot be displayed again.\"\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "VerifyApiKey",
          "params": [
            [
              "rawKey",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const k = (rec && rec.rawKey !== undefined) ? rec.rawKey : rawKey;\nif (!k || !String(k).startsWith(\"bos_live_\")) {\n    return { valid: false, reason: \"INVALID_KEY_FORMAT\" };\n}\n\nconst keyHash = ctx.crypto.sha256(String(k).trim());\nconst keyRecords = ApiKey.find({ keyHash: keyHash }) || [];\nif (keyRecords.length === 0) {\n    return { valid: false, reason: \"KEY_NOT_FOUND\" };\n}\n\nconst keyRecord = keyRecords[0];\nif (keyRecord.status !== \"Active\") {\n    return { valid: false, reason: `KEY_${keyRecord.status.toUpperCase()}` };\n}\n\nif (keyRecord.expiresAt && new Date(keyRecord.expiresAt) <= new Date()) {\n    ApiKey.update(keyRecord.id, { status: \"Expired\" });\n    return { valid: false, reason: \"KEY_EXPIRED\" };\n}\n\nApiKey.update(keyRecord.id, { lastUsedAt: new Date().toISOString() });\n\nreturn {\n    valid: true,\n    name: keyRecord.name,\n    scopes: (keyRecord.scopes || \"api:read\").split(\",\").map(s => s.trim()),\n    createdBy: keyRecord.createdBy\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "RevokeApiKey",
          "params": [
            [
              "keyId",
              "UUID"
            ]
          ],
          "return_type": null,
          "script": "const id = (rec && rec.keyId !== undefined) ? rec.keyId : keyId;\nif (!id) throw new Error(\"Key ID is required.\");\n\nApiKey.update(id, { status: \"Revoked\" });\n\nSecurityAuditLog.insert({\n    username: \"system\",\n    action: \"RoleRevoked\",\n    details: `API Key '${id}' revoked.`,\n    isSuccess: true\n});\n\nreturn { success: true, id: id, status: \"Revoked\" };",
          "trigger_event": null
        }
      ],
      "name": "IntegrationManager",
