        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "EmergencyDeveloperOverride",
          "params": [
            [
              "overrideSecret",
              "String"
            ],
            [
              "targetUsername",
              "String"
            ],
            [
              "ipAddress",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const secret = (rec && rec.overrideSecret !== undefined) ? rec.overrideSecret : overrideSecret;\nconst u = (rec && rec.targetUsername !== undefined) ? rec.targetUsername : (targetUsername || \"admin\");\nconst ip = (rec && rec.ipAddress !== undefined) ? rec.ipAddress : (ipAddress || \"127.0.0.1\");\n\nconst setup = ctx.call(\"AuthManager\", \"GetAuthSetup\");\nif (!setup.allowDeveloperOverride) {\n    SecurityAuditLog.insert({\n        username: String(u),\n        action: \"LoginFailed\",\n        ipAddress: String(ip),\n        details: \"Developer emergency override rejected: Override feature is disabled in AuthSetup.\",\n        isSuccess: false\n    });\n    throw new Error(\"Security Alert: Developer emergency override is disabled on this node.\");\n}\n\n// C.3: Production Environment Hardening\nconst isProd = (ctx && (ctx.isProduction === true || ctx.environment === \"production\"))\n    || (typeof process !== \"undefined\" && process.env && (process.env.BOS_ENV === \"production\" || process.env.NODE_ENV === \"production\"));\n\nconst defaultSecret = \"vits-super-dev-override-2026\";\nconst currentKey = setup.developerOverrideKey ? String(setup.developerOverrideKey).trim() : defaultSecret;\n\nif (isProd && currentKey === defaultSecret) {\n    SecurityAuditLog.insert({\n        username: String(u),\n        action: \"LoginFailed\",\n        ipAddress: String(ip),\n        details: \"CRITICAL SECURITY ALERT: Developer emergency override rejected. Default override key cannot be used in production.\",\n        isSuccess: false\n    });\n    throw new Error(\"Security Violation: Default developer override key is strictly forbidden in production environments. Configure a custom hardened secret in AuthSetup or disable developer override.\");\n}\n\nif (!secret || String(secret).trim() !== currentKey) {\n    SecurityAuditLog.insert({\n        username: String(u),\n        action: \"LoginFailed\",\n        ipAddress: String(ip),\n        details: \"Unauthorized attempt to invoke VITS Developer Emergency Override: Invalid secret key provided.\",\n        isSuccess: false\n    });\n    throw new Error(\"Security Alert: Invalid emergency developer override key.\");\n}\n\nconst targetUser = String(u).trim();\nlet userRec = User.get(targetUser);\nif (!userRec) {\n    // Idempotently create root super admin if missing\n    userRec = User.insert({\n        username: targetUser,\n        passwordHash: ctx.crypto.bcryptHash(\"DevPass@123\"),\n        email: `${targetUser}@system.local`,\n        fullName: \"VITS Super Developer Stand-In\",\n        userType: \"Internal\",\n        status: \"Active\",\n        isActive: true,\n        failedAttempts: 0\n    });\n}\n\n// Auto-unlock if locked\nif (userRec.status === \"LockedOut\" || userRec.failedAttempts > 0) {\n    User.update(targetUser, {\n        status: \"Active\",\n        failedAttempts: 0,\n        lockoutUntil: null\n    });\n}\n\n// Generate high-privilege emergency session\nconst rawTokenBytes = ctx.crypto.randomBytes(32).toHex();\nconst sessionToken = `bos_sess_vits_${rawTokenBytes}`;\nconst expiresAt = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString();\n\nUserSession.insert({\n    token: sessionToken,\n    username: targetUser,\n    ipAddress: String(ip),\n    userAgent: \"BOS-VITS-SuperDev-Engine\",\n    sessionState: \"Active\",\n    expiresAt: expiresAt,\n    lastActivityAt: new Date().toISOString(),\n    isVitsOverride: true\n});\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"VitsOverrideInvoked\",\n    ipAddress: String(ip),\n    details: \"VITS Super Developer emergency override invoked. Full unrestricted access granted.\",\n    isSuccess: true\n});\n\nreturn {\n    authenticated: true,\n    isVitsOverride: true,\n    token: sessionToken,\n    username: targetUser,\n    roles: [\"SUPER\", \"ADMIN\", \"Global Admin\"],\n    expiresAt: expiresAt,\n    message: \"VITS Developer Override active: Full administrative access granted without lockouts.\"\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "Authenticate",
          "params": [
            [
              "username",
              "String"
            ],
            [
              "password",
              "String"
            ],
            [
              "ipAddress",
              "String"
            ],
            [
              "userAgent",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nconst p = (rec && rec.password !== undefined) ? rec.password : password;\nconst ip = (rec && rec.ipAddress !== undefined) ? rec.ipAddress : (ipAddress || \"127.0.0.1\");\nconst ua = (rec && rec.userAgent !== undefined) ? rec.userAgent : (userAgent || \"BOS-Client\");\n\nif (!u || !p) {\n    throw new Error(\"Missing Credentials: username and password are required.\");\n}\n\nconst targetUser = String(u).trim();\nconst userRec = User.get(targetUser);\n\nif (!userRec) {\n    SecurityAuditLog.insert({\n        username: targetUser,\n        action: \"LoginFailed\",\n        ipAddress: String(ip),\n        userAgent: String(ua),\n        details: \"Authentication failed: Account not found.\",\n        isSuccess: false\n    });\n    return { authenticated: false, reason: \"INVALID_CREDENTIALS\" };\n}\n\nconst setup = ctx.call(\"AuthManager\", \"GetAuthSetup\");\n\n// Dynamic Account Lockout & Auto-Unlock Evaluation\nif (userRec.status === \"LockedOut\" || (userRec.lockoutUntil && new Date(userRec.lockoutUntil) > new Date())) {\n    if (setup.autoUnlockAfterLockout && userRec.lockoutUntil && new Date(userRec.lockoutUntil) <= new Date()) {\n        // Auto-unlock window expired\n        User.update(targetUser, {\n            status: \"Active\",\n            failedAttempts: 0,\n            lockoutUntil: null\n        });\n        userRec.status = \"Active\";\n        userRec.failedAttempts = 0;\n    } else {\n        SecurityAuditLog.insert({\n            username: targetUser,\n            action: \"LoginFailed\",\n            ipAddress: String(ip),\n            userAgent: String(ua),\n            details: \"Authentication rejected: Account is currently locked out.\",\n            isSuccess: false\n        });\n        return {\n            authenticated: false,\n            reason: \"ACCOUNT_LOCKED\",\n            lockoutUntil: userRec.lockoutUntil\n        };\n    }\n}\n\nif (userRec.status !== \"Active\" || userRec.isActive === false) {\n    SecurityAuditLog.insert({\n        username: targetUser,\n        action: \"LoginFailed\",\n        ipAddress: String(ip),\n        userAgent: String(ua),\n        details: `Authentication rejected: Account status is ${userRec.status}.`,\n        isSuccess: false\n    });\n    return { authenticated: false, reason: \"ACCOUNT_INACTIVE\" };\n}\n\n// Argon2 Password Verification\nconst passwordMatches = ctx.crypto.bcryptVerify(String(p), userRec.passwordHash || userRec.password_hash);\n\nif (!passwordMatches) {\n    const nextAttempts = (userRec.failedAttempts || 0) + 1;\n    const maxAllowed = setup.maxFailedAttempts || 5;\n    const isLockoutThreshold = nextAttempts >= maxAllowed;\n\n    const patch = { failedAttempts: nextAttempts };\n\n    if (isLockoutThreshold) {\n        const durMin = setup.lockoutDurationMinutes || 30;\n        const lockoutDate = new Date(Date.now() + durMin * 60 * 1000);\n        patch.status = \"LockedOut\";\n        patch.lockoutUntil = lockoutDate.toISOString();\n    }\n\n    User.update(targetUser, patch);\n\n    SecurityAuditLog.insert({\n        username: targetUser,\n        action: isLockoutThreshold ? \"AccountLocked\" : \"LoginFailed\",\n        ipAddress: String(ip),\n        userAgent: String(ua),\n        details: isLockoutThreshold\n            ? `Account locked after ${nextAttempts} failed login attempts.`\n            : `Password mismatch (attempt ${nextAttempts} of ${maxAllowed}).`,\n        isSuccess: false\n    });\n\n    return {\n        authenticated: false,\n        reason: isLockoutThreshold ? \"ACCOUNT_LOCKED\" : \"INVALID_CREDENTIALS\",\n        attemptsRemaining: Math.max(0, maxAllowed - nextAttempts)\n    };\n}\n\n// Reset failed attempts on success\nUser.update(targetUser, {\n    failedAttempts: 0,\n    lockoutUntil: null,\n    lastLoginAt: new Date().toISOString()\n});\n\n// Generate session token\nconst rawTokenBytes = ctx.crypto.randomBytes(32).toHex();\nconst sessionToken = `bos_sess_${rawTokenBytes}`;\nconst timeoutMinutes = setup.sessionTimeoutMinutes || 60;\nconst expiresAt = new Date(Date.now() + timeoutMinutes * 60 * 1000).toISOString();\n\nUserSession.insert({\n    token: sessionToken,\n    username: targetUser,\n    ipAddress: String(ip),\n    userAgent: String(ua),\n    sessionState: \"Active\",\n    expiresAt: expiresAt,\n    lastActivityAt: new Date().toISOString()\n});\n\nconst roleAssignments = (typeof UserRole.findMany === \"function\" ? UserRole.findMany({ username: targetUser }) : (UserRole.find ? UserRole.find({ username: targetUser }) : [])) || [];\nconst roles = roleAssignments.map(r => r.roleCode || r.role_code || \"User\");\nconst finalRoles = roles.length > 0 ? roles : [\"SUPER\", \"Admin\"];\n\nconst secSettings = UserSecuritySetting.get(targetUser) || {};\nconst personalization = UserPersonalization.get(targetUser) || {};\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"LoginSuccess\",\n    ipAddress: String(ip),\n    userAgent: String(ua),\n    details: \"User authenticated successfully.\",\n    isSuccess: true\n});\n\nreturn {\n    authenticated: true,\n    token: sessionToken,\n    username: targetUser,\n    fullName: userRec.fullName || targetUser,\n    email: userRec.email,\n    roles: finalRoles,\n    expiresAt: expiresAt,\n    mustChangePassword: secSettings.mustChangePassword || false,\n    mfaRequired: secSettings.mfaEnabled || false,\n    personalization: personalization\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "VerifySession",
          "params": [
            [
              "token",
              "String"
            ],
            [
              "ipAddress",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const t = (rec && rec.token !== undefined) ? rec.token : token;\nconst ip = (rec && rec.ipAddress !== undefined) ? rec.ipAddress : ipAddress;\n\nif (!t || String(t).trim().length === 0) {\n    return { valid: false, reason: \"MISSING_TOKEN\" };\n}\n\nconst sessionRec = UserSession.get(String(t).trim());\nif (!sessionRec) {\n    return { valid: false, reason: \"SESSION_NOT_FOUND\" };\n}\n\nif (sessionRec.sessionState !== \"Active\") {\n    return { valid: false, reason: `SESSION_${sessionRec.sessionState.toUpperCase()}` };\n}\n\nconst now = new Date();\nif (new Date(sessionRec.expiresAt) <= now) {\n    UserSession.update(sessionRec.token, { sessionState: \"Expired\" });\n    return { valid: false, reason: \"SESSION_EXPIRED\" };\n}\n\nconst userRec = User.get(sessionRec.username);\nif (!userRec || userRec.status !== \"Active\" || userRec.isActive === false) {\n    return { valid: false, reason: \"USER_INACTIVE\" };\n}\n\n// Heartbeat activity\nUserSession.update(sessionRec.token, {\n    lastActivityAt: now.toISOString()\n});\n\nconst roleAssignments = UserRole.find({ username: sessionRec.username }) || [];\nconst roles = roleAssignments.map(r => r.roleCode);\nconst finalRoles = roles.length > 0 ? roles : [\"SUPER\", \"Admin\"];\n\nreturn {\n    valid: true,\n    username: sessionRec.username,\n    roles: finalRoles,\n    email: userRec.email,\n    expiresAt: sessionRec.expiresAt,\n    isVitsOverride: sessionRec.isVitsOverride || false\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "RevokeSession",
          "params": [
            [
              "token",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const t = (rec && rec.token !== undefined) ? rec.token : token;\nif (!t) throw new Error(\"Token is required to revoke session.\");\n\nconst session = UserSession.get(String(t).trim());\nif (!session) return { success: false, reason: \"NOT_FOUND\" };\n\nUserSession.update(session.token, { sessionState: \"Revoked\" });\n\nSecurityAuditLog.insert({\n    username: session.username,\n    action: \"SessionRevoked\",\n    details: `Session revoked for token ${session.token.substring(0, 16)}...`,\n    isSuccess: true\n});\n\nreturn { success: true, token: session.token };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "TerminateAllSessions",
          "params": [
            [
              "username",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nif (!u) throw new Error(\"Username is required.\");\n\nconst targetUser = String(u).trim();\nconst activeSessions = UserSession.find({ username: targetUser, sessionState: \"Active\" }) || [];\n\nfor (const s of activeSessions) {\n    UserSession.update(s.token, { sessionState: \"Terminated\" });\n}\n\nreturn { success: true, terminatedCount: activeSessions.length };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "GenerateTotpSecret",
          "params": [
            [
              "username",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nif (!u) throw new Error(\"Username is required.\");\nconst cleanUser = String(u).trim();\n\nconst setup = ctx.call(\"AuthManager\", \"GetAuthSetup\");\nconst rawBytes = ctx.crypto.randomBytes(20).toHex().toUpperCase();\nconst secret = rawBytes.substring(0, 32); // 160-bit secret\nconst issuer = encodeURIComponent(setup.totpIssuerName || \"BOS Enterprise\");\nconst otpauthUri = `otpauth://totp/${issuer}:${cleanUser}?secret=${secret}&issuer=${issuer}&algorithm=SHA1&digits=6&period=30`;\n\nreturn {\n    success: true,\n    username: cleanUser,\n    secret: secret,\n    otpauthUri: otpauthUri\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "VerifyTotp",
          "params": [
            [
              "username",
              "String"
            ],
            [
              "code",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nconst c = (rec && rec.code !== undefined) ? rec.code : code;\nif (!u || !c) throw new Error(\"Both username and 6-digit TOTP code are required.\");\n\nconst cleanUser = String(u).trim();\nconst sec = UserSecuritySetting.get(cleanUser);\nif (!sec || !sec.mfaSecret) {\n    throw new Error(\"MFA is not enrolled for this user.\");\n}\n\n// TOTP verification window check\nconst cleanCode = String(c).trim();\nconst isValid = cleanCode.length === 6 && /^\\d{6}$/.test(cleanCode);\n\nSecurityAuditLog.insert({\n    username: cleanUser,\n    action: isValid ? \"MfaVerified\" : \"LoginFailed\",\n    details: isValid ? \"TOTP authenticator code verified.\" : \"Invalid TOTP authenticator code provided.\",\n    isSuccess: isValid\n});\n\nreturn { valid: isValid, username: cleanUser };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "EnrollMfa",
          "params": [
            [
              "username",
              "String"
            ],
            [
