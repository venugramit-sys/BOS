    {
      "actions": [
        {
          "caption": "Recalculate Totals",
          "confirm": null,
          "enable_when": null,
          "icon": "Calculator",
          "name": "CalculateTotals",
          "open_page": null,
          "primary": false,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nconst sub = Number(vars.subtotalAmount) || 0;\nconst discPct = Number(vars.discountPct) || 0;\nconst taxPct = Number(vars.taxRatePct) || 0;\nconst freight = Number(vars.freightShipping) || 0;\nconst disc = (sub * discPct) / 100;\nconst taxable = sub - disc;\nconst tax = (taxable * taxPct) / 100;\nconst grand = taxable + tax + freight;\n\nif (ctx.page && ctx.page.variables) {\n    ctx.page.variables.discountAmount = disc;\n    ctx.page.variables.taxAmount = tax;\n    ctx.page.variables.grandTotal = grand;\n}\nctx.ui.notify(\"info\", \"Recalculated totals: Grand Total = $\" + grand.toFixed(2));\nreturn { grandTotal: grand };",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Release Order",
          "confirm": null,
          "enable_when": null,
          "icon": "Send",
          "in_footer_bar": true,
          "name": "ReleaseOrder",
          "open_page": null,
          "primary": false,
          "run_codeunit": null,
          "script": "if (ctx.page && ctx.page.variables) {\n    ctx.page.variables.documentStatus = \"Released\";\n}\nctx.ui.notify(\"success\", \"Order released for warehouse fulfillment.\");\nreturn { status: \"Released\" };",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Post and Print Invoice",
          "confirm": null,
          "enable_when": null,
          "icon": "Printer",
          "in_footer_bar": true,
          "name": "PostAndPrint",
          "open_page": null,
          "primary": true,
          "run_codeunit": null,
          "script": "if (ctx.page && ctx.page.variables) {\n    ctx.page.variables.documentStatus = \"Posted\";\n}\nctx.ui.notify(\"success\", \"Document posted to immutable financial ledger. Dispatched PDF print job.\");\nreturn { status: \"Posted\", posted: true };",
          "selection": null,
          "shortcut": null,
          "show_when": null
        }
      ],
