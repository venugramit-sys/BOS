      ],
      "sql_table_name": "auth_setup",
      "table_type": "Normal",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.primaryKeyCode || String(rec.primaryKeyCode).trim().length === 0) {\n    rec.primaryKeyCode = \"PRIMARY\";\n}\nif (rec.minPasswordLength !== undefined && rec.minPasswordLength < 6) {\n    throw new Error(\"Validation Failed: 'minPasswordLength' must be at least 6 characters.\");\n}\nif (rec.maxFailedAttempts !== undefined && rec.maxFailedAttempts < 1) {\n    throw new Error(\"Validation Failed: 'maxFailedAttempts' must be at least 1.\");\n}\nif (rec.lockoutDurationMinutes !== undefined && rec.lockoutDurationMinutes < 1) {\n    throw new Error(\"Validation Failed: 'lockoutDurationMinutes' must be at least 1.\");\n}\nif (rec.sessionTimeoutMinutes !== undefined && rec.sessionTimeoutMinutes < 5) {\n    throw new Error(\"Validation Failed: 'sessionTimeoutMinutes' must be at least 5 minutes.\");\n}"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (rec.minPasswordLength !== undefined && rec.minPasswordLength < 6) {\n    throw new Error(\"Validation Failed: 'minPasswordLength' must be at least 6 characters.\");\n}\nif (rec.maxFailedAttempts !== undefined && rec.maxFailedAttempts < 1) {\n    throw new Error(\"Validation Failed: 'maxFailedAttempts' must be at least 1.\");\n}\nif (rec.lockoutDurationMinutes !== undefined && rec.lockoutDurationMinutes < 1) {\n    throw new Error(\"Validation Failed: 'lockoutDurationMinutes' must be at least 1.\");\n}\nif (rec.sessionTimeoutMinutes !== undefined && rec.sessionTimeoutMinutes < 5) {\n    throw new Error(\"Validation Failed: 'sessionTimeoutMinutes' must be at least 5 minutes.\");\n}"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.primaryKeyCode === \"PRIMARY\") {\n    throw new Error(\"Validation Failed: The 'PRIMARY' security configuration setup cannot be deleted.\");\n}"
        }
      ],
      "version": "1.0.0"
    },
