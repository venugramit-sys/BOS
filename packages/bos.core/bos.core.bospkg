        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "GetSetup",
          "params": [],
          "return_type": null,
          "script": "let setup = null;\ntry {\n    setup = CoreSetup.get(\"PRIMARY\");\n} catch (e) {}\nif (!setup) {\n    return {\n        primaryKeyCode: \"PRIMARY\",\n        applicationTitle: \"BOS Business Operating System\",\n        applicationSubtitle: \"Next-Generation Intelligent Enterprise Architecture\",\n        colorTheme: \"CorporateBlue\",\n        themeMode: \"SystemAuto\",\n        enableCompactDensity: false,\n        defaultLocale: \"en-US\",\n        defaultTimezone: \"UTC\",\n        dateFormat: \"YYYY_MM_DD\",\n        timeFormat: \"H24\",\n        numberFormat: \"PeriodDecimal\",\n        baseCurrencyCode: \"USD\",\n        currencySymbol: \"$\",\n        currencyPosition: \"BeforeAmount\",\n        enableAuditChaining: true,\n        isMaintenanceMode: false\n    };\n}\nreturn setup;",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "UpdateSetup",
          "params": [
            [
              "patchData",
              "any"
            ]
          ],
          "return_type": null,
          "script": "const patch = (rec && rec.patchData !== undefined) ? rec.patchData : (patchData || rec || {});\nlet current = CoreSetup.get(\"PRIMARY\");\nif (!current) {\n    ctx.call(\"CoreManager\", \"InitializeCoreSetup\");\n    current = CoreSetup.get(\"PRIMARY\");\n}\nconst updated = CoreSetup.update(\"PRIMARY\", patch);\nreturn { success: true, setup: updated };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "InitializeCoreSetup",
          "params": [],
          "return_type": null,
          "script": "const defaults = {\n    primaryKeyCode: \"PRIMARY\",\n    applicationTitle: \"BOS Business Operating System\",\n    applicationSubtitle: \"Next-Generation Intelligent Enterprise Architecture\",\n    applicationLogoUrl: \"\",\n    faviconUrl: \"\",\n    supportContactEmail: \"support@bos.local\",\n    colorTheme: \"CorporateBlue\",\n    themeMode: \"SystemAuto\",\n    enableCompactDensity: false,\n    defaultLocale: \"en-US\",\n    defaultTimezone: \"UTC\",\n    dateFormat: \"YYYY_MM_DD\",\n    timeFormat: \"H24\",\n    numberFormat: \"PeriodDecimal\",\n    baseCurrencyCode: \"USD\",\n    currencySymbol: \"$\",\n    currencyPosition: \"BeforeAmount\",\n    enableAuditChaining: true,\n    isMaintenanceMode: false,\n    maintenanceMessage: \"System is undergoing planned maintenance. Please check back shortly.\"\n};\nif (CoreSetup.get(\"PRIMARY\")) {\n    CoreSetup.update(\"PRIMARY\", defaults);\n} else {\n    CoreSetup.insert(defaults);\n}\n\nif (!Currency.get(\"USD\")) {\n    Currency.insert({ code: \"USD\", name: \"United States Dollar\", symbol: \"$\", decimalPlaces: 2, isBaseCurrency: true, isActive: true });\n}\nif (!Currency.get(\"EUR\")) {\n    Currency.insert({ code: \"EUR\", name: \"Euro\", symbol: \"EUR\", decimalPlaces: 2, isBaseCurrency: false, isActive: true });\n}\nif (!Currency.get(\"INR\")) {\n    Currency.insert({ code: \"INR\", name: \"Indian Rupee\", symbol: \"INR\", decimalPlaces: 2, isBaseCurrency: false, isActive: true });\n}\nif (!Currency.get(\"GBP\")) {\n    Currency.insert({ code: \"GBP\", name: \"British Pound\", symbol: \"GBP\", decimalPlaces: 2, isBaseCurrency: false, isActive: true });\n}\n\nif (!CountryRegion.get(\"US\")) {\n    CountryRegion.insert({ code: \"US\", name: \"United States\", isoNumericCode: \"840\", defaultCurrencyCode: \"USD\", isActive: true });\n}\nif (!CountryRegion.get(\"IN\")) {\n    CountryRegion.insert({ code: \"IN\", name: \"India\", isoNumericCode: \"356\", defaultCurrencyCode: \"INR\", isActive: true });\n}\nif (!CountryRegion.get(\"GB\")) {\n    CountryRegion.insert({ code: \"GB\", name: \"United Kingdom\", isoNumericCode: \"826\", defaultCurrencyCode: \"GBP\", isActive: true });\n}\nif (!CountryRegion.get(\"DE\")) {\n    CountryRegion.insert({ code: \"DE\", name: \"Germany\", isoNumericCode: \"276\", defaultCurrencyCode: \"EUR\", isActive: true });\n}\n\nreturn { success: true, message: \"Core setup initialized successfully.\" };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "CreateCompany",
          "params": [
            [
              "code",
              "String"
            ],
            [
              "name",
              "String"
            ],
            [
              "baseCurrency",
              "String"
            ],
            [
              "countryCode",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const c = (rec && rec.code !== undefined) ? rec.code : code;\nconst n = (rec && rec.name !== undefined) ? rec.name : name;\nconst curr = (rec && rec.baseCurrency !== undefined) ? rec.baseCurrency : (baseCurrency || \"USD\");\nconst cc = (rec && rec.countryCode !== undefined) ? rec.countryCode : (countryCode || \"US\");\n\nif (!c || !n) throw new Error(\"Both company code and company name are required.\");\nconst cleanCode = String(c).toUpperCase().trim();\n\nif (Company.get(cleanCode)) {\n    throw new Error(`Company with code '${cleanCode}' already exists.`);\n}\n\nconst newCompany = Company.insert({\n    code: cleanCode,\n    name: String(n).trim(),\n    legalName: String(n).trim(),\n    baseCurrencyCode: String(curr).toUpperCase().trim(),\n    countryCode: String(cc).toUpperCase().trim(),\n    status: \"Active\",\n    isActive: true,\n    isDefaultCompany: false\n});\n\nreturn { success: true, company: newCompany };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "CreateTenant",
          "params": [
            [
              "code",
              "String"
            ],
            [
              "name",
              "String"
            ],
            [
              "tier",
              "String"
            ],
            [
              "contactEmail",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const c = (rec && rec.code !== undefined) ? rec.code : code;\nconst n = (rec && rec.name !== undefined) ? rec.name : name;\nconst t = (rec && rec.tier !== undefined) ? rec.tier : (tier || \"Professional\");\nconst email = (rec && rec.contactEmail !== undefined) ? rec.contactEmail : contactEmail;\n\nif (!c || !n) throw new Error(\"Both tenant code and tenant name are required.\");\nconst cleanCode = String(c).toLowerCase().trim();\n\nif (Tenant.get(cleanCode)) {\n    throw new Error(`Tenant with code '${cleanCode}' already exists.`);\n}\n\nconst newTenant = Tenant.insert({\n    code: cleanCode,\n    name: String(n).trim(),\n    tier: t,\n    status: \"Active\",\n    maxUsers: t === \"Enterprise\" ? 500 : 50,\n    storageQuotaMb: t === \"Enterprise\" ? 102400 : 10240,\n    primaryContactEmail: email ? String(email).trim() : \"\",\n    isActive: true\n});\n\nreturn { success: true, tenant: newTenant };",
          "trigger_event": null
        }
      ],
