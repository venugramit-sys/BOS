          ],
          "script": "if (!rec.dimensionCode || String(rec.dimensionCode).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'dimensionCode' is required.\");\n}\nif (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'code' is required.\");\n}\nrec.dimensionCode = String(rec.dimensionCode).toUpperCase().trim();\nrec.code = String(rec.code).toUpperCase().trim();\nif (!rec.id) {\n    rec.id = ctx.crypto.uuidv7();\n}"
        }
      ],
      "version": "1.0.0"
    },
