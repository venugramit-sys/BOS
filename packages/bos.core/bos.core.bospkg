    {
      "field_validations": [],
      "methods": [],
      "name": "DimensionLogic",
      "object_type": "tablelogic",
      "package_name": "bos.core",
      "sql_table_name": "dimension",
      "target_table": "Dimension",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: Dimension 'code' is mandatory.\");\n}\nrec.code = String(rec.code).toUpperCase().trim();\nif (!rec.name || String(rec.name).trim().length === 0) {\n    rec.name = rec.code;\n}"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "const values = DimensionValue.findMany({ where: { dimensionCode: rec.code } });\nif (values && values.length > 0) {\n    throw new Error(`Cannot delete Dimension '${rec.code}' because Dimension Values exist for it.`);\n}"
        }
      ],
      "version": "1.0.0"
    },
    {
