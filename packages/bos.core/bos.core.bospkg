      "methods": [
        {
          "actions": [],
          "annotations": [
            "businessEvent"
          ],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "onApiKeyGenerated",
          "params": [
            [
              "name",
              "String"
            ],
            [
              "keyPrefix",
