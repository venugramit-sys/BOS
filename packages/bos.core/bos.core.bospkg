    {
      "actions": [
        {
          "caption": "Back",
          "confirm": null,
          "enable_when": null,
          "icon": "ArrowLeft",
          "in_footer_bar": true,
          "name": "PreviousStep",
          "open_page": null,
          "primary": false,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nlet step = Number(vars.currentStep) || 1;\nif (step > 1) {\n    step -= 1;\n    if (ctx.page && ctx.page.variables) ctx.page.variables.currentStep = step;\n    ctx.ui.notify(\"info\", \"Navigated to step \" + step);\n}\nreturn { currentStep: step };",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Continue",
          "confirm": null,
          "enable_when": null,
          "icon": "ArrowRight",
          "in_footer_bar": true,
          "name": "NextStep",
          "open_page": null,
          "primary": true,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nlet step = Number(vars.currentStep) || 1;\nif (step < 4) {\n    step += 1;\n    if (ctx.page && ctx.page.variables) ctx.page.variables.currentStep = step;\n    ctx.ui.notify(\"info\", \"Advanced to step \" + step);\n} else {\n    ctx.ui.notify(\"success\", \"Setup steps complete. Click Finish to initialize.\");\n}\nreturn { currentStep: step };",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Initialize Workspace",
          "confirm": null,
          "enable_when": null,
          "icon": "Check",
          "in_footer_bar": true,
          "name": "FinishSetup",
          "open_page": null,
          "primary": true,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nif (ctx.page && ctx.page.variables) ctx.page.variables.setupCompleted = true;\nctx.ui.notify(\"success\", \"Enterprise configuration committed successfully. Workspace initialized!\");\nreturn { success: true, completed: true };",
          "selection": null,
          "shortcut": null,
          "show_when": null
        }
      ],
