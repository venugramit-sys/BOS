          "in_footer_bar": true,
          "name": "SignIn",
          "open_page": null,
          "primary": true,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nconst u = vars.username || (rec && rec.username);\nconst p = vars.password || (rec && rec.password);\nif (!u || !p) throw new Error(\"Please specify both User ID and Password.\");\nreturn ctx.call(\"AuthManager\", \"Authenticate\", { username: u, password: p });",
          "selection": null,
          "shortcut": null,
          "show_when": null
        }
      ],
