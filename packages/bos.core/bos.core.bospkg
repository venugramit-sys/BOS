          "primary": false,
          "run_codeunit": null,
          "script": "if (ctx.page && ctx.page.variables) {\n    ctx.page.variables.documentStatus = \"OnHold\";\n}\nctx.ui.notify(\"info\", \"Document placed on hold pending external clarification.\");\nreturn { status: \"OnHold\" };",
          "selection": null,
          "shortcut": null,
          "show_when": null
        }
