    },
    {
      "bound_table": null,
      "execution_mode": "BytecodeInterpreter",
      "is_exposed": false,
      "is_pushdown": false,
      "is_transactional": true,
      "max_fuel": 100000,
      "methods": [
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "InitializeDefaultSeries",
          "params": [],
          "return_type": null,
          "script": "if (!NoSeriesSetup.get(\"PRIMARY\")) {\n    NoSeriesSetup.insert({\n        primaryKeyCode: \"PRIMARY\",\n        enforceStrictChronology: true,\n        preventNumberReuse: true,\n        warningThresholdPercent: 90,\n        auditSequenceAllocations: true\n    });\n}\n\nconst standardSeries = [\n    { code: \"CUST\", desc: \"Customer Account Sequences\", type: \"Customer\", start: \"C-10001\", end: \"C-99999\" },\n    { code: \"VEND\", desc: \"Vendor Account Sequences\", type: \"Vendor\", start: \"V-10001\", end: \"V-99999\" },\n    { code: \"ITEM\", desc: \"Inventory Item Numbers\", type: \"Item\", start: \"ITM-10001\", end: \"ITM-99999\" },\n    { code: \"SO\", desc: \"Sales Orders\", type: \"Document\", start: \"SO-2026-00001\", end: \"SO-2026-99999\" },\n    { code: \"SI_POST\", desc: \"Posted Sales Invoices\", type: \"Financial\", start: \"INV-2026-00001\", end: \"INV-2026-99999\" },\n    { code: \"PO\", desc: \"Purchase Orders\", type: \"Document\", start: \"PO-2026-00001\", end: \"PO-2026-99999\" },\n    { code: \"PI_POST\", desc: \"Posted Purchase Invoices\", type: \"Financial\", start: \"PINV-2026-00001\", end: \"PINV-2026-99999\" },\n    { code: \"GL_JNL\", desc: \"General Ledger Journal Batches\", type: \"Financial\", start: \"GL-2026-00001\", end: \"GL-2026-99999\" }\n];\n\nfor (let i = 0; i < standardSeries.length; i++) {\n    const s = standardSeries[i];\n    if (!NoSeries.get(s.code)) {\n        NoSeries.insert({\n            code: s.code,\n            description: s.desc,\n            seriesType: s.type,\n            defaultNos: true,\n            manualNos: false,\n            dateOrder: true,\n            isActive: true\n        });\n\n        NoSeriesLine.insert({\n            id: ctx.crypto.uuidv7(),\n            seriesCode: s.code,\n            lineNo: 10000,\n            startingDate: \"2026-01-01\",\n            startingNo: s.start,\n            endingNo: s.end,\n            warningNo: s.end,\n            incrementBy: 1,\n            lastNoUsed: \"\",\n            isOpen: true\n        });\n    }\n}\n\nreturn { success: true, message: \"Standard enterprise number series initialized successfully.\" };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "GetNextNo",
          "params": [
            [
              "seriesCode",
              "String"
            ],
            [
              "targetDate",
