      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'code' is required for Role.\");\n}\nrec.code = String(rec.code).toUpperCase().trim();\n\nif (!/^[A-Z0-9_]{2,30}$/.test(rec.code)) {\n    throw new Error(\"Validation Failed: Role code must be uppercase alphanumeric/underscore between 2 and 30 characters.\");\n}\n\nif (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'name' is required for Role.\");\n}\nrec.name = String(rec.name).trim();\n\nif (rec.isSystemRole === undefined) {\n    rec.isSystemRole = false;\n}"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (xRec.isSystemRole && rec.isActive === false) {\n    throw new Error(\"System Protection: Built-in system roles cannot be deactivated.\");\n}"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.isSystemRole || rec.code === \"SUPER\" || rec.code === \"ADMIN\") {\n    throw new Error(\"Deletion Blocked: System baseline roles cannot be deleted.\");\n}"
        }
      ],
      "version": "1.0.0"
    },
