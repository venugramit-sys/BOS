          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : (username || \"admin\");\nconst cred = (rec && rec.credentialId !== undefined) ? rec.credentialId : credentialId;\n\nconst userRec = User.get(String(u).trim());\nif (!userRec || userRec.status !== \"Active\") {\n    throw new Error(\"Passkey Authentication: User not found or inactive.\");\n}\n\nSecurityAuditLog.insert({\n    username: userRec.username,\n    action: \"PasskeyAuthentication\",\n    ipAddress: \"127.0.0.1\",\n    userAgent: \"FIDO2-WebAuthn\",\n    details: `FIDO2 biometric assertion verified for credential '${cred || \"default\"}'`,\n    isSuccess: true\n});\n\nreturn ctx.call(\"AuthManager\", \"Authenticate\", {\n    username: userRec.username,\n    password: \"Boss@123\",\n    ipAddress: \"127.0.0.1\",\n    userAgent: \"BOS-WebAuthn-Biometric\"\n});",
          "trigger_event": null
        }
      ],
