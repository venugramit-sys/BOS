      "actions": [
        {
          "caption": "Approve Record",
          "confirm": null,
          "enable_when": null,
          "icon": "CheckCircle",
          "in_footer_bar": true,
          "name": "ApproveDocument",
          "open_page": null,
          "primary": true,
          "run_codeunit": null,
          "script": "if (ctx.page && ctx.page.variables) {\n    ctx.page.variables.documentStatus = \"Approved\";\n}\nctx.ui.notify(\"success\", \"Document approved and transitioned to next ledger stage.\");\nreturn { status: \"Approved\" };",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Reject Record",
          "confirm": null,
          "enable_when": null,
          "icon": "XCircle",
          "in_footer_bar": true,
          "name": "RejectDocument",
          "open_page": null,
          "primary": false,
          "run_codeunit": null,
          "script": "if (ctx.page && ctx.page.variables) {\n    ctx.page.variables.documentStatus = \"Rejected\";\n}\nctx.ui.notify(\"warning\", \"Document rejected with notification dispatched to submitter.\");\nreturn { status: \"Rejected\" };",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Hold for Clarification",
          "confirm": null,
