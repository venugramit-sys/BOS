        {
          "actions": [],
          "annotations": [
            "businessEvent"
          ],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "onApiKeyRevoked",
          "params": [
            [
              "id",
              "UUID"
            ]
          ],
          "return_type": null,
