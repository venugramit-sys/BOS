          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: ServiceAccount 'code' is required.\");\n}\nrec.code = String(rec.code).toLowerCase().trim();"
        }
      ],
      "version": "1.0.0"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "NoSeriesLogic",
      "object_type": "tablelogic",
      "package_name": "bos.core",
      "sql_table_name": "no_series",
      "target_table": "NoSeries",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: NoSeries 'code' is mandatory.\");\n}\nrec.code = String(rec.code).toUpperCase().trim();\nif (!/^[A-Z0-9_-]{1,20}$/.test(rec.code)) {\n    throw new Error(\"Validation Failed: NoSeries code must be uppercase alphanumeric (1-20 chars).\");\n}"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: NoSeries 'code' cannot be blank.\");\n}"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "// Prevent deletion if series lines exist with allocated numbers\nconst lines = NoSeriesLine.findMany({ where: { seriesCode: rec.code } });\nif (lines && lines.length > 0) {\n    for (let i = 0; i < lines.length; i++) {\n        if (lines[i].lastNoUsed && String(lines[i].lastNoUsed).trim().length > 0) {\n            throw new Error(`Cannot delete NoSeries '${rec.code}' because document numbers have already been allocated.`);\n        }\n    }\n    // If lines have no allocated numbers, clean up lines\n    NoSeriesLine.deleteAll({ seriesCode: rec.code });\n}"
        }
      ],
      "version": "1.0.0"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "NoSeriesLineLogic",
      "object_type": "tablelogic",
      "package_name": "bos.core",
      "sql_table_name": "no_series_line",
      "target_table": "NoSeriesLine",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.seriesCode || String(rec.seriesCode).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'seriesCode' is mandatory on NoSeriesLine.\");\n}\nif (!rec.startingNo || String(rec.startingNo).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'startingNo' is required.\");\n}\nif (rec.incrementBy === undefined || rec.incrementBy < 1) {\n    rec.incrementBy = 1;\n}\nif (!rec.id) {\n    rec.id = ctx.crypto.uuidv7();\n}"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (rec.incrementBy === undefined || rec.incrementBy < 1) {\n    throw new Error(\"Validation Failed: 'incrementBy' must be at least 1.\");\n}"
        }
      ],
      "version": "1.0.0"
    },
    {
      "field_validations": [],
      "methods": [],
