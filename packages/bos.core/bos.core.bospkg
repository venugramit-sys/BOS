            ],
            [
              "reason",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nif (!u) throw new Error(\"Username is required.\");\nconst targetUser = String(u).trim();\n\nUser.update(targetUser, {\n    status: \"LockedOut\",\n    lockoutUntil: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString()\n});\n\nctx.call(\"AuthManager\", \"TerminateAllSessions\", { username: targetUser });\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"AccountLocked\",\n    details: reason ? String(reason) : \"Account manually locked by administrator.\",\n    isSuccess: true\n});\n\nreturn { success: true, username: targetUser, status: \"LockedOut\" };",
          "trigger_event": null
        },
        {
          "actions": [],
