      "name": "User",
      "object_type": "table",
      "on_delete": null,
      "package_name": "bos.core",
      "primary_key": [
        "username"
      ],
      "sql_table_name": "user",
      "table_type": "Normal",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.username || String(rec.username).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'username' is required.\");\n}\nrec.username = String(rec.username).trim();\n\nif (rec.username.length < 3 || rec.username.length > 50) {\n    throw new Error(\"Validation Failed: 'username' length must be between 3 and 50 characters.\");\n}\n\nif (!/^[a-zA-Z0-9_\\-\\.@]+$/.test(rec.username)) {\n    throw new Error(\"Validation Failed: 'username' can only contain alphanumeric characters, dots, underscores, dashes, and at-signs.\");\n}\n\nif (!rec.email || String(rec.email).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'email' is required.\");\n}\nrec.email = String(rec.email).toLowerCase().trim();\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(rec.email)) {\n    throw new Error(\"Validation Failed: Field 'email' must be a valid email format.\");\n}\n\nif (rec.password) {\n    const rawPassword = String(rec.password);\n    if (rawPassword.length < 6) {\n        throw new Error(\"Validation Failed: Password must be at least 6 characters.\");\n    }\n    rec.passwordHash = (rawPassword.startsWith(\"$2\") || rawPassword.startsWith(\"$argon2\"))\n        ? rawPassword\n        : ctx.crypto.bcryptHash(rawPassword);\n    delete rec.password;\n} else if (rec.passwordHash && (!String(rec.passwordHash).startsWith(\"$2\") && !String(rec.passwordHash).startsWith(\"$argon2\"))) {\n    rec.passwordHash = ctx.crypto.bcryptHash(rec.passwordHash);\n}\n\nif (!rec.passwordHash) {\n    throw new Error(\"Validation Failed: Field 'passwordHash' or 'password' is required.\");\n}\n\nif (rec.failedAttempts === undefined || rec.failedAttempts === null) {\n    rec.failedAttempts = 0;\n}\n\nif (rec.isActive === undefined || rec.isActive === null) {\n    rec.isActive = true;\n}\n\nif (!rec.status) {\n    rec.status = \"Active\";\n}\n\nrec.passwordChangedAt = new Date().toISOString();"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (rec.username && xRec.username && rec.username !== xRec.username) {\n    throw new Error(\"Mutation Rejected: Field 'username' is the immutable primary key and cannot be altered.\");\n}\n\nif (rec.email !== undefined) {\n    rec.email = String(rec.email).toLowerCase().trim();\n    if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(rec.email)) {\n        throw new Error(\"Validation Failed: Field 'email' must be a valid email format.\");\n    }\n}\n\nif (rec.password) {\n    const rawPassword = String(rec.password);\n    if (rawPassword.length < 6) {\n        throw new Error(\"Validation Failed: Password must be at least 6 characters.\");\n    }\n    rec.passwordHash = (rawPassword.startsWith(\"$2\") || rawPassword.startsWith(\"$argon2\"))\n        ? rawPassword\n        : ctx.crypto.bcryptHash(rawPassword);\n    rec.passwordChangedAt = new Date().toISOString();\n    delete rec.password;\n} else if (rec.passwordHash && rec.passwordHash !== xRec.passwordHash && (!String(rec.passwordHash).startsWith(\"$2\") && !String(rec.passwordHash).startsWith(\"$argon2\"))) {\n    rec.passwordHash = ctx.crypto.bcryptHash(rec.passwordHash);\n    rec.passwordChangedAt = new Date().toISOString();\n}"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.username === \"admin\") {\n    throw new Error(\"Deletion Rejected: The built-in root administrator account 'admin' cannot be deleted.\");\n}"
        }
      ],
      "version": "1.0.0"
    },
