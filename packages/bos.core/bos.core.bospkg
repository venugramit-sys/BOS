    {
      "actions": [
        {
          "caption": "Sign In with Azure AD / Okta (SAML 2.0)",
          "confirm": null,
          "enable_when": null,
          "icon": "Building2",
          "in_footer_bar": true,
          "name": "SignInWithSso",
          "open_page": null,
          "primary": true,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nconst u = vars.username || (rec && rec.username) || \"admin@system.local\";\nctx.ui.notify(\"info\", \"Redirecting to corporate Identity Provider (Azure AD / Okta)...\");\nreturn ctx.call(\"AuthManager\", \"AuthenticateGoogle\", {\n    idToken: \"sso_federated_token\",\n    email: u,\n    fullName: \"Corporate Executive\",\n    ipAddress: \"127.0.0.1\"\n});",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Forgot Password?",
          "confirm": null,
          "enable_when": null,
          "icon": "KeyRound",
          "in_footer_bar": true,
          "name": "ForgotPassword",
          "open_page": null,
          "primary": false,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nconst u = vars.username || (rec && rec.username);\nif (!u) {\n    ctx.ui.notify(\"warning\", \"Please provide your corporate User ID or email first.\");\n    return { requested: false };\n}\nconst res = ctx.call(\"AuthManager\", \"RequestPasswordReset\", { username: u });\nctx.ui.notify(\"success\", (res && res.message) ? res.message : \"Password reset instructions dispatched.\");\nreturn { requested: true };",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Sign In",
          "confirm": null,
          "enable_when": null,
          "icon": "LogIn",
          "in_footer_bar": true,
          "name": "SignIn",
          "open_page": null,
          "primary": true,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nconst u = vars.username || (rec && rec.username);\nconst p = vars.password || (rec && rec.password);\nif (!u) throw new Error(\"Please enter your Corporate Email or User ID.\");\nif (!p) throw new Error(\"Please enter your password.\");\nconst res = ctx.call(\"AuthManager\", \"Authenticate\", { username: u, password: p });\nif (!res || !res.authenticated) {\n    throw new Error((res && res.reason) || \"Invalid enterprise credentials.\");\n}\nctx.ui.notify(\"success\", `Welcome back, ${res.fullName || u}.`);\nreturn res;",
          "selection": null,
          "shortcut": null,
          "show_when": null
        }
      ],
      "caption": "Enterprise Portal Login",
      "controls": [
        {
          "caption": null,
          "children": [
            {
              "caption": "Enterprise Trust & Security",
              "children": [],
              "kind": "group",
              "name": "CorporateHero",
              "properties": {
                "instructionalText": "SOC2 Type II Certified • ISO/IEC 27001:2022 • India DPDP Act 2023 Compliant • 99.99% Uptime SLA"
              },
              "source_expr": null
            },
            {
              "caption": "Sign In With Credentials",
              "children": [
                {
                  "caption": null,
                  "children": [],
                  "kind": "field",
                  "name": "username",
                  "properties": {
                    "required": "true"
                  },
                  "source_expr": "username"
                },
                {
                  "caption": null,
                  "children": [],
                  "kind": "field",
                  "name": "password",
                  "properties": {
                    "required": "true"
                  },
                  "source_expr": "password"
                },
                {
                  "caption": "Remember this device for 30 days",
                  "children": [],
                  "kind": "field",
                  "name": "rememberMe",
                  "properties": {},
                  "source_expr": "rememberMe"
                }
              ],
              "kind": "group",
              "name": "Credentials",
              "properties": {},
              "source_expr": null
            }
          ],
          "kind": "area",
          "name": "Content",
          "properties": {},
          "source_expr": null
        }
      ],
      "delete_allowed": false,
      "editable": false,
      "filters": [],
      "insert_allowed": false,
      "instructional_text": "Sign in to access your enterprise workspace, analytical ledgers, and operations.",
      "ir_version": 2,
      "modify_allowed": false,
      "name": "SplitHeroLogin",
      "object_type": "page",
      "package_name": "bos.core",
      "page_type": "NavigatePage",
      "source_kind": "table",
      "source_table": null,
      "triggers": [],
      "variables": [
        {
          "caption": "Corporate Email or User ID",
          "data_type": "String(50)",
          "name": "username"
        },
        {
          "caption": "Master Password",
          "data_type": "String(128)",
          "name": "password"
        },
        {
          "data_type": "Boolean",
          "default_value": "true",
          "name": "rememberMe"
        },
        {
          "data_type": "String(50)",
          "default_value": "AzureAD",
          "name": "ssoProvider"
        }
      ],
      "version": "1.0.0",
      "views": []
    },
    {
      "actions": [
        {
          "caption": "Send Magic Code",
          "confirm": null,
          "enable_when": null,
          "icon": "Sparkles",
          "in_footer_bar": true,
          "name": "SendMagicCode",
          "open_page": null,
          "primary": false,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nconst em = vars.email || (rec && rec.email);\nif (!em) throw new Error(\"Please enter your email address to receive a magic code.\");\nconst res = ctx.call(\"AuthManager\", \"RequestMagicLink\", { email: em });\nctx.ui.notify(\"info\", `Verification code dispatched to '${em}'.`);\nreturn res;",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Verify & Sign In",
          "confirm": null,
          "enable_when": null,
          "icon": "ShieldCheck",
          "in_footer_bar": true,
          "name": "VerifyMagicCode",
          "open_page": null,
          "primary": false,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nconst em = vars.email || (rec && rec.email);\nconst code = vars.otpCode || (rec && rec.otpCode);\nif (!em || !code) throw new Error(\"Please specify both your email and the 6-digit code.\");\nconst res = ctx.call(\"AuthManager\", \"VerifyMagicLink\", { email: em, code: code });\nctx.ui.notify(\"success\", \"Passwordless verification successful.\");\nreturn res;",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Sign In",
          "confirm": null,
          "enable_when": null,
          "icon": "LogIn",
          "in_footer_bar": true,
          "name": "SignIn",
          "open_page": null,
          "primary": true,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nconst u = vars.username || (rec && rec.username);\nconst p = vars.password || (rec && rec.password);\nif (!u || !p) throw new Error(\"Username and password are required.\");\nconst res = ctx.call(\"AuthManager\", \"Authenticate\", { username: u, password: p });\nif (!res || !res.authenticated) throw new Error(\"Invalid username or password.\");\nreturn res;",
          "selection": null,
          "shortcut": null,
          "show_when": null
        }
      ],
      "caption": "Welcome to BOS",
      "controls": [
        {
          "caption": null,
