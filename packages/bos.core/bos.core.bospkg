          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nif (!u) throw new Error(\"Username is required.\");\nconst targetUser = String(u).trim();\n\nUser.update(targetUser, {\n    status: \"Active\",\n    failedAttempts: 0,\n    lockoutUntil: null\n});\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"AccountUnlocked\",\n    details: \"Account manually unlocked by administrator.\",\n    isSuccess: true\n});\n\nreturn { success: true, username: targetUser, status: \"Active\" };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "SeedSuperAdmin",
          "params": [],
          "return_type": null,
          "script": "if (!Role.get(\"SUPER\")) {\n    Role.insert({\n        code: \"SUPER\",\n        name: \"Super Administrator\",\n        description: \"Full unrestricted platform access\",\n        isSystemRole: true,\n        isActive: true\n    });\n}\nif (!Role.get(\"ADMIN\")) {\n    Role.insert({\n        code: \"ADMIN\",\n        name: \"System Administrator\",\n        description: \"Administrative system management\",\n        isSystemRole: true,\n        isActive: true\n    });\n}\n\nif (!User.get(\"admin\")) {\n    User.insert({\n        username: \"admin\",\n        passwordHash: ctx.crypto.bcryptHash(\"Boss@123\"),\n        email: \"admin@system.local\",\n        fullName: \"System Super Administrator\",\n        userType: \"Internal\",\n        status: \"Active\",\n        isActive: true,\n        failedAttempts: 0\n    });\n}\n\nif (!UserRole.get(\"admin|SUPER\")) {\n    UserRole.insert({ username: \"admin\", roleCode: \"SUPER\", assignedBy: \"SYSTEM\" });\n}\nif (!UserRole.get(\"admin|ADMIN\")) {\n    UserRole.insert({ username: \"admin\", roleCode: \"ADMIN\", assignedBy: \"SYSTEM\" });\n}\n\nif (!UserSecuritySetting.get(\"admin\")) {\n    UserSecuritySetting.insert({\n        username: \"admin\",\n        mfaMethod: \"None\",\n        mfaEnabled: false,\n        maxConcurrentSessions: 10,\n        mustChangePassword: false,\n        passwordExpiryDays: 90\n    });\n}\n\nctx.call(\"AuthManager\", \"InitializeAuthSetup\");",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "DiscoverTenantDomain",
          "params": [
            [
              "domain",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const d = (rec && rec.domain !== undefined) ? rec.domain : domain;\nif (!d || String(d).trim().length === 0) {\n    throw new Error(\"Domain discovery error: Workspace domain or company slug is required.\");\n}\nconst cleanSlug = String(d).toLowerCase().trim().replace(\".bos.app\", \"\");\nconst cfg = ctx.call(\"AuthManager\", \"GetLoginConfiguration\");\n\nreturn {\n    found: true,\n    workspaceSlug: cleanSlug,\n    tenantName: (cfg && cfg.applicationTitle) ? cfg.applicationTitle : `${cleanSlug.toUpperCase()} Enterprise`,\n    companyLogoUrl: (cfg && cfg.companyLogoUrl) ? cfg.companyLogoUrl : \"\",\n    primaryColor: (cfg && cfg.primaryColor) ? cfg.primaryColor : \"#0284c7\",\n    ssoEnabled: (cfg && cfg.ssoEnabled !== undefined) ? cfg.ssoEnabled : true,\n    ssoProviderName: (cfg && cfg.ssoProviderName) ? cfg.ssoProviderName : \"Azure Active Directory / Okta\",\n    allowedAuthMethods: [\"password\", \"sso\", \"passkey\"]\n};",
          "trigger_event": null
        },
        {
          "actions": [],
