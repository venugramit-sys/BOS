          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: Country 'code' is required.\");\n}\nrec.code = String(rec.code).toUpperCase().trim();\nif (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Country 'name' is required.\");\n}"
