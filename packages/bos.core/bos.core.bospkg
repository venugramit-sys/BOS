    {
      "actions": [
        {
          "caption": "Find Workspace",
          "confirm": null,
          "enable_when": null,
          "icon": "Search",
          "in_footer_bar": true,
          "name": "FindWorkspace",
          "open_page": null,
          "primary": true,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nconst d = vars.workspaceDomain || (rec && rec.workspaceDomain);\nif (!d) throw new Error(\"Please specify your company workspace domain.\");\nconst res = ctx.call(\"AuthManager\", \"DiscoverTenantDomain\", { domain: d });\nif (ctx.page && ctx.page.variables) {\n    ctx.page.variables.discoveredName = res.tenantName;\n    ctx.page.variables.ssoProvider = res.ssoProviderName;\n}\nctx.ui.notify(\"success\", `Workspace found: ${res.tenantName} (${res.ssoProviderName})`);\nreturn res;",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Sign In to Workspace",
          "confirm": null,
          "enable_when": null,
