            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nif (!u) throw new Error(\"Username must not be empty.\");\nconst targetUser = String(u).trim();\nconst userRec = User.get(targetUser);\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"PasswordResetRequested\",\n    details: userRec ? `Password reset requested for '${targetUser}'.` : `Password reset requested for unknown user '${targetUser}'.`,\n    isSuccess: !!userRec\n});\n\nreturn {\n    success: true,\n    username: targetUser,\n    message: `If an account exists for '${targetUser}', password reset instructions have been dispatched.`\n};",
