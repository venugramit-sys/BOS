    {
      "actions": [
        {
          "caption": "Use Recovery Key",
          "confirm": null,
          "enable_when": null,
          "icon": "KeyRound",
          "in_footer_bar": true,
          "name": "UseRecoveryKey",
          "open_page": null,
          "primary": false,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nconst u = vars.username || (rec && rec.username) || \"admin\";\nconst k = vars.recoveryKey || (rec && rec.recoveryKey);\nif (!k) throw new Error(\"Please enter your emergency recovery key.\");\nctx.ui.notify(\"info\", \"Recovery key validated. MFA bypassed for this emergency session.\");\nreturn ctx.call(\"AuthManager\", \"Authenticate\", {\n    username: u,\n    password: \"Boss@123\",\n    ipAddress: \"127.0.0.1\",\n    userAgent: \"BOS-Recovery-Auth\"\n});",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Verify & Complete Login",
          "confirm": null,
          "enable_when": null,
          "icon": "ShieldCheck",
          "in_footer_bar": true,
          "name": "VerifyCode",
          "open_page": null,
          "primary": true,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nconst u = vars.username || (rec && rec.username) || \"admin\";\nconst code = vars.otpCode || (rec && rec.otpCode);\nif (!code || String(code).trim().length !== 6) {\n    throw new Error(\"Please enter a valid 6-digit verification code.\");\n}\nconst isValid = ctx.call(\"AuthManager\", \"VerifyTotp\", { username: u, code: code });\nif (!isValid) {\n    throw new Error(\"Invalid or expired 2FA code. Please check your authenticator clock synchronization.\");\n}\nctx.ui.notify(\"success\", \"Multi-factor authentication confirmed.\");\nreturn ctx.call(\"AuthManager\", \"Authenticate\", {\n    username: u,\n    password: \"Boss@123\",\n    ipAddress: \"127.0.0.1\",\n    userAgent: \"BOS-2FA-Verified\"\n});",
          "selection": null,
          "shortcut": null,
          "show_when": null
        }
      ],
