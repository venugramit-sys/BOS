      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.primaryKeyCode || String(rec.primaryKeyCode).trim().length === 0) {\n    rec.primaryKeyCode = \"PRIMARY\";\n}\nif (!rec.applicationTitle || String(rec.applicationTitle).trim().length === 0) {\n    rec.applicationTitle = \"BOS Business Operating System\";\n}\nif (rec.allowPostingFrom && rec.allowPostingTo) {\n    if (new Date(rec.allowPostingFrom) > new Date(rec.allowPostingTo)) {\n        throw new Error(\"Validation Failed: 'allowPostingFrom' date cannot be after 'allowPostingTo' date.\");\n    }\n}"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (!rec.applicationTitle || String(rec.applicationTitle).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'applicationTitle' cannot be blank.\");\n}\nif (rec.allowPostingFrom && rec.allowPostingTo) {\n    if (new Date(rec.allowPostingFrom) > new Date(rec.allowPostingTo)) {\n        throw new Error(\"Validation Failed: 'allowPostingFrom' date cannot be after 'allowPostingTo' date.\");\n    }\n}"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.primaryKeyCode === \"PRIMARY\") {\n    throw new Error(\"Validation Failed: The 'PRIMARY' CoreSetup configuration row cannot be deleted.\");\n}"
        }
      ],
      "version": "1.0.0"
    },
