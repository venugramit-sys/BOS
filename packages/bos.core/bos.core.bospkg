          ],
          "return_type": null,
          "script": "const sc = (rec && rec.seriesCode !== undefined) ? rec.seriesCode : seriesCode;\nconst td = (rec && rec.targetDate !== undefined) ? rec.targetDate : (targetDate || new Date().toISOString().slice(0, 10));\nconst shouldUpdate = (rec && rec.updateSeries !== undefined) ? rec.updateSeries : (updateSeries !== false);\n\nif (!sc || String(sc).trim().length === 0) {\n    throw new Error(\"Number Series Error: 'seriesCode' must be specified.\");\n}\nconst cleanCode = String(sc).toUpperCase().trim();\n\nconst header = NoSeries.get(cleanCode);\nif (!header) {\n    throw new Error(`Number Series Error: Series '${cleanCode}' does not exist.`);\n}\nif (!header.isActive) {\n    throw new Error(`Number Series Error: Series '${cleanCode}' is currently deactivated.`);\n}\n\n// Find candidate lines ordered by startingDate desc\nconst lines = NoSeriesLine.findMany({\n    where: { seriesCode: cleanCode, isOpen: true },\n    orderBy: { startingDate: \"desc\" }\n});\n\nif (!lines || lines.length === 0) {\n    throw new Error(`Number Series Error: No active lines found for series '${cleanCode}'.`);\n}\n\n// Pick the line matching the date criteria\nlet activeLine = null;\nfor (let i = 0; i < lines.length; i++) {\n    const lineDate = lines[i].startingDate;\n    if (!lineDate || lineDate <= td) {\n        activeLine = lines[i];\n        break;\n    }\n}\nif (!activeLine) {\n    activeLine = lines[lines.length - 1]; // fallback to oldest starting line\n}\n\n// ACQUIRE PESSIMISTIC ROW LOCK (SELECT ... FOR UPDATE) via generic Table.lock\nconst lockedLine = NoSeriesLine.lock(activeLine.id);\nif (!lockedLine) {\n    throw new Error(`Number Series Error: Failed to acquire concurrency lock on series line '${activeLine.id}'.`);\n}\n\n// Enforce strict chronological date order if required\nif (header.dateOrder && lockedLine.lastDateUsed && td < lockedLine.lastDateUsed) {\n    throw new Error(`Number Series Error: Document date (${td}) cannot be earlier than last date used (${lockedLine.lastDateUsed}) for series '${cleanCode}'.`);\n}\n\nlet nextNo = \"\";\nif (!lockedLine.lastNoUsed || String(lockedLine.lastNoUsed).trim().length === 0) {\n    nextNo = lockedLine.startingNo;\n} else {\n    // Compute next number via prefix/suffix parsing\n    nextNo = ctx.call(\"NoSeriesManagement\", \"IncrementStringNumber\", {\n        currentNumber: lockedLine.lastNoUsed,\n        incrementBy: lockedLine.incrementBy || 1\n    });\n}\n\n// Check boundary limits (numerical suffix comparison to avoid lexicographical string length pitfalls)\nif (lockedLine.endingNo) {\n    const endMatch = String(lockedLine.endingNo).match(/^(.*?)(\\d+)$/);\n    const nextMatch = String(nextNo).match(/^(.*?)(\\d+)$/);\n    if (endMatch && nextMatch && endMatch[1] === nextMatch[1]) {\n        const endVal = parseInt(endMatch[2], 10);\n        const nextVal = parseInt(nextMatch[2], 10);\n        if (nextVal > endVal) {\n            throw new Error(`Number Series Error: Series '${cleanCode}' has exhausted its allocated range. Ending number was '${lockedLine.endingNo}'.`);\n        }\n    } else if (nextNo > lockedLine.endingNo) {\n        throw new Error(`Number Series Error: Series '${cleanCode}' has exhausted its allocated range. Ending number was '${lockedLine.endingNo}'.`);\n    }\n}\n\n// Check warning threshold notification\nif (lockedLine.warningNo && shouldUpdate) {\n    const warnMatch = String(lockedLine.warningNo).match(/^(.*?)(\\d+)$/);\n    const nextMatch = String(nextNo).match(/^(.*?)(\\d+)$/);\n    if (warnMatch && nextMatch && warnMatch[1] === nextMatch[1]) {\n        const warnVal = parseInt(warnMatch[2], 10);\n        const nextVal = parseInt(nextMatch[2], 10);\n        if (nextVal >= warnVal) {\n            ctx.ui.message(`Number series '${cleanCode}' is approaching exhaustion (${nextNo} >= ${lockedLine.warningNo}).`, \"warning\");\n        }\n    }\n}\n\n// Persist update if requested\nif (shouldUpdate) {\n    NoSeriesLine.update(lockedLine.id, {\n        lastNoUsed: nextNo,\n        lastDateUsed: td\n    });\n}\n\nreturn nextNo;",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "IncrementStringNumber",
          "params": [
            [
              "currentNumber",
              "String"
            ],
            [
              "incrementBy",
              "Integer"
            ]
          ],
          "return_type": null,
          "script": "const str = (rec && rec.currentNumber !== undefined) ? rec.currentNumber : currentNumber;\nconst inc = (rec && rec.incrementBy !== undefined) ? Number(rec.incrementBy) : (Number(incrementBy) || 1);\n\nif (!str || typeof str !== \"string\") {\n    throw new Error(\"IncrementStringNumber: Invalid number string.\");\n}\n\n// Match trailing digits: e.g. \"INV-2026-00042\" -> prefix \"INV-2026-\", digits \"00042\"\nconst match = str.match(/^(.*?)(\\d+)$/);\nif (!match) {\n    // No trailing digits: append -1\n    return str + \"-\" + inc;\n}\n\nconst prefix = match[1];\nconst numPart = match[2];\nconst width = numPart.length;\nconst currentVal = parseInt(numPart, 10);\nconst nextVal = currentVal + inc;\n\n// Re-pad with leading zeroes if necessary\nlet formattedDigits = String(nextVal);\nif (formattedDigits.length < width) {\n    formattedDigits = formattedDigits.padStart(width, \"0\");\n}\n\nreturn prefix + formattedDigits;",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "TestManualAllowed",
          "params": [
            [
              "seriesCode",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const sc = (rec && rec.seriesCode !== undefined) ? rec.seriesCode : seriesCode;\nif (!sc) return false;\nconst header = NoSeries.get(String(sc).toUpperCase().trim());\nif (!header) return false;\nif (!header.manualNos) {\n    throw new Error(`Validation Error: Manual numbering is not permitted for series '${header.code}'. You must use automated sequence numbers.`);\n}\nreturn true;",
          "trigger_event": null
        }
      ],
      "name": "NoSeriesManagement",
      "object_type": "codeunit",
      "package_name": "bos.core",
      "version": "1.0.0"
    },
    {
      "bound_table": null,
      "execution_mode": "BytecodeInterpreter",
      "is_exposed": false,
      "is_pushdown": false,
      "is_transactional": true,
      "max_fuel": 100000,
      "methods": [
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "InitializeDefaultDimensions",
          "params": [],
          "return_type": null,
          "script": "if (!DimensionSetup.get(\"PRIMARY\")) {\n    DimensionSetup.insert({\n        primaryKeyCode: \"PRIMARY\",\n        globalDimension1Code: \"DEPARTMENT\",\n        globalDimension2Code: \"PROJECT\",\n        enforceMandatoryDimensionsOnPosting: false\n    });\n}\n\nif (!Dimension.get(\"DEPARTMENT\")) {\n    Dimension.insert({ code: \"DEPARTMENT\", name: \"Department\", description: \"Operational Departments\", isBlocked: false });\n    DimensionValue.insert({ id: ctx.crypto.uuidv7(), dimensionCode: \"DEPARTMENT\", code: \"SALES\", name: \"Sales & Marketing\", valueType: \"Standard\", indentation: 0, isBlocked: false });\n    DimensionValue.insert({ id: ctx.crypto.uuidv7(), dimensionCode: \"DEPARTMENT\", code: \"ENG\", name: \"Engineering & IT\", valueType: \"Standard\", indentation: 0, isBlocked: false });\n    DimensionValue.insert({ id: ctx.crypto.uuidv7(), dimensionCode: \"DEPARTMENT\", code: \"OPS\", name: \"Operations & Logistics\", valueType: \"Standard\", indentation: 0, isBlocked: false });\n    DimensionValue.insert({ id: ctx.crypto.uuidv7(), dimensionCode: \"DEPARTMENT\", code: \"FIN\", name: \"Finance & Accounting\", valueType: \"Standard\", indentation: 0, isBlocked: false });\n}\n\nif (!Dimension.get(\"PROJECT\")) {\n    Dimension.insert({ code: \"PROJECT\", name: \"Project\", description: \"Strategic Capital Projects\", isBlocked: false });\n    DimensionValue.insert({ id: ctx.crypto.uuidv7(), dimensionCode: \"PROJECT\", code: \"PRJ-001\", name: \"Enterprise ERP Overhaul\", valueType: \"Standard\", indentation: 0, isBlocked: false });\n    DimensionValue.insert({ id: ctx.crypto.uuidv7(), dimensionCode: \"PROJECT\", code: \"PRJ-002\", name: \"Cloud Migration\", valueType: \"Standard\", indentation: 0, isBlocked: false });\n}\n\nreturn { success: true, message: \"Standard analytical dimensions initialized.\" };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "GetOrCreateDimensionSetId",
          "params": [
            [
              "dimensionPairs",
              "any"
            ]
          ],
          "return_type": "any",
          "script": "const pairs = (rec && rec.dimensionPairs !== undefined) ? rec.dimensionPairs : dimensionPairs;\nif (!pairs || !Array.isArray(pairs) || pairs.length === 0) {\n    return null;\n}\n\n// Filter, deduplicate, and sort pairs by dimensionCode ascending for canonical hashing\nconst pairMap = {};\nfor (let i = 0; i < pairs.length; i++) {\n    const p = pairs[i];\n    if (p && p.dimensionCode && p.dimensionValueCode) {\n        const code = String(p.dimensionCode).toUpperCase().trim();\n        const val = String(p.dimensionValueCode).toUpperCase().trim();\n        if (code.length > 0 && val.length > 0) {\n            pairMap[code] = val;\n        }\n    }\n}\nconst cleanPairs = [];\nconst sortedCodes = Object.keys(pairMap).sort();\nfor (let i = 0; i < sortedCodes.length; i++) {\n    const dCode = sortedCodes[i];\n    const vCode = pairMap[dCode];\n    try {\n        const dim = Dimension.get(dCode);\n        if (dim && dim.isBlocked) {\n            throw new Error(`Dimension Error: Dimension '${dCode}' is blocked for posting.`);\n        }\n    } catch (e) {\n        if (e.message && e.message.includes(\"blocked\")) throw e;\n    }\n    cleanPairs.push({ code: dCode, val: vCode });\n}\nif (cleanPairs.length === 0) return null;\n\n// Compute canonical hash string\nlet hashSource = \"\";\nlet readableSummary = \"\";\nfor (let i = 0; i < cleanPairs.length; i++) {\n    if (i > 0) {\n        hashSource += \";\";\n        readableSummary += \" / \";\n    }\n    hashSource += cleanPairs[i].code + \"=\" + cleanPairs[i].val;\n    readableSummary += cleanPairs[i].code + \": \" + cleanPairs[i].val;\n}\n\nconst setHash = ctx.crypto.sha256(hashSource);\n\n// Check if dimension set already exists\nconst existing = DimensionSet.findMany({ where: { setHash: setHash }, take: 1 });\nif (existing && existing.length > 0) {\n    return existing[0].id;\n}\n\n// Create new DimensionSet with atomic UUIDv7\nconst newSetId = ctx.crypto.uuidv7();\nDimensionSet.insert({\n    id: newSetId,\n    setHash: setHash,\n    description: readableSummary,\n    entryCount: cleanPairs.length\n});\n\nfor (let i = 0; i < cleanPairs.length; i++) {\n    DimensionSetEntry.insert({\n        id: ctx.crypto.uuidv7(),\n        dimensionSetId: newSetId,\n        dimensionCode: cleanPairs[i].code,\n        dimensionValueCode: cleanPairs[i].val\n    });\n}\n\nreturn newSetId;",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "GetDimensionSetEntries",
          "params": [
            [
              "dimensionSetId",
              "any"
            ]
          ],
          "return_type": "any",
          "script": "const sid = (rec && rec.dimensionSetId !== undefined) ? rec.dimensionSetId : dimensionSetId;\nif (!sid) return [];\nreturn DimensionSetEntry.findMany({ where: { dimensionSetId: sid } });",
          "trigger_event": null
        }
      ],
      "name": "DimensionManagement",
      "object_type": "codeunit",
      "package_name": "bos.core",
      "version": "1.0.0"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "CoreSetupLogic",
