              "String"
            ],
            [
              "secret",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nconst m = (rec && rec.method !== undefined) ? rec.method : (method || \"TOTP\");\nconst s = (rec && rec.secret !== undefined) ? rec.secret : secret;\n\nif (!u || !s) throw new Error(\"Username and secret are required to enroll MFA.\");\nconst cleanUser = String(u).trim();\n\nlet sec = UserSecuritySetting.get(cleanUser);\nif (!sec) {\n    UserSecuritySetting.insert({\n        username: cleanUser,\n        mfaMethod: m,\n        mfaSecret: s,\n        mfaEnabled: true,\n        maxConcurrentSessions: 5\n    });\n} else {\n    UserSecuritySetting.update(cleanUser, {\n        mfaMethod: m,\n        mfaSecret: s,\n        mfaEnabled: true\n    });\n}\n\nSecurityAuditLog.insert({\n    username: cleanUser,\n    action: \"MfaEnrolled\",\n    details: `MFA enrolled using method '${m}'.`,\n    isSuccess: true\n});\n\nreturn { success: true, username: cleanUser, method: m };",
          "trigger_event": null
        },
