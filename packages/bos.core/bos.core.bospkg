      "name": "Tenant",
      "object_type": "table",
      "on_delete": null,
      "package_name": "bos.core",
      "primary_key": [
        "code"
      ],
      "sql_table_name": "tenant",
      "table_type": "Normal",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: Tenant 'code' is required.\");\n}\nrec.code = String(rec.code).toLowerCase().trim();\nif (!/^[a-z0-9][a-z0-9._-]{1,49}$/.test(rec.code)) {\n    throw new Error(\"Validation Failed: Tenant code must be alphanumeric with dots, hyphens or underscores.\");\n}\nif (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Tenant 'name' is required.\");\n}\nif (rec.maxUsers !== undefined && rec.maxUsers < 1) {\n    throw new Error(\"Validation Failed: 'maxUsers' must be at least 1.\");\n}"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Tenant 'name' cannot be blank.\");\n}"
        }
      ],
      "version": "1.0.0"
    },
