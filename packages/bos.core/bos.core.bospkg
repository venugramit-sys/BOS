          "return_type": null,
          "script": "let setup = null;\ntry {\n    setup = AuthSetup.get(\"PRIMARY\");\n} catch (e) {}\nif (!setup) {\n    return {\n        primaryKeyCode: \"PRIMARY\",\n        minPasswordLength: 8,\n        requireUppercase: true,\n        requireLowercase: true,\n        requireDigit: true,\n        requireSpecialChar: true,\n        passwordExpiryDays: 90,\n        preventPasswordReuseCount: 3,\n        forcePasswordChangeOnFirstLogin: false,\n        maxFailedAttempts: 5,\n        lockoutDurationMinutes: 30,\n        resetFailedAttemptsAfterMinutes: 15,\n        autoUnlockAfterLockout: true,\n        sessionTimeoutMinutes: 60,\n        maxConcurrentSessions: 5,\n        enforceIpBinding: false,\n        mfaPolicy: \"Optional\",\n        mfaGracePeriodDays: 7,\n        totpIssuerName: \"BOS Enterprise\",\n        allowGoogleLogin: true,\n        allowPasswordReset: true,\n        resetTokenExpiryMinutes: 60,\n        allowSelfRegistration: false,\n        allowDeveloperOverride: true,\n        developerOverrideKey: \"vits-super-dev-override-2026\"\n    };\n}\nreturn setup;",
