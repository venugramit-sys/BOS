page CoreSetupCard for CoreSetup {
    pageType = Card;
    caption = "Core Platform and Environment Setup";

    layout {
        area(Content) {
            group(BrandingFastTab) {
                caption = "Application Identity and Branding";
                field(applicationTitle) {
                    caption = "Application Title";
                }
                field(applicationSubtitle) {
                    caption = "Application Subtitle";
                }
                field(applicationLogoUrl) {
                    caption = "Application Logo URL";
                }
                field(faviconUrl) {
                    caption = "Favicon URL";
                }
                field(supportContactEmail) {
                    caption = "Support Contact Email";
                }
            }

            group(ThemeFastTab) {
                caption = "Color Theme and Appearance";
                field(colorTheme) {
                    caption = "Application Color Theme";
                }
                field(themeMode) {
                    caption = "Theme Mode (Light / Dark / Auto)";
                }
                field(enableCompactDensity) {
                    caption = "Compact Density Mode";
                }
            }

            group(RegionalFastTab) {
                caption = "Regional Localization and Currency";
                field(defaultLocale) {
                    caption = "Default Locale";
                }
                field(defaultTimezone) {
                    caption = "Default Timezone";
                }
                field(dateFormat) {
                    caption = "System Date Format";
                }
                field(timeFormat) {
                    caption = "System Time Format";
                }
                field(numberFormat) {
                    caption = "Number Separator Format";
                }
                field(baseCurrencyCode) {
                    caption = "Base Currency Code";
                }
                field(currencySymbol) {
                    caption = "Currency Symbol";
                }
                field(currencyPosition) {
                    caption = "Currency Symbol Position";
                }
            }

            group(PostingFastTab) {
                caption = "Posting Date Control and Compliance";
                field(allowPostingFrom) {
                    caption = "Allow Posting From Date";
                }
                field(allowPostingTo) {
                    caption = "Allow Posting To Date";
                }
                field(enableAuditChaining) {
                    caption = "Cryptographic Audit Hash Chaining";
                }
            }

            group(MaintenanceFastTab) {
                caption = "System Maintenance Window";
                field(isMaintenanceMode) {
                    caption = "Maintenance Mode Active";
                }
                field(maintenanceMessage) {
                    caption = "Maintenance Banner Message";
                }
            }
        }
    }

    actions {
        area(Processing) {
            action(ResetToRecommended) {
                caption = "Initialize Core Defaults";
                icon = "Settings";
                primary = true;
                onAction(rec, ctx) {
                    const res = ctx.call("CoreManager", "InitializeCoreSetup", {});
                    ctx.ui.message("Core setup initialized to standard enterprise defaults.");
                }
            }
        }
    }
}

