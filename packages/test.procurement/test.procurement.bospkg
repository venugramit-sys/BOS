          ],
          "return_type": "any",
          "script": "const orderId = ctx.call(\"NoSeriesManagement\", \"GetNextNo\", {\n    seriesCode: \"PO\",\n    targetDate: new Date().toISOString().slice(0, 10),\n    updateSeries: true\n});\nconst order = models.PurchaseOrderHeader.insert({\n    orderNo: orderId,\n    vendorNo: vendorNo,\n    orderDate: new Date().toISOString(),\n    status: \"Draft\",\n    currency: \"USD\",\n    totalAmount: amount,\n    notes: \"Automated procurement order\"\n});\nreturn order;",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "ApprovePurchaseOrder",
          "params": [
            [
              "orderNo",
              "string"
            ]
          ],
          "return_type": "any",
          "script": "const order = models.PurchaseOrderHeader.getById(orderNo);\nif (!order) {\n    throw new Error(\"Purchase order not found: \" + orderNo);\n}\norder.status = \"Approved\";\nreturn models.PurchaseOrderHeader.updateOptimistic(order);",
          "trigger_event": null
        }
      ],
      "name": "ProcurementManagement",
      "object_type": "codeunit",
      "package_name": "test.procurement",
      "version": "1.0.0"
    },
    {
      "bound_table": null,
      "execution_mode": "BytecodeInterpreter",
      "is_exposed": false,
      "is_pushdown": false,
      "is_transactional": true,
      "max_fuel": 100000,
      "methods": [
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "Run",
          "params": [
            [
              "orderNo",
              "String"
            ],
            [
              "postingDate",
              "String"
            ]
          ],
          "return_type": "any",
          "script": "const oNo = (rec && rec.orderNo !== undefined) ? rec.orderNo : orderNo;\nconst pDate = (rec && rec.postingDate !== undefined) ? rec.postingDate : (postingDate || new Date().toISOString().slice(0, 10));\n\nif (!oNo) throw new Error(\"Posting Error: 'orderNo' must be specified.\");\n\n// Phase 1: Check & Concurrency Lock\nconst header = PurchaseOrderHeader.lock(oNo);\nif (!header) {\n    throw new Error(\"Posting Error: Purchase order '\" + oNo + \"' not found.\");\n}\nif (header.status !== \"Approved\" && header.status !== \"Ordered\") {\n    throw new Error(\"Posting Error: Order '\" + oNo + \"' must be Approved or Ordered before posting. Status: \" + header.status);\n}\n\nconst vendor = Vendor.get(header.vendorNo);\nif (!vendor) {\n    throw new Error(\"Posting Error: Vendor '\" + header.vendorNo + \"' not found.\");\n}\nif (vendor.isBlocked) {\n    throw new Error(\"Posting Error: Vendor '\" + header.vendorNo + \"' is blocked for transactions.\");\n}\n\nconst lines = PurchaseOrderLine.findMany({ where: { orderNo: oNo } });\nif (!lines || lines.length === 0) {\n    throw new Error(\"Posting Error: Order '\" + oNo + \"' has no order lines.\");\n}\n\n// Validate line integrity and totals BEFORE allocating document sequence numbers\nfor (let i = 0; i < lines.length; i++) {\n    const line = lines[i];\n    if (!line.quantity || Number(line.quantity) <= 0) {\n        throw new Error(\"Posting Error: Line \" + line.lineNo + \" has invalid quantity (\" + line.quantity + \").\");\n    }\n    if (line.unitPrice === undefined || Number(line.unitPrice) < 0) {\n        throw new Error(\"Posting Error: Line \" + line.lineNo + \" has negative unit price.\");\n    }\n}\n\n// Phase 2: Deferred Sequence Allocation (Number Series allocated right before ledger write)\nconst postedInvNo = ctx.call(\"NoSeriesManagement\", \"GetNextNo\", {\n    seriesCode: \"PI_POST\",\n    targetDate: pDate,\n    updateSeries: true\n});\n\nPurchInvHeader.insert({\n    invoiceNo: postedInvNo,\n    orderNo: header.orderNo,\n    vendorNo: header.vendorNo,\n    postingDate: pDate,\n    currency: header.currency || \"USD\",\n    totalAmount: header.totalAmount,\n    notes: header.notes || \"\"\n});\n\nfor (let i = 0; i < lines.length; i++) {\n    const line = lines[i];\n    PurchInvLine.insert({\n        invoiceNo: postedInvNo,\n        lineNo: line.lineNo,\n        itemDescription: line.itemDescription,\n        quantity: line.quantity,\n        unitPrice: line.unitPrice,\n        lineAmount: line.lineAmount\n    });\n}\n\nVendorLedgerEntry.insert({\n    id: ctx.crypto.uuidv7(),\n    vendorNo: header.vendorNo,\n    postingDate: pDate,\n    documentType: \"Invoice\",\n    documentNo: postedInvNo,\n    amount: header.totalAmount,\n    isOpen: true\n});\n\n// Phase 3: Archive & Clean\nPurchaseOrderLine.deleteAll({ orderNo: oNo });\nPurchaseOrderHeader.update(header.orderNo, { status: \"Closed\" });\n\nreturn {\n    success: true,\n    postedInvoiceNo: postedInvNo,\n    orderNo: oNo,\n    message: \"Purchase order '\" + oNo + \"' posted successfully as '\" + postedInvNo + \"'.\"\n};",
          "trigger_event": null
        }
      ],
      "name": "PurchasePost",
      "object_type": "codeunit",
      "package_name": "test.procurement",
      "version": "1.0.0"
    },
