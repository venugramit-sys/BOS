      "methods": [
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "calculatePrice",
          "params": [
            [
              "basePrice",
              "number"
            ],
            [
              "quantity",
              "number"
            ],
            [
              "tier",
              "string"
            ]
          ],
          "return_type": "number",
          "script": "const subtotal = basePrice * quantity;\nif (ctx.decimal(quantity).gt(100)) {\n    return subtotal * 0.90; // 10% volume discount\n}\nreturn subtotal;",
          "trigger_event": null
        }
      ],
