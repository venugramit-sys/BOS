      "having": null,
      "name": "VendorSpendAnalytics",
      "object_type": "query",
      "order_by": [
        [
          "totalSpend",
          false
        ]
      ],
      "package_name": "test.procurement",
      "sql_query": "SELECT \"v\".\"no\" AS \"vendorNo\", \"v\".\"name\" AS \"vendorName\", SUM(\"po\".\"total_amount\") AS \"totalSpend\", COUNT(\"po\".\"order_no\") AS \"orderCount\"\nFROM \"vendor\" AS \"v\"\nLEFT JOIN \"purchase_order_header\" AS \"po\" ON po.vendorNo == v.no\nGROUP BY v.no, v.name\nORDER BY \"totalSpend\" DESC",
      "version": "1.0.0"
    },
