        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "// Cascade delete child lines when a draft order is deleted\nPurchaseOrderLine.deleteAll({ orderNo: rec.orderNo });"
