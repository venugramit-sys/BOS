        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.tier) {\n    rec.tier = \"Standard\";\n}"
        },
        {
          "actions": [],
          "name": "onValidate_name",
          "params": [
            "val"
          ],
          "script": "if (!val || val.trim().length === 0) {\n    throw new Error(\"Vendor name cannot be blank.\");\n}"
        },
        {
          "actions": [],
          "name": "onValidate_risk_score",
          "params": [
            "val"
          ],
          "script": "if (val !== undefined && val !== null && (val < 0 || val > 100)) {\n    throw new Error(\"Risk score must be between 0 and 100.\");\n}"
        }
      ],
      "version": "1.0.0"
    },
