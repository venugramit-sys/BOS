                }
              ],
              "data_items": [],
              "filter": null,
              "join_condition": "po.vendorNo == v.no",
              "join_type": "LEFT JOIN",
              "name": "po",
              "table_name": "purchase_order_header"
            }
          ],
          "filter": null,
          "join_condition": null,
          "join_type": null,
          "name": "v",
          "table_name": "vendor"
        }
      ],
