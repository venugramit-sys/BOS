          "name": "TerminateSessions",
          "open_page": null,
          "primary": false,
          "run_codeunit": null,
          "script": "if (!rec || !rec.username) throw new Error(\"Please select a user.\");\nctx.call(\"AuthManager\", \"TerminateAllSessions\", { username: rec.username });\nctx.ui.toast(\"info\", \"Sessions Cleared\", `All active sessions for ${rec.username} have been terminated.`);",
          "selection": null,
          "shortcut": null,
          "show_when": null
        }
      ],
