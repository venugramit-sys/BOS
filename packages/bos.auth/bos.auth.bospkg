      "flow_fields": [
        {
          "drill_down_page": null,
          "func": "Count",
          "index_columns": [
            "role_code"
          ],
          "name": "assignedUsersCount",
          "sql_subquery": "(SELECT COUNT(*) FROM \"user_role\" WHERE \"user_role\".\"role_code\" = \"role\".\"code\")",
          "target_column": null,
          "target_table": "UserRole"
        }
      ],
      "indexes": [],
      "name": "Role",
      "object_type": "table",
      "on_delete": null,
      "package_name": "bos.auth",
      "primary_key": [
        "code"
      ],
      "sql_table_name": "role",
      "table_type": "Normal",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'code' is required for Role.\");\n}\nrec.code = String(rec.code).toUpperCase().trim();\n\nif (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'name' is required for Role.\");\n}\nrec.name = String(rec.name).trim();\n\nif (rec.isSystemRole === undefined) {\n    rec.isSystemRole = false;\n}\nif (rec.isActive === undefined) {\n    rec.isActive = true;\n}\n\nctx.audit.log(`Security Role created: ${rec.code}`);"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.code === \"SUPER\" || rec.code === \"ADMIN\") {\n    throw new Error(\"Security Violation: Cannot delete protected core system role.\");\n}\nctx.audit.log(`Security Role deleted: ${rec.code}`);"
        }
      ],
      "version": "1.0.0"
    },
