      "name": "UserRole",
      "object_type": "table",
      "on_delete": null,
      "package_name": "bos.auth",
      "primary_key": [
        "username",
        "role_code"
      ],
      "sql_table_name": "user_role",
      "table_type": "Normal",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.username || String(rec.username).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'username' is required for UserRole assignment.\");\n}\nif (!rec.roleCode || String(rec.roleCode).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'roleCode' is required for UserRole assignment.\");\n}\nrec.roleCode = String(rec.roleCode).toUpperCase().trim();\n\nctx.audit.log(`UserRole assigned: ${rec.username} -> ${rec.roleCode}`);"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.username === \"admin\" && (rec.roleCode === \"SUPER\" || rec.roleCode === \"ADMIN\")) {\n    throw new Error(\"Security Violation: Cannot revoke root administrator role from primary admin account.\");\n}\nctx.audit.log(`UserRole revoked: ${rec.username} -/-> ${rec.roleCode}`);"
        }
      ],
      "version": "1.0.0"
    },
