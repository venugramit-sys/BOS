    {
      "actions": [
        {
          "caption": "Lock Account",
          "confirm": null,
          "enable_when": null,
          "icon": "Lock",
          "name": "LockAccount",
          "open_page": null,
          "primary": false,
          "run_codeunit": null,
          "script": "if (!rec || !rec.username) throw new Error(\"Please select a user to lock.\");\nctx.call(\"AuthManager\", \"LockUser\", { username: rec.username, reason: \"Manual Admin Lock\" });\nctx.ui.toast(\"warning\", \"User Locked\", `User account ${rec.username} has been locked.`);",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Unlock Account",
          "confirm": null,
          "enable_when": null,
          "icon": "Unlock",
          "name": "UnlockAccount",
          "open_page": null,
          "primary": false,
          "run_codeunit": null,
          "script": "if (!rec || !rec.username) throw new Error(\"Please select a user to unlock.\");\nctx.call(\"AuthManager\", \"UnlockUser\", { username: rec.username });\nctx.ui.toast(\"success\", \"User Unlocked\", `User account ${rec.username} has been restored to Active.`);",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
