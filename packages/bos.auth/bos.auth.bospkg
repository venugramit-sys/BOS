          ],
          "script": "if (!rec.username || String(rec.username).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'username' is required for UserSecuritySetting.\");\n}\nif (rec.maxConcurrentSessions !== undefined && rec.maxConcurrentSessions < 1) {\n    throw new Error(\"Validation Failed: 'maxConcurrentSessions' must be at least 1.\");\n}\nif (rec.passwordExpiryDays !== undefined && rec.passwordExpiryDays < 1) {\n    throw new Error(\"Validation Failed: 'passwordExpiryDays' must be greater than 0.\");\n}"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.maxConcurrentSessions !== undefined && rec.maxConcurrentSessions < 1) {\n    throw new Error(\"Validation Failed: 'maxConcurrentSessions' must be at least 1.\");\n}\nif (rec.passwordExpiryDays !== undefined && rec.passwordExpiryDays < 1) {\n    throw new Error(\"Validation Failed: 'passwordExpiryDays' must be greater than 0.\");\n}"
        }
      ],
      "version": "1.0.0"
    },
