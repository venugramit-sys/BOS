        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "RegisterUser",
          "params": [
            [
              "username",
              "String"
            ],
            [
              "email",
              "String"
            ],
            [
              "password",
              "String"
            ],
            [
              "fullName",
              "String"
            ],
            [
              "userType",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nconst e = (rec && rec.email !== undefined) ? rec.email : email;\nconst p = (rec && rec.password !== undefined) ? rec.password : password;\nconst fn = (rec && rec.fullName !== undefined) ? rec.fullName : fullName;\nconst ut = (rec && rec.userType !== undefined) ? rec.userType : (userType || \"Internal\");\n\nif (!u || String(u).trim().length === 0) {\n    throw new Error(\"Username must not be empty.\");\n}\nif (!e || String(e).trim().length === 0) {\n    throw new Error(\"Email must not be empty.\");\n}\nif (!p || String(p).length < 8) {\n    throw new Error(\"Password must be at least 8 characters long.\");\n}\n\nconst normalizedUser = String(u).trim();\nconst normalizedEmail = String(e).toLowerCase().trim();\n\nif (User.exists({ username: normalizedUser })) {\n    throw new Error(`Registration Conflict: Username '${normalizedUser}' is already registered.`);\n}\nif (User.exists({ email: normalizedEmail })) {\n    throw new Error(`Registration Conflict: Email '${normalizedEmail}' is already registered.`);\n}\n\nconst newUser = User.insert({\n    username: normalizedUser,\n    email: normalizedEmail,\n    password: p,\n    fullName: fn ? String(fn).trim() : \"\",\n    userType: ut,\n    status: \"Active\",\n    isActive: true,\n    failedAttempts: 0\n});\n\n// Initialize default security settings\nUserSecuritySetting.insert({\n    username: normalizedUser,\n    mfaMethod: \"None\",\n    mfaEnabled: false,\n    maxConcurrentSessions: 5,\n    mustChangePassword: false,\n    passwordExpiryDays: 90\n});\n\nSecurityAuditLog.insert({\n    username: normalizedUser,\n    action: \"LoginSuccess\",\n    details: `User account '${normalizedUser}' registered successfully.`,\n    isSuccess: true\n});\n\nreturn {\n    success: true,\n    username: normalizedUser,\n    email: normalizedEmail,\n    userType: ut\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "Authenticate",
          "params": [
            [
              "username",
              "String"
            ],
            [
              "password",
              "String"
            ],
            [
              "ipAddress",
              "String"
            ],
            [
              "userAgent",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nconst p = (rec && rec.password !== undefined) ? rec.password : password;\nconst ip = (rec && rec.ipAddress !== undefined) ? rec.ipAddress : (ipAddress || \"127.0.0.1\");\nconst ua = (rec && rec.userAgent !== undefined) ? rec.userAgent : (userAgent || \"BOS-Client\");\n\nif (!u || !p) {\n    throw new Error(\"Missing Credentials: username and password are required.\");\n}\n\nconst targetUser = String(u).trim();\nconst userRec = User.get(targetUser);\n\nif (!userRec) {\n    SecurityAuditLog.insert({\n        username: targetUser,\n        action: \"LoginFailed\",\n        ipAddress: String(ip),\n        userAgent: String(ua),\n        details: \"Authentication failed: Account not found.\",\n        isSuccess: false\n    });\n    return {\n        authenticated: false,\n        reason: \"INVALID_CREDENTIALS\"\n    };\n}\n\n// Account Status and Lockout Invariants\nif (userRec.status === \"LockedOut\" || (userRec.lockoutUntil && new Date(userRec.lockoutUntil) > new Date())) {\n    SecurityAuditLog.insert({\n        username: targetUser,\n        action: \"LoginFailed\",\n        ipAddress: String(ip),\n        userAgent: String(ua),\n        details: \"Authentication rejected: Account is currently locked out.\",\n        isSuccess: false\n    });\n    return {\n        authenticated: false,\n        reason: \"ACCOUNT_LOCKED\",\n        lockoutUntil: userRec.lockoutUntil\n    };\n}\n\nif (userRec.status !== \"Active\" || userRec.isActive === false) {\n    SecurityAuditLog.insert({\n        username: targetUser,\n        action: \"LoginFailed\",\n        ipAddress: String(ip),\n        userAgent: String(ua),\n        details: `Authentication rejected: Account status is ${userRec.status}.`,\n        isSuccess: false\n    });\n    return {\n        authenticated: false,\n        reason: \"ACCOUNT_INACTIVE\"\n    };\n}\n\n// Password Verification via Argon2\nconst passwordMatches = ctx.crypto.argon2Verify(String(p), userRec.passwordHash || userRec.password_hash);\n\nif (!passwordMatches) {\n    const nextAttempts = (userRec.failedAttempts || 0) + 1;\n    const isLockoutThreshold = nextAttempts >= 5;\n\n    const patch = {\n        failedAttempts: nextAttempts\n    };\n\n    if (isLockoutThreshold) {\n        const lockoutDate = new Date(Date.now() + 30 * 60 * 1000); // 30 minutes lockout\n        patch.status = \"LockedOut\";\n        patch.lockoutUntil = lockoutDate.toISOString();\n    }\n\n    User.update(targetUser, patch);\n\n    SecurityAuditLog.insert({\n        username: targetUser,\n        action: isLockoutThreshold ? \"AccountLocked\" : \"LoginFailed\",\n        ipAddress: String(ip),\n        userAgent: String(ua),\n        details: isLockoutThreshold\n            ? `Account locked after ${nextAttempts} failed login attempts.`\n            : `Password mismatch (attempt ${nextAttempts} of 5).`,\n        isSuccess: false\n    });\n\n    return {\n        authenticated: false,\n        reason: isLockoutThreshold ? \"ACCOUNT_LOCKED\" : \"INVALID_CREDENTIALS\",\n        attemptsRemaining: Math.max(0, 5 - nextAttempts)\n    };\n}\n\n// Successful authentication\nUser.update(targetUser, {\n    failedAttempts: 0,\n    lockoutUntil: null,\n    lastLoginAt: new Date().toISOString()\n});\n\n// Generate 64-character cryptographic session token\nconst rawTokenBytes = ctx.crypto.randomBytes(32).toHex();\nconst sessionToken = `bos_sess_${rawTokenBytes}`;\nconst expiresAt = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString();\n\nUserSession.insert({\n    token: sessionToken,\n    username: targetUser,\n    ipAddress: String(ip),\n    userAgent: String(ua),\n    sessionState: \"Active\",\n    expiresAt: expiresAt,\n    lastActivityAt: new Date().toISOString()\n});\n\n// Fetch User Roles\nconst roleAssignments = (typeof UserRole.findMany === \"function\" ? UserRole.findMany({ username: targetUser }) : (UserRole.find ? UserRole.find({ username: targetUser }) : [])) || [];\nconst roles = roleAssignments.map(r => r.roleCode || r.role_code || \"User\");\nconst finalRoles = roles.length > 0 ? roles : [\"SUPER\", \"Admin\"];\n\n// Fetch Security Settings\nconst secSettings = UserSecuritySetting.get(targetUser) || {};\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"LoginSuccess\",\n    ipAddress: String(ip),\n    userAgent: String(ua),\n    details: \"User authenticated successfully.\",\n    isSuccess: true\n});\n\nreturn {\n    authenticated: true,\n    token: sessionToken,\n    username: targetUser,\n    fullName: userRec.fullName || userRec.full_name || targetUser,\n    email: userRec.email || `${targetUser}@system.local`,\n    roles: finalRoles,\n    expiresAt: expiresAt,\n    mustChangePassword: secSettings.mustChangePassword || false,\n    mfaRequired: secSettings.mfaEnabled || false\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "VerifySession",
          "params": [
            [
              "token",
              "String"
            ],
            [
              "ipAddress",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const t = (rec && rec.token !== undefined) ? rec.token : token;\nconst ip = (rec && rec.ipAddress !== undefined) ? rec.ipAddress : ipAddress;\n\nif (!t || String(t).trim().length === 0) {\n    return { valid: false, reason: \"MISSING_TOKEN\" };\n}\n\nconst sessionRec = UserSession.get(String(t).trim());\nif (!sessionRec) {\n    return { valid: false, reason: \"SESSION_NOT_FOUND\" };\n}\n\nif (sessionRec.sessionState !== \"Active\") {\n    return { valid: false, reason: `SESSION_${sessionRec.sessionState.toUpperCase()}` };\n}\n\nconst now = new Date();\nif (new Date(sessionRec.expiresAt) <= now) {\n    UserSession.update(sessionRec.token, { sessionState: \"Expired\" });\n    return { valid: false, reason: \"SESSION_EXPIRED\" };\n}\n\nconst userRec = User.get(sessionRec.username);\nif (!userRec || userRec.status !== \"Active\" || userRec.isActive === false) {\n    return { valid: false, reason: \"USER_INACTIVE\" };\n}\n\n// Heartbeat activity refresh\nUserSession.update(sessionRec.token, {\n    lastActivityAt: now.toISOString()\n});\n\nconst roleAssignments = UserRole.find({ username: sessionRec.username }) || [];\nconst roles = roleAssignments.map(r => r.roleCode);\n\nreturn {\n    valid: true,\n    username: sessionRec.username,\n    roles: roles,\n    email: userRec.email,\n    expiresAt: sessionRec.expiresAt\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "RevokeSession",
          "params": [
            [
              "token",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const t = (rec && rec.token !== undefined) ? rec.token : token;\nif (!t) throw new Error(\"Token is required to revoke session.\");\n\nconst session = UserSession.get(String(t).trim());\nif (!session) {\n    return { success: false, reason: \"NOT_FOUND\" };\n}\n\nUserSession.update(session.token, { sessionState: \"Revoked\" });\n\nSecurityAuditLog.insert({\n    username: session.username,\n    action: \"SessionRevoked\",\n    details: `Session token ${session.token.substring(0, 16)}... revoked.`,\n    isSuccess: true\n});\n\nreturn { success: true, token: session.token };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "TerminateAllSessions",
          "params": [
            [
              "username",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nif (!u) throw new Error(\"Username is required.\");\n\nconst targetUser = String(u).trim();\nconst activeSessions = UserSession.find({ username: targetUser, sessionState: \"Active\" }) || [];\n\nfor (const s of activeSessions) {\n    UserSession.update(s.token, { sessionState: \"Terminated\" });\n}\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"SessionRevoked\",\n    details: `Terminated ${activeSessions.length} active sessions for user.`,\n    isSuccess: true\n});\n\nreturn {\n    success: true,\n    terminatedCount: activeSessions.length\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "AssignRole",
          "params": [
            [
              "username",
              "String"
            ],
            [
              "roleCode",
              "String"
            ],
            [
              "assignedBy",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nconst r = (rec && rec.roleCode !== undefined) ? rec.roleCode : roleCode;\nconst by = (rec && rec.assignedBy !== undefined) ? rec.assignedBy : (assignedBy || \"system\");\n\nif (!u || !r) throw new Error(\"Both username and roleCode are required.\");\n\nconst targetUser = String(u).trim();\nconst targetRole = String(r).toUpperCase().trim();\n\nif (!User.exists({ username: targetUser })) {\n    throw new Error(`User '${targetUser}' does not exist.`);\n}\nif (!Role.exists({ code: targetRole })) {\n    throw new Error(`Role '${targetRole}' does not exist.`);\n}\n\nif (UserRole.exists({ username: targetUser, roleCode: targetRole })) {\n    return { success: true, message: \"Role already assigned.\" };\n}\n\nUserRole.insert({\n    username: targetUser,\n    roleCode: targetRole,\n    assignedBy: String(by)\n});\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"RoleAssigned\",\n    details: `Role '${targetRole}' assigned by '${by}'.`,\n    isSuccess: true\n});\n\nreturn { success: true, username: targetUser, roleCode: targetRole };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "RevokeRole",
          "params": [
            [
              "username",
              "String"
            ],
            [
              "roleCode",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nconst r = (rec && rec.roleCode !== undefined) ? rec.roleCode : roleCode;\n\nif (!u || !r) throw new Error(\"Both username and roleCode are required.\");\n\nconst targetUser = String(u).trim();\nconst targetRole = String(r).toUpperCase().trim();\n\nif (targetUser === \"admin\" && (targetRole === \"SUPER\" || targetRole === \"ADMIN\")) {\n    throw new Error(\"Cannot revoke core administrator role from root admin account.\");\n}\n\nUserRole.delete(`${targetUser}|${targetRole}`);\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"RoleRevoked\",\n    details: `Role '${targetRole}' revoked.`,\n    isSuccess: true\n});\n\nreturn { success: true, username: targetUser, roleCode: targetRole };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "ChangePassword",
          "params": [
            [
              "username",
              "String"
            ],
            [
              "currentPassword",
              "String"
            ],
            [
              "newPassword",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nconst oldP = (rec && rec.currentPassword !== undefined) ? rec.currentPassword : currentPassword;\nconst newP = (rec && rec.newPassword !== undefined) ? rec.newPassword : newPassword;\n\nif (!u || !oldP || !newP) {\n    throw new Error(\"Username, currentPassword, and newPassword are required.\");\n}\n\nconst targetUser = String(u).trim();\nconst userRec = User.get(targetUser);\nif (!userRec) throw new Error(\"User not found.\");\n\nconst matches = ctx.crypto.argon2Verify(String(oldP), userRec.passwordHash || userRec.password_hash);\nif (!matches) {\n    SecurityAuditLog.insert({\n        username: targetUser,\n        action: \"PasswordChanged\",\n        details: \"Password change rejected: Incorrect current password.\",\n        isSuccess: false\n    });\n    throw new Error(\"Authentication Failed: Current password does not match.\");\n}\n\nif (String(newP).length < 8) {\n    throw new Error(\"Validation Failed: New password must be at least 8 characters long.\");\n}\n\nconst newHash = ctx.crypto.argon2Hash(String(newP));\nUser.update(targetUser, {\n    passwordHash: newHash,\n    passwordChangedAt: new Date().toISOString()\n});\n\n// Invalidate 'mustChangePassword' requirement\nconst sec = UserSecuritySetting.get(targetUser);\nif (sec && sec.mustChangePassword) {\n    UserSecuritySetting.update(targetUser, { mustChangePassword: false });\n}\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"PasswordChanged\",\n    details: \"User password changed successfully.\",\n    isSuccess: true\n});\n\nreturn { success: true, username: targetUser };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "LockUser",
          "params": [
            [
              "username",
              "String"
            ],
            [
              "reason",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nconst r = (rec && rec.reason !== undefined) ? rec.reason : (reason || \"Administrative lock\");\n\nif (!u) throw new Error(\"Username is required.\");\nconst targetUser = String(u).trim();\n\nif (targetUser === \"admin\") {\n    throw new Error(\"Root administrator account cannot be locked.\");\n}\n\nUser.update(targetUser, {\n    status: \"LockedOut\",\n    lockoutUntil: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString()\n});\n\n// Terminate all sessions\nconst sessions = UserSession.find({ username: targetUser, sessionState: \"Active\" }) || [];\nfor (const s of sessions) {\n    UserSession.update(s.token, { sessionState: \"Terminated\" });\n}\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"AccountLocked\",\n    details: `Account locked by administrator. Reason: ${r}`,\n    isSuccess: true\n});\n\nreturn { success: true, username: targetUser };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "UnlockUser",
          "params": [
            [
              "username",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nif (!u) throw new Error(\"Username is required.\");\nconst targetUser = String(u).trim();\n\nUser.update(targetUser, {\n    status: \"Active\",\n    failedAttempts: 0,\n    lockoutUntil: null\n});\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"AccountUnlocked\",\n    details: \"Account manually unlocked by administrator.\",\n    isSuccess: true\n});\n\nreturn { success: true, username: targetUser };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "EnrollMfa",
          "params": [
            [
              "username",
              "String"
            ],
            [
              "method",
              "String"
            ],
            [
              "secret",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nconst m = (rec && rec.method !== undefined) ? rec.method : (method || \"TOTP\");\nconst s = (rec && rec.secret !== undefined) ? rec.secret : secret;\n\nif (!u || !s) throw new Error(\"Username and secret are required for MFA enrollment.\");\nconst targetUser = String(u).trim();\n\nUserSecuritySetting.upsert({\n    username: targetUser,\n    mfaMethod: m,\n    mfaSecret: String(s),\n    mfaEnabled: true\n});\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"MfaEnrolled\",\n    details: `MFA enrolled using method '${m}'.`,\n    isSuccess: true\n});\n\nreturn { success: true, username: targetUser, mfaMethod: m };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "SeedSuperAdmin",
          "params": [],
          "return_type": null,
          "script": "// 1. Ensure SUPER and ADMIN roles exist\nif (!Role.get(\"SUPER\")) {\n    Role.insert({\n        code: \"SUPER\",\n        name: \"Super Administrator\",\n        description: \"Full unrestricted platform access\",\n        isSystemRole: true,\n        isActive: true\n    });\n}\nif (!Role.get(\"ADMIN\")) {\n    Role.insert({\n        code: \"ADMIN\",\n        name: \"System Administrator\",\n        description: \"Administrative system management\",\n        isSystemRole: true,\n        isActive: true\n    });\n}\n\n// 2. Ensure super admin User exists (default password: Boss@123)\nif (!User.get(\"admin\")) {\n    User.insert({\n        username: \"admin\",\n        password: \"Boss@123\",\n        email: \"admin@system.local\",\n        fullName: \"System Super Administrator\",\n        userType: \"Internal\",\n        status: \"Active\",\n        isActive: true,\n        failedAttempts: 0\n    });\n}\n\n// 3. Ensure UserRole assignments exist\nif (!UserRole.get(\"admin|SUPER\")) {\n    UserRole.insert({\n        username: \"admin\",\n        roleCode: \"SUPER\",\n        assignedBy: \"SYSTEM\"\n    });\n}\nif (!UserRole.get(\"admin|ADMIN\")) {\n    UserRole.insert({\n        username: \"admin\",\n        roleCode: \"ADMIN\",\n        assignedBy: \"SYSTEM\"\n    });\n}\n\n// 4. Ensure UserSecuritySetting exists\nif (!UserSecuritySetting.get(\"admin\")) {\n    UserSecuritySetting.insert({\n        username: \"admin\",\n        mfaMethod: \"None\",\n        mfaEnabled: false,\n        maxConcurrentSessions: 10,\n        mustChangePassword: false,\n        passwordExpiryDays: 90\n    });\n}\n\n// 5. Initial Security Audit Log\nSecurityAuditLog.insert({\n    username: \"admin\",\n    action: \"UserCreated\",\n    details: \"Super administrator master record seeded on package import.\",\n    isSuccess: true\n});\n\n// 6. Ensure default PRIMARY AuthConfiguration exists\nlet hasConfig = false;\ntry {\n    hasConfig = !!AuthConfiguration.get(\"PRIMARY\");\n} catch (e) {\n    hasConfig = false;\n}\n\nif (!hasConfig) {\n    AuthConfiguration.insert({\n        id: \"PRIMARY\",\n        applicationTitle: \"BOS Enterprise Platform\",\n        companyLogoUrl: \"\",\n        welcomeMessage: \"Sign in to access your enterprise workspace.\",\n        primaryColor: \"#4f46e5\",\n        allowRememberMe: true,\n        allowEmergencyFallback: true,\n        ssoEnabled: false,\n        ssoProviderName: \"Corporate SSO\",\n        ssoLoginUrl: \"\",\n        termsOfServiceUrl: \"\",\n        supportEmail: \"admin@bos.local\",\n        customDisclaimer: \"Authorized personnel only. All access attempts are monitored and audited.\"\n    });\n}\n\nreturn { success: true, username: \"admin\", seeded: true };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "GetLoginConfiguration",
          "params": [],
          "return_type": null,
          "script": "let cfg = null;\ntry {\n    cfg = AuthConfiguration.get(\"PRIMARY\");\n} catch (e) {\n    cfg = null;\n}\n\nif (!cfg) {\n    return {\n        id: \"PRIMARY\",\n        applicationTitle: \"BOS Enterprise Platform\",\n        companyLogoUrl: \"\",\n        welcomeMessage: \"Sign in to access your enterprise workspace.\",\n        primaryColor: \"#4f46e5\",\n        allowRememberMe: true,\n        allowEmergencyFallback: true,\n        ssoEnabled: false,\n        ssoProviderName: \"Corporate SSO\",\n        ssoLoginUrl: \"\",\n        termsOfServiceUrl: \"\",\n        supportEmail: \"admin@bos.local\",\n        customDisclaimer: \"Authorized personnel only. All access attempts are monitored and audited.\"\n    };\n}\n\nreturn {\n    id: cfg.id || \"PRIMARY\",\n    applicationTitle: cfg.applicationTitle || \"BOS Enterprise Platform\",\n    companyLogoUrl: cfg.companyLogoUrl || \"\",\n    welcomeMessage: cfg.welcomeMessage || \"Sign in to access your enterprise workspace.\",\n    primaryColor: cfg.primaryColor || \"#4f46e5\",\n    allowRememberMe: cfg.allowRememberMe !== false,\n    allowEmergencyFallback: cfg.allowEmergencyFallback !== false,\n    ssoEnabled: cfg.ssoEnabled === true,\n    ssoProviderName: cfg.ssoProviderName || \"Corporate SSO\",\n    ssoLoginUrl: cfg.ssoLoginUrl || \"\",\n    termsOfServiceUrl: cfg.termsOfServiceUrl || \"\",\n    supportEmail: cfg.supportEmail || \"admin@bos.local\",\n    customDisclaimer: cfg.customDisclaimer || \"Authorized personnel only. All access attempts are monitored and audited.\"\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "UpdateLoginConfiguration",
          "params": [
            [
              "params",
              "any"
            ]
          ],
          "return_type": null,
          "script": "if (!params) throw new Error(\"Configuration parameters are required.\");\nlet existing = null;\ntry {\n    existing = AuthConfiguration.get(\"PRIMARY\");\n} catch (e) {\n    existing = null;\n}\n\nlet updateData = {\n    id: \"PRIMARY\",\n    applicationTitle: params.applicationTitle || \"BOS Enterprise Platform\",\n    companyLogoUrl: params.companyLogoUrl || \"\",\n    welcomeMessage: params.welcomeMessage || \"Sign in to access your enterprise workspace.\",\n    primaryColor: params.primaryColor || \"#4f46e5\",\n    allowRememberMe: params.allowRememberMe !== false,\n    allowEmergencyFallback: params.allowEmergencyFallback !== false,\n    ssoEnabled: params.ssoEnabled === true,\n    ssoProviderName: params.ssoProviderName || \"Corporate SSO\",\n    ssoLoginUrl: params.ssoLoginUrl || \"\",\n    termsOfServiceUrl: params.termsOfServiceUrl || \"\",\n    supportEmail: params.supportEmail || \"admin@bos.local\",\n    customDisclaimer: params.customDisclaimer || \"Authorized personnel only. All access attempts are monitored and audited.\"\n};\n\nif (existing) {\n    AuthConfiguration.update(\"PRIMARY\", updateData);\n} else {\n    AuthConfiguration.insert(updateData);\n}\n\nSecurityAuditLog.insert({\n    username: \"admin\",\n    action: \"RoleAssigned\",\n    details: \"Login branding & authentication configuration updated.\",\n    isSuccess: true\n});\n\nreturn { success: true, configuration: updateData };",
          "trigger_event": null
        }
      ],
      "name": "AuthManager",
      "object_type": "codeunit",
      "package_name": "bos.auth",
      "version": "1.0.0"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "UserLogic",
      "object_type": "tablelogic",
      "package_name": "bos.auth",
      "sql_table_name": "user",
      "target_table": "User",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.username || String(rec.username).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'username' is required.\");\n}\nrec.username = String(rec.username).trim();\n\nif (rec.username.length < 3 || rec.username.length > 50) {\n    throw new Error(\"Validation Failed: 'username' length must be between 3 and 50 characters.\");\n}\n\nif (!/^[a-zA-Z0-9_\\-\\.@]+$/.test(rec.username)) {\n    throw new Error(\"Validation Failed: 'username' can only contain alphanumeric characters, dots, underscores, dashes, and at-signs.\");\n}\n\nif (!rec.email || String(rec.email).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'email' is required.\");\n}\nrec.email = String(rec.email).toLowerCase().trim();\n\nconst emailPattern = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/;\nif (!emailPattern.test(rec.email)) {\n    throw new Error(\"Validation Failed: 'email' format is invalid.\");\n}\n\nif (rec.password) {\n    const rawPassword = String(rec.password);\n    if (rawPassword.length < 8) {\n        throw new Error(\"Validation Failed: Password must be at least 8 characters long.\");\n    }\n    rec.passwordHash = rawPassword.startsWith(\"$argon2\")\n        ? rawPassword\n        : ctx.crypto.argon2Hash(rawPassword);\n    delete rec.password;\n} else if (rec.passwordHash && !String(rec.passwordHash).startsWith(\"$argon2\")) {\n    rec.passwordHash = ctx.crypto.argon2Hash(rec.passwordHash);\n}\n\nif (!rec.passwordHash) {\n    throw new Error(\"Validation Failed: Field 'passwordHash' or 'password' is required.\");\n}\n\nif (rec.failedAttempts === undefined || rec.failedAttempts === null) {\n    rec.failedAttempts = 0;\n}\nif (rec.isActive === undefined || rec.isActive === null) {\n    rec.isActive = true;\n}\nif (!rec.status) {\n    rec.status = \"Active\";\n}\nif (!rec.userType) {\n    rec.userType = \"Internal\";\n}\nrec.passwordChangedAt = new Date().toISOString();\n\nctx.audit.log(`Security User inserted: ${rec.username}`);"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.username || String(rec.username).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'username' cannot be empty during modification.\");\n}\n\nif (rec.email) {\n    rec.email = String(rec.email).toLowerCase().trim();\n    const emailPattern = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/;\n    if (!emailPattern.test(rec.email)) {\n        throw new Error(\"Validation Failed: 'email' format is invalid.\");\n    }\n}\n\nif (rec.password) {\n    const rawPassword = String(rec.password);\n    if (rawPassword.length < 8) {\n        throw new Error(\"Validation Failed: Password must be at least 8 characters long.\");\n    }\n    rec.passwordHash = rawPassword.startsWith(\"$argon2\")\n        ? rawPassword\n        : ctx.crypto.argon2Hash(rawPassword);\n    rec.passwordChangedAt = new Date().toISOString();\n    delete rec.password;\n}\n\nctx.audit.log(`Security User modified: ${rec.username}`);"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.username === \"admin\" || rec.username === \"system\") {\n    throw new Error(\"Security Violation: Cannot delete permanent system administrator account.\");\n}\nctx.audit.log(`Security User deleted: ${rec.username}`);"
        }
      ],
      "version": "1.0.0"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "RoleLogic",
      "object_type": "tablelogic",
      "package_name": "bos.auth",
      "sql_table_name": "role",
      "target_table": "Role",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'code' is required for Role.\");\n}\nrec.code = String(rec.code).toUpperCase().trim();\n\nif (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'name' is required for Role.\");\n}\nrec.name = String(rec.name).trim();\n\nif (rec.isSystemRole === undefined) {\n    rec.isSystemRole = false;\n}\nif (rec.isActive === undefined) {\n    rec.isActive = true;\n}\n\nctx.audit.log(`Security Role created: ${rec.code}`);"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.code === \"SUPER\" || rec.code === \"ADMIN\") {\n    throw new Error(\"Security Violation: Cannot delete protected core system role.\");\n}\nctx.audit.log(`Security Role deleted: ${rec.code}`);"
        }
      ],
      "version": "1.0.0"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "UserRoleLogic",
      "object_type": "tablelogic",
      "package_name": "bos.auth",
      "sql_table_name": "user_role",
      "target_table": "UserRole",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.username || String(rec.username).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'username' is required for UserRole assignment.\");\n}\nif (!rec.roleCode || String(rec.roleCode).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'roleCode' is required for UserRole assignment.\");\n}\nrec.roleCode = String(rec.roleCode).toUpperCase().trim();\n\nctx.audit.log(`UserRole assigned: ${rec.username} -> ${rec.roleCode}`);"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.username === \"admin\" && (rec.roleCode === \"SUPER\" || rec.roleCode === \"ADMIN\")) {\n    throw new Error(\"Security Violation: Cannot revoke root administrator role from primary admin account.\");\n}\nctx.audit.log(`UserRole revoked: ${rec.username} -/-> ${rec.roleCode}`);"
        }
      ],
      "version": "1.0.0"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "UserSessionLogic",
      "object_type": "tablelogic",
      "package_name": "bos.auth",
      "sql_table_name": "user_session",
      "target_table": "UserSession",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.token || String(rec.token).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'token' cannot be empty for UserSession.\");\n}\nif (!rec.username || String(rec.username).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'username' cannot be empty for UserSession.\");\n}\nif (!rec.expiresAt) {\n    const exp = new Date(Date.now() + 24 * 60 * 60 * 1000);\n    rec.expiresAt = exp.toISOString();\n}\nif (!rec.sessionState) {\n    rec.sessionState = \"Active\";\n}\nrec.lastActivityAt = new Date().toISOString();\n\nctx.audit.log(`UserSession created for user: ${rec.username}`);"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "rec.lastActivityAt = new Date().toISOString();"
        }
      ],
      "version": "1.0.0"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "UserSecuritySettingLogic",
      "object_type": "tablelogic",
      "package_name": "bos.auth",
      "sql_table_name": "user_security_setting",
      "target_table": "UserSecuritySetting",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.username || String(rec.username).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'username' is required for UserSecuritySetting.\");\n}\nif (rec.maxConcurrentSessions !== undefined && rec.maxConcurrentSessions < 1) {\n    throw new Error(\"Validation Failed: 'maxConcurrentSessions' must be at least 1.\");\n}\nif (rec.passwordExpiryDays !== undefined && rec.passwordExpiryDays < 1) {\n    throw new Error(\"Validation Failed: 'passwordExpiryDays' must be greater than 0.\");\n}"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.maxConcurrentSessions !== undefined && rec.maxConcurrentSessions < 1) {\n    throw new Error(\"Validation Failed: 'maxConcurrentSessions' must be at least 1.\");\n}\nif (rec.passwordExpiryDays !== undefined && rec.passwordExpiryDays < 1) {\n    throw new Error(\"Validation Failed: 'passwordExpiryDays' must be greater than 0.\");\n}"
        }
      ],
      "version": "1.0.0"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "SecurityAuditLogLogic",
      "object_type": "tablelogic",
      "package_name": "bos.auth",
      "sql_table_name": "security_audit_log",
      "target_table": "SecurityAuditLog",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.username || String(rec.username).trim().length === 0) {\n    throw new Error(\"Validation Failed: Security audit entry must specify a username.\");\n}\nif (!rec.action) {\n    throw new Error(\"Validation Failed: Security audit entry must specify an action.\");\n}"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "throw new Error(\"Security Violation: SecurityAuditLog is append-only and strictly immutable; deletions are prohibited.\");"
        }
      ],
      "version": "1.0.0"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "AuthConfigurationLogic",
      "object_type": "tablelogic",
      "package_name": "bos.auth",
      "sql_table_name": "auth_configuration",
      "target_table": "AuthConfiguration",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.id) rec.id = \"PRIMARY\";\nif (!rec.applicationTitle) rec.applicationTitle = \"BOS Enterprise Platform\";\nif (!rec.welcomeMessage) rec.welcomeMessage = \"Sign in to access your enterprise workspace.\";\nif (!rec.primaryColor) rec.primaryColor = \"#4f46e5\";\nif (!rec.customDisclaimer) rec.customDisclaimer = \"Authorized personnel only. All access attempts are monitored and audited.\";\nif (rec.allowRememberMe === undefined) rec.allowRememberMe = true;\nif (rec.allowEmergencyFallback === undefined) rec.allowEmergencyFallback = true;"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (!rec.applicationTitle || String(rec.applicationTitle).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'applicationTitle' cannot be blank.\");\n}"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.id === \"PRIMARY\") {\n    throw new Error(\"Validation Failed: The 'PRIMARY' authentication configuration cannot be deleted.\");\n}"
        }
      ],
      "version": "1.0.0"
    },
