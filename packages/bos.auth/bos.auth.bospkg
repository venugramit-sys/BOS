      "name": "User",
      "object_type": "table",
      "on_delete": null,
      "package_name": "bos.auth",
      "primary_key": [
        "username"
      ],
      "sql_table_name": "user",
      "table_type": "Normal",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.username || String(rec.username).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'username' is required.\");\n}\nrec.username = String(rec.username).trim();\n\nif (rec.username.length < 3 || rec.username.length > 50) {\n    throw new Error(\"Validation Failed: 'username' length must be between 3 and 50 characters.\");\n}\n\nif (!/^[a-zA-Z0-9_\\-\\.@]+$/.test(rec.username)) {\n    throw new Error(\"Validation Failed: 'username' can only contain alphanumeric characters, dots, underscores, dashes, and at-signs.\");\n}\n\nif (!rec.email || String(rec.email).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'email' is required.\");\n}\nrec.email = String(rec.email).toLowerCase().trim();\n\nconst emailPattern = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/;\nif (!emailPattern.test(rec.email)) {\n    throw new Error(\"Validation Failed: 'email' format is invalid.\");\n}\n\nif (rec.password) {\n    const rawPassword = String(rec.password);\n    if (rawPassword.length < 8) {\n        throw new Error(\"Validation Failed: Password must be at least 8 characters long.\");\n    }\n    rec.passwordHash = rawPassword.startsWith(\"$argon2\")\n        ? rawPassword\n        : ctx.crypto.argon2Hash(rawPassword);\n    delete rec.password;\n} else if (rec.passwordHash && !String(rec.passwordHash).startsWith(\"$argon2\")) {\n    rec.passwordHash = ctx.crypto.argon2Hash(rec.passwordHash);\n}\n\nif (!rec.passwordHash) {\n    throw new Error(\"Validation Failed: Field 'passwordHash' or 'password' is required.\");\n}\n\nif (rec.failedAttempts === undefined || rec.failedAttempts === null) {\n    rec.failedAttempts = 0;\n}\nif (rec.isActive === undefined || rec.isActive === null) {\n    rec.isActive = true;\n}\nif (!rec.status) {\n    rec.status = \"Active\";\n}\nif (!rec.userType) {\n    rec.userType = \"Internal\";\n}\nrec.passwordChangedAt = new Date().toISOString();\n\nctx.audit.log(`Security User inserted: ${rec.username}`);"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.username || String(rec.username).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'username' cannot be empty during modification.\");\n}\n\nif (rec.email) {\n    rec.email = String(rec.email).toLowerCase().trim();\n    const emailPattern = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/;\n    if (!emailPattern.test(rec.email)) {\n        throw new Error(\"Validation Failed: 'email' format is invalid.\");\n    }\n}\n\nif (rec.password) {\n    const rawPassword = String(rec.password);\n    if (rawPassword.length < 8) {\n        throw new Error(\"Validation Failed: Password must be at least 8 characters long.\");\n    }\n    rec.passwordHash = rawPassword.startsWith(\"$argon2\")\n        ? rawPassword\n        : ctx.crypto.argon2Hash(rawPassword);\n    rec.passwordChangedAt = new Date().toISOString();\n    delete rec.password;\n}\n\nctx.audit.log(`Security User modified: ${rec.username}`);"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.username === \"admin\" || rec.username === \"system\") {\n    throw new Error(\"Security Violation: Cannot delete permanent system administrator account.\");\n}\nctx.audit.log(`Security User deleted: ${rec.username}`);"
        }
      ],
      "version": "1.0.0"
    },
