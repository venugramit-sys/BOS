      "name": "UserSession",
      "object_type": "table",
      "on_delete": null,
      "package_name": "bos.auth",
      "primary_key": [
        "token"
      ],
      "sql_table_name": "user_session",
      "table_type": "Normal",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.token || String(rec.token).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'token' cannot be empty for UserSession.\");\n}\nif (!rec.username || String(rec.username).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'username' cannot be empty for UserSession.\");\n}\nif (!rec.expiresAt) {\n    const exp = new Date(Date.now() + 24 * 60 * 60 * 1000);\n    rec.expiresAt = exp.toISOString();\n}\nif (!rec.sessionState) {\n    rec.sessionState = \"Active\";\n}\nrec.lastActivityAt = new Date().toISOString();\n\nctx.audit.log(`UserSession created for user: ${rec.username}`);"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "rec.lastActivityAt = new Date().toISOString();"
        }
      ],
