        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.id) rec.id = \"PRIMARY\";\nif (!rec.applicationTitle) rec.applicationTitle = \"BOS Enterprise Platform\";\nif (!rec.welcomeMessage) rec.welcomeMessage = \"Sign in to access your enterprise workspace.\";\nif (!rec.primaryColor) rec.primaryColor = \"#4f46e5\";\nif (!rec.customDisclaimer) rec.customDisclaimer = \"Authorized personnel only. All access attempts are monitored and audited.\";\nif (rec.allowRememberMe === undefined) rec.allowRememberMe = true;\nif (rec.allowEmergencyFallback === undefined) rec.allowEmergencyFallback = true;"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (!rec.applicationTitle || String(rec.applicationTitle).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'applicationTitle' cannot be blank.\");\n}"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.id === \"PRIMARY\") {\n    throw new Error(\"Validation Failed: The 'PRIMARY' authentication configuration cannot be deleted.\");\n}"
        }
      ],
      "version": "1.0.0"
    },
