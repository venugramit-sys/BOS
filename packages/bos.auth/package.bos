// 5. USER INTERFACE PAGES
// ----------------------------------------------------------------------------

page UserList for User {
    pageType = List;
    caption = "User Management";

    layout {
        area(Content) {
            repeater(UserTable) {
                field(username) {
                    caption = "Username";
                }
                field(email) {
                    caption = "Email Address";
                }
                field(fullName) {
                    caption = "Full Name";
                }
                field(userType) {
                    caption = "User Type";
                }
                field(status) {
                    caption = "Status";
                }
                field(failedAttempts) {
                    caption = "Failed Logins";
                }
                field(activeSessionCount) {
                    caption = "Active Sessions";
                }
                field(lastLoginAt) {
                    caption = "Last Login";
                }
            }
        }
    }

    actions {
        action(LockAccount) {
            caption = "Lock Account";
            icon = "Lock";
            onAction(rec, ctx) {
                if (!rec || !rec.username) throw new Error("Please select a user to lock.");
                ctx.call("AuthManager", "LockUser", { username: rec.username, reason: "Manual Admin Lock" });
                ctx.ui.toast("warning", "User Locked", `User account ${rec.username} has been locked.`);
            }
        }

        action(UnlockAccount) {
            caption = "Unlock Account";
            icon = "Unlock";
            onAction(rec, ctx) {
                if (!rec || !rec.username) throw new Error("Please select a user to unlock.");
                ctx.call("AuthManager", "UnlockUser", { username: rec.username });
                ctx.ui.toast("success", "User Unlocked", `User account ${rec.username} has been restored to Active.`);
            }
        }

        action(TerminateSessions) {
            caption = "Terminate Sessions";
            icon = "Power";
            onAction(rec, ctx) {
                if (!rec || !rec.username) throw new Error("Please select a user.");
                ctx.call("AuthManager", "TerminateAllSessions", { username: rec.username });
                ctx.ui.toast("info", "Sessions Cleared", `All active sessions for ${rec.username} have been terminated.`);
            }
        }
    }
}

