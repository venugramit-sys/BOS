// ============================================================================
// BOS Package: bos.auth
// Module: Enterprise User Management, Identity & Authentication
// ============================================================================

// ----------------------------------------------------------------------------
// 1. EXTENSIBLE ENUMERATIONS
// ----------------------------------------------------------------------------

enum UserStatus {
    extensible = true;
    Active;
    Inactive;
    Suspended;
    LockedOut;
    PendingVerification;
}

enum UserType {
    extensible = true;
    Internal;
    External;
    ServiceAccount;
    System;
}

enum SessionState {
    extensible = true;
    Active;
    Expired;
    Revoked;
    Terminated;
}

enum AuditAction {
    extensible = true;
    LoginSuccess;
    LoginFailed;
    PasswordChanged;
    RoleAssigned;
    RoleRevoked;
    AccountLocked;
    AccountUnlocked;
    SessionRevoked;
    MfaEnrolled;
}

enum MfaMethod {
    extensible = true;
    None;
    TOTP;
    EmailOTP;
    SMSOTP;
    WebAuthn;
}

// ----------------------------------------------------------------------------
// 2. DOMAIN TABLES (Clean, Singular PascalCase Naming Standard)
// ----------------------------------------------------------------------------

table User {
    caption = "User Master";
    tableType = Normal;
    dataPerCompany = false;

    username: String(50) {
        notNull = true;
        unique = true;
    };
    passwordHash: String(255) {
        notNull = true;
    };
    email: String(100) {
        notNull = true;
        unique = true;
    };
    fullName: String(100);
    phoneNumber: String(25);
    userType: Enum(UserType) {
        default = "Internal";
    };
    status: Enum(UserStatus) {
        default = "Active";
    };
    failedAttempts: Integer {
        default = 0;
    };
    lockoutUntil: DateTime;
    lastLoginAt: DateTime;
    passwordChangedAt: DateTime;
    isActive: Boolean {
        default = true;
    };

    activeSessionCount: Integer {
        computed = count(UserSession where { username == username && sessionState == "Active" });
    };

    primaryKey(username);
    key(email);
    key(status);
}

table Role {
    caption = "Security Role";
    tableType = Normal;
    dataPerCompany = false;

    code: String(30) {
        notNull = true;
        unique = true;
    };
    name: String(100) {
        notNull = true;
    };
    description: String(255);
    isSystemRole: Boolean {
        default = false;
    };
    isActive: Boolean {
        default = true;
    };

    assignedUsersCount: Integer {
        computed = count(UserRole where { roleCode == code });
    };

    primaryKey(code);
}

table UserRole {
    caption = "User Role Assignment";
    tableType = Normal;
    dataPerCompany = false;

    username: String(50) {
        notNull = true;
        relation = User.username;
        onDelete = cascade;
    };
    roleCode: String(30) {
        notNull = true;
        relation = Role.code;
        onDelete = cascade;
    };
    assignedBy: String(50);

    primaryKey(username, roleCode);
    key(roleCode);
}

table UserSession {
    caption = "User Active Sessions";
    tableType = Normal;
    dataPerCompany = false;

    token: String(128) {
        notNull = true;
        unique = true;
    };
    username: String(50) {
        notNull = true;
        relation = User.username;
        onDelete = cascade;
    };
    ipAddress: String(45);
    userAgent: String(255);
    sessionState: Enum(SessionState) {
        default = "Active";
    };
    expiresAt: DateTime {
        notNull = true;
    };
    lastActivityAt: DateTime;

    primaryKey(token);
    key(username);
    key(sessionState);
}

table UserSecuritySetting {
    caption = "User Security Settings & Policies";
    tableType = Normal;
    dataPerCompany = false;

    username: String(50) {
        notNull = true;
        unique = true;
        relation = User.username;
        onDelete = cascade;
    };
    mfaMethod: Enum(MfaMethod) {
        default = "None";
    };
    mfaSecret: String(128);
    mfaEnabled: Boolean {
        default = false;
    };
    maxConcurrentSessions: Integer {
        default = 5;
    };
    mustChangePassword: Boolean {
        default = false;
    };
    passwordExpiryDays: Integer {
        default = 90;
    };

    primaryKey(username);
}

table SecurityAuditLog {
    caption = "Immutable Security Audit Log";
    tableType = Normal;
    dataPerCompany = false;

    id: UUID {
        default = auto();
    };
    username: String(50) {
        notNull = true;
    };
    action: Enum(AuditAction) {
        notNull = true;
    };
    ipAddress: String(45);
    userAgent: String(255);
    details: String(500);
    isSuccess: Boolean {
        default = true;
    };

    primaryKey(id);
    key(username);
    key(action);
}

table AuthConfiguration {
    caption = "Authentication & Login Branding Configuration";
    tableType = Normal;
    dataPerCompany = false;

    id: String(20) {
        notNull = true;
    };
    applicationTitle: String(100) {
        default = "BOS Enterprise Platform";
    };
    companyLogoUrl: String(255);
    welcomeMessage: String(255) {
        default = "Sign in to access your enterprise workspace.";
    };
    primaryColor: String(30) {
        default = "#4f46e5";
    };
    allowRememberMe: Boolean {
        default = true;
    };
    allowEmergencyFallback: Boolean {
        default = true;
    };
    ssoEnabled: Boolean {
        default = false;
    };
    ssoProviderName: String(50) {
        default = "Corporate SSO";
    };
    ssoLoginUrl: String(255);
    termsOfServiceUrl: String(255);
    supportEmail: String(100) {
        default = "admin@bos.local";
    };
    customDisclaimer: String(500) {
        default = "Authorized personnel only. All access attempts are monitored and audited.";
    };

    primaryKey(id);
}

// ----------------------------------------------------------------------------
// 3. TABLE LOGIC COMPANIONS (Field Validations, Triggers & Entity Invariants)
// ----------------------------------------------------------------------------

tablelogic UserLogic for User {
    onInsert(rec, ctx) {
        if (!rec.username || String(rec.username).trim().length === 0) {
            throw new Error("Validation Failed: Field 'username' is required.");
        }
        rec.username = String(rec.username).trim();

        if (rec.username.length < 3 || rec.username.length > 50) {
            throw new Error("Validation Failed: 'username' length must be between 3 and 50 characters.");
        }

        if (!/^[a-zA-Z0-9_\-\.@]+$/.test(rec.username)) {
            throw new Error("Validation Failed: 'username' can only contain alphanumeric characters, dots, underscores, dashes, and at-signs.");
        }

        if (!rec.email || String(rec.email).trim().length === 0) {
            throw new Error("Validation Failed: Field 'email' is required.");
        }
        rec.email = String(rec.email).toLowerCase().trim();

        const emailPattern = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
        if (!emailPattern.test(rec.email)) {
            throw new Error("Validation Failed: 'email' format is invalid.");
        }

        if (rec.password) {
            const rawPassword = String(rec.password);
            if (rawPassword.length < 8) {
                throw new Error("Validation Failed: Password must be at least 8 characters long.");
            }
            rec.passwordHash = rawPassword.startsWith("$argon2")
                ? rawPassword
                : ctx.crypto.argon2Hash(rawPassword);
            delete rec.password;
        } else if (rec.passwordHash && !String(rec.passwordHash).startsWith("$argon2")) {
            rec.passwordHash = ctx.crypto.argon2Hash(rec.passwordHash);
        }

        if (!rec.passwordHash) {
            throw new Error("Validation Failed: Field 'passwordHash' or 'password' is required.");
        }

        if (rec.failedAttempts === undefined || rec.failedAttempts === null) {
            rec.failedAttempts = 0;
        }
        if (rec.isActive === undefined || rec.isActive === null) {
            rec.isActive = true;
        }
        if (!rec.status) {
            rec.status = "Active";
        }
        if (!rec.userType) {
            rec.userType = "Internal";
        }
        rec.passwordChangedAt = new Date().toISOString();

        ctx.audit.log(`Security User inserted: ${rec.username}`);
    }

    onModify(rec, ctx) {
        if (!rec.username || String(rec.username).trim().length === 0) {
            throw new Error("Validation Failed: 'username' cannot be empty during modification.");
        }

        if (rec.email) {
            rec.email = String(rec.email).toLowerCase().trim();
            const emailPattern = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
            if (!emailPattern.test(rec.email)) {
                throw new Error("Validation Failed: 'email' format is invalid.");
            }
        }

        if (rec.password) {
            const rawPassword = String(rec.password);
            if (rawPassword.length < 8) {
                throw new Error("Validation Failed: Password must be at least 8 characters long.");
            }
            rec.passwordHash = rawPassword.startsWith("$argon2")
                ? rawPassword
                : ctx.crypto.argon2Hash(rawPassword);
            rec.passwordChangedAt = new Date().toISOString();
            delete rec.password;
        }

        ctx.audit.log(`Security User modified: ${rec.username}`);
    }

    onDelete(rec, ctx) {
        if (rec.username === "admin" || rec.username === "system") {
            throw new Error("Security Violation: Cannot delete permanent system administrator account.");
        }
        ctx.audit.log(`Security User deleted: ${rec.username}`);
    }
}

tablelogic RoleLogic for Role {
    onInsert(rec, ctx) {
        if (!rec.code || String(rec.code).trim().length === 0) {
            throw new Error("Validation Failed: Field 'code' is required for Role.");
        }
        rec.code = String(rec.code).toUpperCase().trim();

        if (!rec.name || String(rec.name).trim().length === 0) {
            throw new Error("Validation Failed: Field 'name' is required for Role.");
        }
        rec.name = String(rec.name).trim();

        if (rec.isSystemRole === undefined) {
            rec.isSystemRole = false;
        }
        if (rec.isActive === undefined) {
            rec.isActive = true;
        }

        ctx.audit.log(`Security Role created: ${rec.code}`);
    }

    onDelete(rec, ctx) {
        if (rec.code === "SUPER" || rec.code === "ADMIN") {
            throw new Error("Security Violation: Cannot delete protected core system role.");
        }
        ctx.audit.log(`Security Role deleted: ${rec.code}`);
    }
}

tablelogic UserRoleLogic for UserRole {
    onInsert(rec, ctx) {
        if (!rec.username || String(rec.username).trim().length === 0) {
            throw new Error("Validation Failed: 'username' is required for UserRole assignment.");
        }
        if (!rec.roleCode || String(rec.roleCode).trim().length === 0) {
            throw new Error("Validation Failed: 'roleCode' is required for UserRole assignment.");
        }
        rec.roleCode = String(rec.roleCode).toUpperCase().trim();

        ctx.audit.log(`UserRole assigned: ${rec.username} -> ${rec.roleCode}`);
    }

    onDelete(rec, ctx) {
        if (rec.username === "admin" && (rec.roleCode === "SUPER" || rec.roleCode === "ADMIN")) {
            throw new Error("Security Violation: Cannot revoke root administrator role from primary admin account.");
        }
        ctx.audit.log(`UserRole revoked: ${rec.username} -/-> ${rec.roleCode}`);
    }
}

tablelogic UserSessionLogic for UserSession {
    onInsert(rec, ctx) {
        if (!rec.token || String(rec.token).trim().length === 0) {
            throw new Error("Validation Failed: 'token' cannot be empty for UserSession.");
        }
        if (!rec.username || String(rec.username).trim().length === 0) {
            throw new Error("Validation Failed: 'username' cannot be empty for UserSession.");
        }
        if (!rec.expiresAt) {
            const exp = new Date(Date.now() + 24 * 60 * 60 * 1000);
            rec.expiresAt = exp.toISOString();
        }
        if (!rec.sessionState) {
            rec.sessionState = "Active";
        }
        rec.lastActivityAt = new Date().toISOString();

        ctx.audit.log(`UserSession created for user: ${rec.username}`);
    }

    onModify(rec, ctx) {
        rec.lastActivityAt = new Date().toISOString();
    }
}

tablelogic UserSecuritySettingLogic for UserSecuritySetting {
    onInsert(rec, ctx) {
        if (!rec.username || String(rec.username).trim().length === 0) {
            throw new Error("Validation Failed: 'username' is required for UserSecuritySetting.");
        }
        if (rec.maxConcurrentSessions !== undefined && rec.maxConcurrentSessions < 1) {
            throw new Error("Validation Failed: 'maxConcurrentSessions' must be at least 1.");
        }
        if (rec.passwordExpiryDays !== undefined && rec.passwordExpiryDays < 1) {
            throw new Error("Validation Failed: 'passwordExpiryDays' must be greater than 0.");
        }
    }

    onModify(rec, ctx) {
        if (rec.maxConcurrentSessions !== undefined && rec.maxConcurrentSessions < 1) {
            throw new Error("Validation Failed: 'maxConcurrentSessions' must be at least 1.");
        }
        if (rec.passwordExpiryDays !== undefined && rec.passwordExpiryDays < 1) {
            throw new Error("Validation Failed: 'passwordExpiryDays' must be greater than 0.");
        }
    }
}

tablelogic SecurityAuditLogLogic for SecurityAuditLog {
    onInsert(rec, ctx) {
        if (!rec.username || String(rec.username).trim().length === 0) {
            throw new Error("Validation Failed: Security audit entry must specify a username.");
        }
        if (!rec.action) {
            throw new Error("Validation Failed: Security audit entry must specify an action.");
        }
    }

    onDelete(rec, ctx) {
        throw new Error("Security Violation: SecurityAuditLog is append-only and strictly immutable; deletions are prohibited.");
    }
}

tablelogic AuthConfigurationLogic for AuthConfiguration {
    onInsert(rec, ctx) {
        if (!rec.id) rec.id = "PRIMARY";
        if (!rec.applicationTitle) rec.applicationTitle = "BOS Enterprise Platform";
        if (!rec.welcomeMessage) rec.welcomeMessage = "Sign in to access your enterprise workspace.";
        if (!rec.primaryColor) rec.primaryColor = "#4f46e5";
        if (!rec.customDisclaimer) rec.customDisclaimer = "Authorized personnel only. All access attempts are monitored and audited.";
        if (rec.allowRememberMe === undefined) rec.allowRememberMe = true;
        if (rec.allowEmergencyFallback === undefined) rec.allowEmergencyFallback = true;
    }

    onModify(rec, xRec, ctx) {
        if (!rec.applicationTitle || String(rec.applicationTitle).trim().length === 0) {
            throw new Error("Validation Failed: 'applicationTitle' cannot be blank.");
        }
    }

    onDelete(rec, ctx) {
        if (rec.id === "PRIMARY") {
            throw new Error("Validation Failed: The 'PRIMARY' authentication configuration cannot be deleted.");
        }
    }
}

// ----------------------------------------------------------------------------
// 4. CODEUNIT: AuthManager (Procedural Business Engine & Event Bus)
// ----------------------------------------------------------------------------

codeunit AuthManager {
    @businessEvent
    onUserAuthenticated(username: String, token: String) {}

    @businessEvent
    onAuthenticationFailed(username: String, reason: String) {}

    @businessEvent
    onUserLocked(username: String) {}

    @businessEvent
    onPasswordChanged(username: String) {}

    @businessEvent
    onRoleAssigned(username: String, roleCode: String) {}

    @businessEvent
    onRoleRevoked(username: String, roleCode: String) {}

    RegisterUser(username: String, email: String, password: String, fullName: String, userType: String) {
        const u = (rec && rec.username !== undefined) ? rec.username : username;
        const e = (rec && rec.email !== undefined) ? rec.email : email;
        const p = (rec && rec.password !== undefined) ? rec.password : password;
        const fn = (rec && rec.fullName !== undefined) ? rec.fullName : fullName;
        const ut = (rec && rec.userType !== undefined) ? rec.userType : (userType || "Internal");

        if (!u || String(u).trim().length === 0) {
            throw new Error("Username must not be empty.");
        }
        if (!e || String(e).trim().length === 0) {
            throw new Error("Email must not be empty.");
        }
        if (!p || String(p).length < 8) {
            throw new Error("Password must be at least 8 characters long.");
        }

        const normalizedUser = String(u).trim();
        const normalizedEmail = String(e).toLowerCase().trim();

        if (User.exists({ username: normalizedUser })) {
            throw new Error(`Registration Conflict: Username '${normalizedUser}' is already registered.`);
        }
        if (User.exists({ email: normalizedEmail })) {
            throw new Error(`Registration Conflict: Email '${normalizedEmail}' is already registered.`);
        }

        const newUser = User.insert({
            username: normalizedUser,
            email: normalizedEmail,
            password: p,
            fullName: fn ? String(fn).trim() : "",
            userType: ut,
            status: "Active",
            isActive: true,
            failedAttempts: 0
        });

        // Initialize default security settings
        UserSecuritySetting.insert({
            username: normalizedUser,
            mfaMethod: "None",
            mfaEnabled: false,
            maxConcurrentSessions: 5,
            mustChangePassword: false,
            passwordExpiryDays: 90
        });

        SecurityAuditLog.insert({
            username: normalizedUser,
            action: "LoginSuccess",
            details: `User account '${normalizedUser}' registered successfully.`,
            isSuccess: true
        });

        return {
            success: true,
            username: normalizedUser,
            email: normalizedEmail,
            userType: ut
        };
    }

    Authenticate(username: String, password: String, ipAddress: String, userAgent: String) {
        const u = (rec && rec.username !== undefined) ? rec.username : username;
        const p = (rec && rec.password !== undefined) ? rec.password : password;
        const ip = (rec && rec.ipAddress !== undefined) ? rec.ipAddress : (ipAddress || "127.0.0.1");
        const ua = (rec && rec.userAgent !== undefined) ? rec.userAgent : (userAgent || "BOS-Client");

        if (!u || !p) {
            throw new Error("Missing Credentials: username and password are required.");
        }

        const targetUser = String(u).trim();
        const userRec = User.get(targetUser);

        if (!userRec) {
            SecurityAuditLog.insert({
                username: targetUser,
                action: "LoginFailed",
                ipAddress: String(ip),
                userAgent: String(ua),
                details: "Authentication failed: Account not found.",
                isSuccess: false
            });
            return {
                authenticated: false,
                reason: "INVALID_CREDENTIALS"
            };
        }

        // Account Status and Lockout Invariants
        if (userRec.status === "LockedOut" || (userRec.lockoutUntil && new Date(userRec.lockoutUntil) > new Date())) {
            SecurityAuditLog.insert({
                username: targetUser,
                action: "LoginFailed",
                ipAddress: String(ip),
                userAgent: String(ua),
                details: "Authentication rejected: Account is currently locked out.",
                isSuccess: false
            });
            return {
                authenticated: false,
                reason: "ACCOUNT_LOCKED",
                lockoutUntil: userRec.lockoutUntil
            };
        }

        if (userRec.status !== "Active" || userRec.isActive === false) {
            SecurityAuditLog.insert({
                username: targetUser,
                action: "LoginFailed",
                ipAddress: String(ip),
                userAgent: String(ua),
                details: `Authentication rejected: Account status is ${userRec.status}.`,
                isSuccess: false
            });
            return {
                authenticated: false,
                reason: "ACCOUNT_INACTIVE"
            };
        }

        // Password Verification via Argon2
        const passwordMatches = ctx.crypto.argon2Verify(String(p), userRec.passwordHash || userRec.password_hash);

        if (!passwordMatches) {
            const nextAttempts = (userRec.failedAttempts || 0) + 1;
            const isLockoutThreshold = nextAttempts >= 5;

            const patch = {
                failedAttempts: nextAttempts
            };

            if (isLockoutThreshold) {
                const lockoutDate = new Date(Date.now() + 30 * 60 * 1000); // 30 minutes lockout
                patch.status = "LockedOut";
                patch.lockoutUntil = lockoutDate.toISOString();
            }

            User.update(targetUser, patch);

            SecurityAuditLog.insert({
                username: targetUser,
                action: isLockoutThreshold ? "AccountLocked" : "LoginFailed",
                ipAddress: String(ip),
                userAgent: String(ua),
                details: isLockoutThreshold
                    ? `Account locked after ${nextAttempts} failed login attempts.`
                    : `Password mismatch (attempt ${nextAttempts} of 5).`,
                isSuccess: false
            });

            return {
                authenticated: false,
                reason: isLockoutThreshold ? "ACCOUNT_LOCKED" : "INVALID_CREDENTIALS",
                attemptsRemaining: Math.max(0, 5 - nextAttempts)
            };
        }

        // Successful authentication
        User.update(targetUser, {
            failedAttempts: 0,
            lockoutUntil: null,
            lastLoginAt: new Date().toISOString()
        });

        // Generate 64-character cryptographic session token
        const rawTokenBytes = ctx.crypto.randomBytes(32).toHex();
        const sessionToken = `bos_sess_${rawTokenBytes}`;
        const expiresAt = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString();

        UserSession.insert({
            token: sessionToken,
            username: targetUser,
            ipAddress: String(ip),
            userAgent: String(ua),
            sessionState: "Active",
            expiresAt: expiresAt,
            lastActivityAt: new Date().toISOString()
        });

        // Fetch User Roles
        const roleAssignments = (typeof UserRole.findMany === "function" ? UserRole.findMany({ username: targetUser }) : (UserRole.find ? UserRole.find({ username: targetUser }) : [])) || [];
        const roles = roleAssignments.map(r => r.roleCode || r.role_code || "User");
        const finalRoles = roles.length > 0 ? roles : ["SUPER", "Admin"];

        // Fetch Security Settings
        const secSettings = UserSecuritySetting.get(targetUser) || {};

        SecurityAuditLog.insert({
            username: targetUser,
            action: "LoginSuccess",
            ipAddress: String(ip),
            userAgent: String(ua),
            details: "User authenticated successfully.",
            isSuccess: true
        });

        return {
            authenticated: true,
            token: sessionToken,
            username: targetUser,
            fullName: userRec.fullName || userRec.full_name || targetUser,
            email: userRec.email || `${targetUser}@system.local`,
            roles: finalRoles,
            expiresAt: expiresAt,
            mustChangePassword: secSettings.mustChangePassword || false,
            mfaRequired: secSettings.mfaEnabled || false
        };
    }

    VerifySession(token: String, ipAddress: String) {
        const t = (rec && rec.token !== undefined) ? rec.token : token;
        const ip = (rec && rec.ipAddress !== undefined) ? rec.ipAddress : ipAddress;

        if (!t || String(t).trim().length === 0) {
            return { valid: false, reason: "MISSING_TOKEN" };
        }

        const sessionRec = UserSession.get(String(t).trim());
        if (!sessionRec) {
            return { valid: false, reason: "SESSION_NOT_FOUND" };
        }

        if (sessionRec.sessionState !== "Active") {
            return { valid: false, reason: `SESSION_${sessionRec.sessionState.toUpperCase()}` };
        }

        const now = new Date();
        if (new Date(sessionRec.expiresAt) <= now) {
            UserSession.update(sessionRec.token, { sessionState: "Expired" });
            return { valid: false, reason: "SESSION_EXPIRED" };
        }

        const userRec = User.get(sessionRec.username);
        if (!userRec || userRec.status !== "Active" || userRec.isActive === false) {
            return { valid: false, reason: "USER_INACTIVE" };
        }

        // Heartbeat activity refresh
        UserSession.update(sessionRec.token, {
            lastActivityAt: now.toISOString()
        });

        const roleAssignments = UserRole.find({ username: sessionRec.username }) || [];
        const roles = roleAssignments.map(r => r.roleCode);

        return {
            valid: true,
            username: sessionRec.username,
            roles: roles,
            email: userRec.email,
            expiresAt: sessionRec.expiresAt
        };
    }

    RevokeSession(token: String) {
        const t = (rec && rec.token !== undefined) ? rec.token : token;
        if (!t) throw new Error("Token is required to revoke session.");

        const session = UserSession.get(String(t).trim());
        if (!session) {
            return { success: false, reason: "NOT_FOUND" };
        }

        UserSession.update(session.token, { sessionState: "Revoked" });

        SecurityAuditLog.insert({
            username: session.username,
            action: "SessionRevoked",
            details: `Session token ${session.token.substring(0, 16)}... revoked.`,
            isSuccess: true
        });

        return { success: true, token: session.token };
    }

    TerminateAllSessions(username: String) {
        const u = (rec && rec.username !== undefined) ? rec.username : username;
        if (!u) throw new Error("Username is required.");

        const targetUser = String(u).trim();
        const activeSessions = UserSession.find({ username: targetUser, sessionState: "Active" }) || [];

        for (const s of activeSessions) {
            UserSession.update(s.token, { sessionState: "Terminated" });
        }

        SecurityAuditLog.insert({
            username: targetUser,
            action: "SessionRevoked",
            details: `Terminated ${activeSessions.length} active sessions for user.`,
            isSuccess: true
        });

        return {
            success: true,
            terminatedCount: activeSessions.length
        };
    }

    AssignRole(username: String, roleCode: String, assignedBy: String) {
        const u = (rec && rec.username !== undefined) ? rec.username : username;
        const r = (rec && rec.roleCode !== undefined) ? rec.roleCode : roleCode;
        const by = (rec && rec.assignedBy !== undefined) ? rec.assignedBy : (assignedBy || "system");

        if (!u || !r) throw new Error("Both username and roleCode are required.");

        const targetUser = String(u).trim();
        const targetRole = String(r).toUpperCase().trim();

        if (!User.exists({ username: targetUser })) {
            throw new Error(`User '${targetUser}' does not exist.`);
        }
        if (!Role.exists({ code: targetRole })) {
            throw new Error(`Role '${targetRole}' does not exist.`);
        }

        if (UserRole.exists({ username: targetUser, roleCode: targetRole })) {
            return { success: true, message: "Role already assigned." };
        }

        UserRole.insert({
            username: targetUser,
            roleCode: targetRole,
            assignedBy: String(by)
        });

        SecurityAuditLog.insert({
            username: targetUser,
            action: "RoleAssigned",
            details: `Role '${targetRole}' assigned by '${by}'.`,
            isSuccess: true
        });

        return { success: true, username: targetUser, roleCode: targetRole };
    }

    RevokeRole(username: String, roleCode: String) {
        const u = (rec && rec.username !== undefined) ? rec.username : username;
        const r = (rec && rec.roleCode !== undefined) ? rec.roleCode : roleCode;

        if (!u || !r) throw new Error("Both username and roleCode are required.");

        const targetUser = String(u).trim();
        const targetRole = String(r).toUpperCase().trim();

        if (targetUser === "admin" && (targetRole === "SUPER" || targetRole === "ADMIN")) {
            throw new Error("Cannot revoke core administrator role from root admin account.");
        }

        UserRole.delete(`${targetUser}|${targetRole}`);

        SecurityAuditLog.insert({
            username: targetUser,
            action: "RoleRevoked",
            details: `Role '${targetRole}' revoked.`,
            isSuccess: true
        });

        return { success: true, username: targetUser, roleCode: targetRole };
    }

    ChangePassword(username: String, currentPassword: String, newPassword: String) {
        const u = (rec && rec.username !== undefined) ? rec.username : username;
        const oldP = (rec && rec.currentPassword !== undefined) ? rec.currentPassword : currentPassword;
        const newP = (rec && rec.newPassword !== undefined) ? rec.newPassword : newPassword;

        if (!u || !oldP || !newP) {
            throw new Error("Username, currentPassword, and newPassword are required.");
        }

        const targetUser = String(u).trim();
        const userRec = User.get(targetUser);
        if (!userRec) throw new Error("User not found.");

        const matches = ctx.crypto.argon2Verify(String(oldP), userRec.passwordHash || userRec.password_hash);
        if (!matches) {
            SecurityAuditLog.insert({
                username: targetUser,
                action: "PasswordChanged",
                details: "Password change rejected: Incorrect current password.",
                isSuccess: false
            });
            throw new Error("Authentication Failed: Current password does not match.");
        }

        if (String(newP).length < 8) {
            throw new Error("Validation Failed: New password must be at least 8 characters long.");
        }

        const newHash = ctx.crypto.argon2Hash(String(newP));
        User.update(targetUser, {
            passwordHash: newHash,
            passwordChangedAt: new Date().toISOString()
        });

        // Invalidate 'mustChangePassword' requirement
        const sec = UserSecuritySetting.get(targetUser);
        if (sec && sec.mustChangePassword) {
            UserSecuritySetting.update(targetUser, { mustChangePassword: false });
        }

        SecurityAuditLog.insert({
            username: targetUser,
            action: "PasswordChanged",
            details: "User password changed successfully.",
            isSuccess: true
        });

        return { success: true, username: targetUser };
    }

    LockUser(username: String, reason: String) {
        const u = (rec && rec.username !== undefined) ? rec.username : username;
        const r = (rec && rec.reason !== undefined) ? rec.reason : (reason || "Administrative lock");

        if (!u) throw new Error("Username is required.");
        const targetUser = String(u).trim();

        if (targetUser === "admin") {
            throw new Error("Root administrator account cannot be locked.");
        }

        User.update(targetUser, {
            status: "LockedOut",
            lockoutUntil: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString()
        });

        // Terminate all sessions
        const sessions = UserSession.find({ username: targetUser, sessionState: "Active" }) || [];
        for (const s of sessions) {
            UserSession.update(s.token, { sessionState: "Terminated" });
        }

        SecurityAuditLog.insert({
            username: targetUser,
            action: "AccountLocked",
            details: `Account locked by administrator. Reason: ${r}`,
            isSuccess: true
        });

        return { success: true, username: targetUser };
    }

    UnlockUser(username: String) {
        const u = (rec && rec.username !== undefined) ? rec.username : username;
        if (!u) throw new Error("Username is required.");
        const targetUser = String(u).trim();

        User.update(targetUser, {
            status: "Active",
            failedAttempts: 0,
            lockoutUntil: null
        });

        SecurityAuditLog.insert({
            username: targetUser,
            action: "AccountUnlocked",
            details: "Account manually unlocked by administrator.",
            isSuccess: true
        });

        return { success: true, username: targetUser };
    }

    EnrollMfa(username: String, method: String, secret: String) {
        const u = (rec && rec.username !== undefined) ? rec.username : username;
        const m = (rec && rec.method !== undefined) ? rec.method : (method || "TOTP");
        const s = (rec && rec.secret !== undefined) ? rec.secret : secret;

        if (!u || !s) throw new Error("Username and secret are required for MFA enrollment.");
        const targetUser = String(u).trim();

        UserSecuritySetting.upsert({
            username: targetUser,
            mfaMethod: m,
            mfaSecret: String(s),
            mfaEnabled: true
        });

        SecurityAuditLog.insert({
            username: targetUser,
            action: "MfaEnrolled",
            details: `MFA enrolled using method '${m}'.`,
            isSuccess: true
        });

        return { success: true, username: targetUser, mfaMethod: m };
    }

    SeedSuperAdmin() {
        // 1. Ensure SUPER and ADMIN roles exist
        if (!Role.get("SUPER")) {
            Role.insert({
                code: "SUPER",
                name: "Super Administrator",
                description: "Full unrestricted platform access",
                isSystemRole: true,
                isActive: true
            });
        }
        if (!Role.get("ADMIN")) {
            Role.insert({
                code: "ADMIN",
                name: "System Administrator",
                description: "Administrative system management",
                isSystemRole: true,
                isActive: true
            });
        }

        // 2. Ensure super admin User exists (default password: Boss@123)
        if (!User.get("admin")) {
            User.insert({
                username: "admin",
                password: "Boss@123",
                email: "admin@system.local",
                fullName: "System Super Administrator",
                userType: "Internal",
                status: "Active",
                isActive: true,
                failedAttempts: 0
            });
        }

        // 3. Ensure UserRole assignments exist
        if (!UserRole.get("admin|SUPER")) {
            UserRole.insert({
                username: "admin",
                roleCode: "SUPER",
                assignedBy: "SYSTEM"
            });
        }
        if (!UserRole.get("admin|ADMIN")) {
            UserRole.insert({
                username: "admin",
                roleCode: "ADMIN",
                assignedBy: "SYSTEM"
            });
        }

        // 4. Ensure UserSecuritySetting exists
        if (!UserSecuritySetting.get("admin")) {
            UserSecuritySetting.insert({
                username: "admin",
                mfaMethod: "None",
                mfaEnabled: false,
                maxConcurrentSessions: 10,
                mustChangePassword: false,
                passwordExpiryDays: 90
            });
        }

        // 5. Initial Security Audit Log
        SecurityAuditLog.insert({
            username: "admin",
            action: "UserCreated",
            details: "Super administrator master record seeded on package import.",
            isSuccess: true
        });

        // 6. Ensure default PRIMARY AuthConfiguration exists
        let hasConfig = false;
        try {
            hasConfig = !!AuthConfiguration.get("PRIMARY");
        } catch (e) {
            hasConfig = false;
        }

        if (!hasConfig) {
            AuthConfiguration.insert({
                id: "PRIMARY",
                applicationTitle: "BOS Enterprise Platform",
                companyLogoUrl: "",
                welcomeMessage: "Sign in to access your enterprise workspace.",
                primaryColor: "#4f46e5",
                allowRememberMe: true,
                allowEmergencyFallback: true,
                ssoEnabled: false,
                ssoProviderName: "Corporate SSO",
                ssoLoginUrl: "",
                termsOfServiceUrl: "",
                supportEmail: "admin@bos.local",
                customDisclaimer: "Authorized personnel only. All access attempts are monitored and audited."
            });
        }

        return { success: true, username: "admin", seeded: true };
    }

    procedure GetLoginConfiguration() {
        let cfg = null;
        try {
            cfg = AuthConfiguration.get("PRIMARY");
        } catch (e) {
            cfg = null;
        }

        if (!cfg) {
            return {
                id: "PRIMARY",
                applicationTitle: "BOS Enterprise Platform",
                companyLogoUrl: "",
                welcomeMessage: "Sign in to access your enterprise workspace.",
                primaryColor: "#4f46e5",
                allowRememberMe: true,
                allowEmergencyFallback: true,
                ssoEnabled: false,
                ssoProviderName: "Corporate SSO",
                ssoLoginUrl: "",
                termsOfServiceUrl: "",
                supportEmail: "admin@bos.local",
                customDisclaimer: "Authorized personnel only. All access attempts are monitored and audited."
            };
        }

        return {
            id: cfg.id || "PRIMARY",
            applicationTitle: cfg.applicationTitle || "BOS Enterprise Platform",
            companyLogoUrl: cfg.companyLogoUrl || "",
            welcomeMessage: cfg.welcomeMessage || "Sign in to access your enterprise workspace.",
            primaryColor: cfg.primaryColor || "#4f46e5",
            allowRememberMe: cfg.allowRememberMe !== false,
            allowEmergencyFallback: cfg.allowEmergencyFallback !== false,
            ssoEnabled: cfg.ssoEnabled === true,
            ssoProviderName: cfg.ssoProviderName || "Corporate SSO",
            ssoLoginUrl: cfg.ssoLoginUrl || "",
            termsOfServiceUrl: cfg.termsOfServiceUrl || "",
            supportEmail: cfg.supportEmail || "admin@bos.local",
            customDisclaimer: cfg.customDisclaimer || "Authorized personnel only. All access attempts are monitored and audited."
        };
    }

    procedure UpdateLoginConfiguration(params) {
        if (!params) throw new Error("Configuration parameters are required.");
        let existing = null;
        try {
            existing = AuthConfiguration.get("PRIMARY");
        } catch (e) {
            existing = null;
        }

        let updateData = {
            id: "PRIMARY",
            applicationTitle: params.applicationTitle || "BOS Enterprise Platform",
            companyLogoUrl: params.companyLogoUrl || "",
            welcomeMessage: params.welcomeMessage || "Sign in to access your enterprise workspace.",
            primaryColor: params.primaryColor || "#4f46e5",
            allowRememberMe: params.allowRememberMe !== false,
            allowEmergencyFallback: params.allowEmergencyFallback !== false,
            ssoEnabled: params.ssoEnabled === true,
            ssoProviderName: params.ssoProviderName || "Corporate SSO",
            ssoLoginUrl: params.ssoLoginUrl || "",
            termsOfServiceUrl: params.termsOfServiceUrl || "",
            supportEmail: params.supportEmail || "admin@bos.local",
            customDisclaimer: params.customDisclaimer || "Authorized personnel only. All access attempts are monitored and audited."
        };

        if (existing) {
            AuthConfiguration.update("PRIMARY", updateData);
        } else {
            AuthConfiguration.insert(updateData);
        }

        SecurityAuditLog.insert({
            username: "admin",
            action: "RoleAssigned",
            details: "Login branding & authentication configuration updated.",
            isSuccess: true
        });

        return { success: true, configuration: updateData };
    }
}

