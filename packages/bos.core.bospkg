    {
      "actions": [
        {
          "caption": "Forgot Password?",
          "confirm": null,
          "enable_when": null,
          "icon": "KeyRound",
          "in_footer_bar": true,
          "name": "ForgotPassword",
          "open_page": null,
          "primary": false,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nconst u = vars.username || (rec && rec.username);\nif (!u) {\n    ctx.ui.notify(\"info\", \"Please enter your User ID first, then click 'Forgot Password?' to request reset instructions.\");\n    return { requested: false };\n}\nconst res = ctx.call(\"AuthManager\", \"RequestPasswordReset\", { username: u });\nconst msg = (res && res.message) ? res.message : `Password reset instructions dispatched for '${u}'.`;\nctx.ui.notify(\"success\", msg);\nreturn { requested: true, message: msg };",
          "selection": null,
          "shortcut": null,
          "show_when": null
        },
        {
          "caption": "Sign In",
          "confirm": null,
          "enable_when": null,
          "icon": "LogIn",
          "in_footer_bar": true,
          "name": "SignIn",
          "open_page": null,
          "primary": true,
          "run_codeunit": null,
          "script": "const vars = (ctx.page && ctx.page.variables) || {};\nconst u = vars.username || (rec && rec.username);\nconst p = vars.password || (rec && rec.password);\nif (!u) throw new Error(\"Please enter your User ID.\");\nif (!p) throw new Error(\"Please enter your password.\");\nconst res = ctx.call(\"AuthManager\", \"Authenticate\", { username: u, password: p });\nif (!res || !res.authenticated) {\n    throw new Error((res && res.reason === \"ACCOUNT_LOCKED\") ? \"Account is locked due to too many failed attempts.\" : ((res && res.reason) || \"Invalid User ID or Password.\"));\n}\nreturn res;",
          "selection": null,
          "shortcut": null,
          "show_when": null
        }
      ],
      "caption": "Sign In",
      "controls": [
        {
          "caption": null,
          "children": [
            {
              "caption": null,
              "children": [],
              "kind": "field",
              "name": "username",
              "properties": {
                "required": "true"
              },
              "source_expr": "username"
            },
            {
              "caption": null,
              "children": [],
              "kind": "field",
              "name": "password",
              "properties": {
                "required": "true"
              },
              "source_expr": "password"
            }
          ],
          "kind": "area",
          "name": "Content",
          "properties": {},
          "source_expr": null
        }
      ],
      "delete_allowed": false,
      "editable": false,
      "filters": [],
