          ],
          "script": "if (!rec.groupCode || !rec.username) {\n    throw new Error(\"Validation Failed: 'groupCode' and 'username' are required.\");\n}\nrec.groupCode = String(rec.groupCode).toUpperCase().trim();\nrec.username = String(rec.username).trim();"
        }
      ],
      "version": "1.0.0",
