        "description": "Global & shortcut dimensions, dimension sets & combinations"
      },
      {
        "id": "LoginTemplates",
        "name": "Login Experience Templates",
        "description": "Responsive enterprise login templates: Split Hero, Glassmorphism, Multi-Tenant Domain"
      }
