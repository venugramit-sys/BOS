        {
          "actions": [],
          "annotations": [
            "businessEvent"
          ],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "onCoreSetupModified",
          "params": [
            [
              "modifiedBy",
              "String"
            ]
          ],
          "return_type": null,
