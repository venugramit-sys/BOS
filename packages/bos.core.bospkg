      "max_fuel": 100000,
      "methods": [
        {
          "actions": [],
          "annotations": [
            "businessEvent"
          ],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "onUserGroupAssigned",
          "params": [
            [
              "username",
              "String"
            ],
            [
              "groupCode",
              "String"
            ]
          ],
          "return_type": null,
          "script": "",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "AssignUserToGroup",
          "params": [
            [
              "username",
              "String"
            ],
            [
              "groupCode",
              "String"
            ],
            [
              "assignedBy",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nconst g = (rec && rec.groupCode !== undefined) ? rec.groupCode : groupCode;\nconst by = (rec && rec.assignedBy !== undefined) ? rec.assignedBy : (assignedBy || \"system\");\n\nif (!u || !g) throw new Error(\"Both username and groupCode are required.\");\nconst cleanUser = String(u).trim();\nconst cleanGroup = String(g).toUpperCase().trim();\n\nconst group = UserGroup.get(cleanGroup);\nif (!group) throw new Error(`UserGroup '${cleanGroup}' does not exist.`);\n\nconst key = `${cleanGroup}|${cleanUser}`;\nif (!UserGroupMember.get(key)) {\n    UserGroupMember.insert({\n        groupCode: cleanGroup,\n        username: cleanUser,\n        assignedBy: by\n    });\n}\n\n// If the group has a default role, automatically map it\nif (group.defaultRoleCode) {\n    const roleKey = `${cleanUser}|${group.defaultRoleCode}`;\n    if (!UserRole.get(roleKey)) {\n        UserRole.insert({\n            username: cleanUser,\n            roleCode: group.defaultRoleCode,\n            assignedBy: by\n        });\n    }\n}\n\nreturn { success: true, username: cleanUser, groupCode: cleanGroup };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "GetUserProfile",
          "params": [
            [
              "username",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nif (!u) throw new Error(\"Username is required.\");\nconst cleanUser = String(u).trim();\n\nconst userRec = User.get(cleanUser);\nif (!userRec) throw new Error(`User '${cleanUser}' not found.`);\n\nconst roleAssignments = UserRole.find({ username: cleanUser }) || [];\nconst roles = roleAssignments.map(r => r.roleCode);\n\nconst groupMemberships = UserGroupMember.find({ username: cleanUser }) || [];\nconst groups = groupMemberships.map(m => m.groupCode);\n\nconst personalization = UserPersonalization.get(cleanUser) || {};\nconst security = UserSecuritySetting.get(cleanUser) || {};\n\nreturn {\n    username: cleanUser,\n    email: userRec.email,\n    fullName: userRec.fullName,\n    userType: userRec.userType,\n    status: userRec.status,\n    roles: roles,\n    groups: groups,\n    personalization: personalization,\n    mfaEnabled: security.mfaEnabled || false\n};",
          "trigger_event": null
        }
      ],
      "name": "UserManager",
      "object_type": "codeunit",
      "package_name": "bos.core",
      "version": "1.0.0",
      "feature": "UserManagement"
    },
