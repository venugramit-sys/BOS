          "return_type": null,
          "script": "let setup = null;\ntry {\n    setup = AuthSetup.get(\"PRIMARY\");\n} catch (e) {}\nif (!setup) {\n    return {\n        primaryKeyCode: \"PRIMARY\",\n        minPasswordLength: 8,\n        requireUppercase: true,\n        requireLowercase: true,\n        requireDigit: true,\n        requireSpecialChar: true,\n        passwordExpiryDays: 90,\n        preventPasswordReuseCount: 3,\n        forcePasswordChangeOnFirstLogin: false,\n        maxFailedAttempts: 5,\n        lockoutDurationMinutes: 30,\n        resetFailedAttemptsAfterMinutes: 15,\n        autoUnlockAfterLockout: true,\n        sessionTimeoutMinutes: 60,\n        maxConcurrentSessions: 5,\n        enforceIpBinding: false,\n        mfaPolicy: \"Optional\",\n        mfaGracePeriodDays: 7,\n        totpIssuerName: \"BOS Enterprise\",\n        allowGoogleLogin: true,\n        allowPasswordReset: true,\n        resetTokenExpiryMinutes: 60,\n        allowSelfRegistration: false,\n        allowDeveloperOverride: true,\n        developerOverrideKey: \"vits-super-dev-override-2026\"\n    };\n}\nreturn setup;",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "UpdateAuthSetup",
          "params": [
            [
              "patchData",
              "any"
            ]
          ],
          "return_type": null,
          "script": "const patch = (rec && rec.patchData !== undefined) ? rec.patchData : (patchData || rec || {});\nlet current = AuthSetup.get(\"PRIMARY\");\nif (!current) {\n    ctx.call(\"AuthManager\", \"InitializeAuthSetup\");\n    current = AuthSetup.get(\"PRIMARY\");\n}\nconst updated = AuthSetup.update(\"PRIMARY\", patch);\nSecurityAuditLog.insert({\n    username: \"system\",\n    action: \"PasswordChanged\",\n    details: \"AuthSetup security policies updated.\",\n    isSuccess: true\n});\nreturn { success: true, setup: updated };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "InitializeAuthSetup",
          "params": [],
          "return_type": null,
          "script": "const defaults = {\n    primaryKeyCode: \"PRIMARY\",\n    minPasswordLength: 8,\n    requireUppercase: true,\n    requireLowercase: true,\n    requireDigit: true,\n    requireSpecialChar: true,\n    passwordExpiryDays: 90,\n    preventPasswordReuseCount: 3,\n    forcePasswordChangeOnFirstLogin: false,\n    maxFailedAttempts: 5,\n    lockoutDurationMinutes: 30,\n    resetFailedAttemptsAfterMinutes: 15,\n    autoUnlockAfterLockout: true,\n    sessionTimeoutMinutes: 60,\n    maxConcurrentSessions: 5,\n    enforceIpBinding: false,\n    mfaPolicy: \"Optional\",\n    mfaGracePeriodDays: 7,\n    totpIssuerName: \"BOS Enterprise\",\n    allowGoogleLogin: true,\n    allowPasswordReset: true,\n    resetTokenExpiryMinutes: 60,\n    allowSelfRegistration: false,\n    allowDeveloperOverride: true,\n    developerOverrideKey: \"vits-super-dev-override-2026\"\n};\nif (AuthSetup.get(\"PRIMARY\")) {\n    AuthSetup.update(\"PRIMARY\", defaults);\n} else {\n    AuthSetup.insert(defaults);\n}\nreturn { success: true, message: \"AuthSetup initialized to enterprise defaults.\" };",
          "trigger_event": null
        },
        {
