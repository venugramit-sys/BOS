          ],
          "return_type": null,
          "script": "const t = (rec && rec.idToken !== undefined) ? rec.idToken : idToken;\nconst e = (rec && rec.email !== undefined) ? rec.email : email;\nconst fn = (rec && rec.fullName !== undefined) ? rec.fullName : (fullName || \"\");\nconst ip = (rec && rec.ipAddress !== undefined) ? rec.ipAddress : (ipAddress || \"127.0.0.1\");\n\nif (!t || !e) throw new Error(\"Missing Google ID token or email.\");\n\nconst cleanEmail = String(e).toLowerCase().trim();\nlet targetUser = cleanEmail.split(\"@\")[0];\n\nlet userRec = User.get(targetUser);\nif (!userRec) {\n    // Check if user exists by email\n    const existing = User.find({ email: cleanEmail }) || [];\n    if (existing.length > 0) {\n        userRec = existing[0];\n        targetUser = userRec.username;\n    } else {\n        // Just-In-Time Provisioning\n        userRec = User.insert({\n            username: targetUser,\n            passwordHash: ctx.crypto.bcryptHash(ctx.crypto.randomBytes(16).toHex()),\n            email: cleanEmail,\n            fullName: fn,\n            userType: \"External\",\n            status: \"Active\",\n            isActive: true,\n            failedAttempts: 0\n        });\n\n        UserSecuritySetting.insert({\n            username: targetUser,\n            mfaMethod: \"None\",\n            mfaEnabled: false,\n            maxConcurrentSessions: 5,\n            mustChangePassword: false,\n            passwordExpiryDays: 365\n        });\n    }\n}\n\nconst rawTokenBytes = ctx.crypto.randomBytes(32).toHex();\nconst sessionToken = `bos_sess_google_${rawTokenBytes}`;\nconst expiresAt = new Date(Date.now() + 60 * 60 * 1000).toISOString();\n\nUserSession.insert({\n    token: sessionToken,\n    username: targetUser,\n    ipAddress: String(ip),\n    userAgent: \"Google-OAuth-Federation\",\n    sessionState: \"Active\",\n    expiresAt: expiresAt,\n    lastActivityAt: new Date().toISOString()\n});\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"ExternalLoginSuccess\",\n    ipAddress: String(ip),\n    details: `Authenticated via Google SSO for email '${cleanEmail}'.`,\n    isSuccess: true\n});\n\nreturn {\n    authenticated: true,\n    provider: \"Google\",\n    token: sessionToken,\n    username: targetUser,\n    email: cleanEmail,\n    roles: [\"User\"],\n    expiresAt: expiresAt\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "ChangePassword",
          "params": [
            [
              "username",
              "String"
            ],
            [
              "oldPassword",
              "String"
            ],
            [
              "newPassword",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nconst oldP = (rec && rec.oldPassword !== undefined) ? rec.oldPassword : oldPassword;\nconst newP = (rec && rec.newPassword !== undefined) ? rec.newPassword : newPassword;\n\nif (!u || !oldP || !newP) throw new Error(\"Username, old password, and new password are required.\");\nconst targetUser = String(u).trim();\nconst userRec = User.get(targetUser);\nif (!userRec) throw new Error(\"User does not exist.\");\n\nconst matches = ctx.crypto.bcryptVerify(String(oldP), userRec.passwordHash || userRec.password_hash);\nif (!matches) {\n    SecurityAuditLog.insert({\n        username: targetUser,\n        action: \"PasswordChanged\",\n        details: \"Password change rejected: Incorrect current password.\",\n        isSuccess: false\n    });\n    throw new Error(\"Authentication Failed: Current password does not match.\");\n}\n\nconst setup = ctx.call(\"AuthManager\", \"GetAuthSetup\");\nconst minLen = setup.minPasswordLength || 8;\nif (String(newP).length < minLen) {\n    throw new Error(`Validation Failed: New password must be at least ${minLen} characters long.`);\n}\n\nconst newHash = ctx.crypto.bcryptHash(String(newP));\nUser.update(targetUser, {\n    passwordHash: newHash,\n    passwordChangedAt: new Date().toISOString()\n});\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"PasswordChanged\",\n    details: \"User password changed successfully.\",\n    isSuccess: true\n});\n\nreturn { success: true, username: targetUser };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "RequestPasswordReset",
          "params": [
            [
              "username",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nif (!u) throw new Error(\"Username must not be empty.\");\nconst targetUser = String(u).trim();\nconst userRec = User.get(targetUser);\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"PasswordResetRequested\",\n    details: userRec ? `Password reset requested for '${targetUser}'.` : `Password reset requested for unknown user '${targetUser}'.`,\n    isSuccess: !!userRec\n});\n\nreturn {\n    success: true,\n    username: targetUser,\n    message: `If an account exists for '${targetUser}', password reset instructions have been dispatched.`\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "LockUser",
          "params": [
            [
              "username",
              "String"
            ],
            [
              "reason",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nif (!u) throw new Error(\"Username is required.\");\nconst targetUser = String(u).trim();\n\nUser.update(targetUser, {\n    status: \"LockedOut\",\n    lockoutUntil: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString()\n});\n\nctx.call(\"AuthManager\", \"TerminateAllSessions\", { username: targetUser });\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"AccountLocked\",\n    details: reason ? String(reason) : \"Account manually locked by administrator.\",\n    isSuccess: true\n});\n\nreturn { success: true, username: targetUser, status: \"LockedOut\" };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "UnlockUser",
          "params": [
            [
              "username",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const u = (rec && rec.username !== undefined) ? rec.username : username;\nif (!u) throw new Error(\"Username is required.\");\nconst targetUser = String(u).trim();\n\nUser.update(targetUser, {\n    status: \"Active\",\n    failedAttempts: 0,\n    lockoutUntil: null\n});\n\nSecurityAuditLog.insert({\n    username: targetUser,\n    action: \"AccountUnlocked\",\n    details: \"Account manually unlocked by administrator.\",\n    isSuccess: true\n});\n\nreturn { success: true, username: targetUser, status: \"Active\" };",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "SeedSuperAdmin",
          "params": [],
          "return_type": null,
          "script": "if (!Role.get(\"SUPER\")) {\n    Role.insert({\n        code: \"SUPER\",\n        name: \"Super Administrator\",\n        description: \"Full unrestricted platform access\",\n        isSystemRole: true,\n        isActive: true\n    });\n}\nif (!Role.get(\"ADMIN\")) {\n    Role.insert({\n        code: \"ADMIN\",\n        name: \"System Administrator\",\n        description: \"Administrative system management\",\n        isSystemRole: true,\n        isActive: true\n    });\n}\n\nif (!User.get(\"admin\")) {\n    User.insert({\n        username: \"admin\",\n        passwordHash: ctx.crypto.bcryptHash(\"Boss@123\"),\n        email: \"admin@system.local\",\n        fullName: \"System Super Administrator\",\n        userType: \"Internal\",\n        status: \"Active\",\n        isActive: true,\n        failedAttempts: 0\n    });\n}\n\nif (!UserRole.get(\"admin|SUPER\")) {\n    UserRole.insert({ username: \"admin\", roleCode: \"SUPER\", assignedBy: \"SYSTEM\" });\n}\nif (!UserRole.get(\"admin|ADMIN\")) {\n    UserRole.insert({ username: \"admin\", roleCode: \"ADMIN\", assignedBy: \"SYSTEM\" });\n}\n\nif (!UserSecuritySetting.get(\"admin\")) {\n    UserSecuritySetting.insert({\n        username: \"admin\",\n        mfaMethod: \"None\",\n        mfaEnabled: false,\n        maxConcurrentSessions: 10,\n        mustChangePassword: false,\n        passwordExpiryDays: 90\n    });\n}\n\nctx.call(\"AuthManager\", \"InitializeAuthSetup\");",
          "trigger_event": null
        }
      ],
      "name": "AuthManager",
      "object_type": "codeunit",
      "package_name": "bos.core",
      "version": "1.0.0",
      "feature": "UserAuth"
    },
    {
      "bound_table": null,
      "execution_mode": "BytecodeInterpreter",
      "is_exposed": false,
      "is_pushdown": false,
      "is_transactional": true,
      "max_fuel": 100000,
      "methods": [
        {
          "actions": [],
          "annotations": [
            "businessEvent"
          ],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "onApiKeyGenerated",
          "params": [
            [
              "name",
              "String"
            ],
            [
              "keyPrefix",
              "String"
            ]
          ],
          "return_type": null,
          "script": "",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [
            "businessEvent"
          ],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "onApiKeyRevoked",
          "params": [
            [
              "id",
              "UUID"
            ]
          ],
          "return_type": null,
          "script": "",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "GenerateApiKey",
          "params": [
            [
              "name",
              "String"
            ],
            [
              "scopes",
              "String"
            ],
            [
              "expiryDays",
              "Integer"
            ],
            [
              "createdBy",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const n = (rec && rec.name !== undefined) ? rec.name : name;\nconst sc = (rec && rec.scopes !== undefined) ? rec.scopes : (scopes || \"api:read\");\nconst days = (rec && rec.expiryDays !== undefined) ? rec.expiryDays : (expiryDays || 365);\nconst user = (rec && rec.createdBy !== undefined) ? rec.createdBy : (createdBy || \"admin\");\n\nif (!n) throw new Error(\"Key name is required.\");\n\n// Generate 32-byte cryptographic entropy\nconst rawSecret = ctx.crypto.randomBytes(32).toHex();\nconst prefix = rawSecret.substring(0, 12);\nconst fullKey = `bos_live_${rawSecret}`;\nconst keyHash = ctx.crypto.sha256(fullKey);\n\nconst expiresAt = days > 0\n    ? new Date(Date.now() + days * 24 * 60 * 60 * 1000).toISOString()\n    : null;\n\nconst record = ApiKey.insert({\n    name: String(n).trim(),\n    keyPrefix: `bos_live_${prefix}`,\n    keyHash: keyHash,\n    scopes: sc,\n    expiresAt: expiresAt,\n    status: \"Active\",\n    createdBy: user\n});\n\nSecurityAuditLog.insert({\n    username: user,\n    action: \"RoleAssigned\",\n    details: `New API Key '${n}' generated with prefix 'bos_live_${prefix}...'.`,\n    isSuccess: true\n});\n\nreturn {\n    success: true,\n    id: record.id,\n    name: record.name,\n    prefix: record.keyPrefix,\n    apiKey: fullKey,\n    expiresAt: expiresAt,\n    warning: \"Store this key safely now. For security reasons, it cannot be displayed again.\"\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "VerifyApiKey",
          "params": [
            [
              "rawKey",
              "String"
            ]
          ],
          "return_type": null,
          "script": "const k = (rec && rec.rawKey !== undefined) ? rec.rawKey : rawKey;\nif (!k || !String(k).startsWith(\"bos_live_\")) {\n    return { valid: false, reason: \"INVALID_KEY_FORMAT\" };\n}\n\nconst keyHash = ctx.crypto.sha256(String(k).trim());\nconst keyRecords = ApiKey.find({ keyHash: keyHash }) || [];\nif (keyRecords.length === 0) {\n    return { valid: false, reason: \"KEY_NOT_FOUND\" };\n}\n\nconst keyRecord = keyRecords[0];\nif (keyRecord.status !== \"Active\") {\n    return { valid: false, reason: `KEY_${keyRecord.status.toUpperCase()}` };\n}\n\nif (keyRecord.expiresAt && new Date(keyRecord.expiresAt) <= new Date()) {\n    ApiKey.update(keyRecord.id, { status: \"Expired\" });\n    return { valid: false, reason: \"KEY_EXPIRED\" };\n}\n\nApiKey.update(keyRecord.id, { lastUsedAt: new Date().toISOString() });\n\nreturn {\n    valid: true,\n    name: keyRecord.name,\n    scopes: (keyRecord.scopes || \"api:read\").split(\",\").map(s => s.trim()),\n    createdBy: keyRecord.createdBy\n};",
          "trigger_event": null
        },
        {
          "actions": [],
          "annotations": [],
          "is_public": true,
          "is_pushdown": false,
          "is_static": false,
          "name": "RevokeApiKey",
          "params": [
            [
              "keyId",
              "UUID"
            ]
          ],
          "return_type": null,
          "script": "const id = (rec && rec.keyId !== undefined) ? rec.keyId : keyId;\nif (!id) throw new Error(\"Key ID is required.\");\n\nApiKey.update(id, { status: \"Revoked\" });\n\nSecurityAuditLog.insert({\n    username: \"system\",\n    action: \"RoleRevoked\",\n    details: `API Key '${id}' revoked.`,\n    isSuccess: true\n});\n\nreturn { success: true, id: id, status: \"Revoked\" };",
          "trigger_event": null
        }
      ],
      "name": "IntegrationManager",
      "object_type": "codeunit",
      "package_name": "bos.core",
      "version": "1.0.0",
      "feature": "Integration"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "CoreSetupLogic",
      "object_type": "tablelogic",
      "package_name": "bos.core",
      "sql_table_name": "core_setup",
      "target_table": "CoreSetup",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.primaryKeyCode || String(rec.primaryKeyCode).trim().length === 0) {\n    rec.primaryKeyCode = \"PRIMARY\";\n}\nif (!rec.applicationTitle || String(rec.applicationTitle).trim().length === 0) {\n    rec.applicationTitle = \"BOS Business Operating System\";\n}\nif (rec.allowPostingFrom && rec.allowPostingTo) {\n    if (new Date(rec.allowPostingFrom) > new Date(rec.allowPostingTo)) {\n        throw new Error(\"Validation Failed: 'allowPostingFrom' date cannot be after 'allowPostingTo' date.\");\n    }\n}"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (!rec.applicationTitle || String(rec.applicationTitle).trim().length === 0) {\n    throw new Error(\"Validation Failed: 'applicationTitle' cannot be blank.\");\n}\nif (rec.allowPostingFrom && rec.allowPostingTo) {\n    if (new Date(rec.allowPostingFrom) > new Date(rec.allowPostingTo)) {\n        throw new Error(\"Validation Failed: 'allowPostingFrom' date cannot be after 'allowPostingTo' date.\");\n    }\n}"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.primaryKeyCode === \"PRIMARY\") {\n    throw new Error(\"Validation Failed: The 'PRIMARY' CoreSetup configuration row cannot be deleted.\");\n}"
        }
      ],
      "version": "1.0.0",
      "feature": "AppManagement"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "TenantLogic",
      "object_type": "tablelogic",
      "package_name": "bos.core",
      "sql_table_name": "tenant",
      "target_table": "Tenant",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: Tenant 'code' is required.\");\n}\nrec.code = String(rec.code).toLowerCase().trim();\nif (!/^[a-z0-9][a-z0-9._-]{1,49}$/.test(rec.code)) {\n    throw new Error(\"Validation Failed: Tenant code must be alphanumeric with dots, hyphens or underscores.\");\n}\nif (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Tenant 'name' is required.\");\n}\nif (rec.maxUsers !== undefined && rec.maxUsers < 1) {\n    throw new Error(\"Validation Failed: 'maxUsers' must be at least 1.\");\n}"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Tenant 'name' cannot be blank.\");\n}"
        }
      ],
      "version": "1.0.0",
      "feature": "AppManagement"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "CompanyLogic",
      "object_type": "tablelogic",
      "package_name": "bos.core",
      "sql_table_name": "company",
      "target_table": "Company",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: Company 'code' is required.\");\n}\nrec.code = String(rec.code).toUpperCase().trim();\nif (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Company 'name' is required.\");\n}\nif (rec.fiscalYearStartMonth !== undefined && (rec.fiscalYearStartMonth < 1 || rec.fiscalYearStartMonth > 12)) {\n    throw new Error(\"Validation Failed: 'fiscalYearStartMonth' must be between 1 and 12.\");\n}"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Company 'name' cannot be blank.\");\n}"
        }
      ],
      "version": "1.0.0",
      "feature": "AppManagement"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "CurrencyLogic",
      "object_type": "tablelogic",
      "package_name": "bos.core",
      "sql_table_name": "currency",
      "target_table": "Currency",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: Currency 'code' is required.\");\n}\nrec.code = String(rec.code).toUpperCase().trim();\nif (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Currency 'name' is required.\");\n}\nif (rec.decimalPlaces !== undefined && (rec.decimalPlaces < 0 || rec.decimalPlaces > 4)) {\n    throw new Error(\"Validation Failed: 'decimalPlaces' must be between 0 and 4.\");\n}"
        }
      ],
      "version": "1.0.0",
      "feature": "AppManagement"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "CountryRegionLogic",
      "object_type": "tablelogic",
      "package_name": "bos.core",
      "sql_table_name": "country_region",
      "target_table": "CountryRegion",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: Country 'code' is required.\");\n}\nrec.code = String(rec.code).toUpperCase().trim();\nif (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Country 'name' is required.\");\n}"
        }
      ],
      "version": "1.0.0",
      "feature": "AppManagement"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "UserLogic",
      "object_type": "tablelogic",
      "package_name": "bos.core",
      "sql_table_name": "user",
      "target_table": "User",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.username || String(rec.username).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'username' is required.\");\n}\nrec.username = String(rec.username).trim();\n\nif (rec.username.length < 3 || rec.username.length > 50) {\n    throw new Error(\"Validation Failed: 'username' length must be between 3 and 50 characters.\");\n}\n\nif (!/^[a-zA-Z0-9_\\-\\.@]+$/.test(rec.username)) {\n    throw new Error(\"Validation Failed: 'username' can only contain alphanumeric characters, dots, underscores, dashes, and at-signs.\");\n}\n\nif (!rec.email || String(rec.email).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'email' is required.\");\n}\nrec.email = String(rec.email).toLowerCase().trim();\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(rec.email)) {\n    throw new Error(\"Validation Failed: Field 'email' must be a valid email format.\");\n}\n\nif (rec.password) {\n    const rawPassword = String(rec.password);\n    if (rawPassword.length < 6) {\n        throw new Error(\"Validation Failed: Password must be at least 6 characters.\");\n    }\n    rec.passwordHash = (rawPassword.startsWith(\"$2\") || rawPassword.startsWith(\"$argon2\"))\n        ? rawPassword\n        : ctx.crypto.bcryptHash(rawPassword);\n    delete rec.password;\n} else if (rec.passwordHash && (!String(rec.passwordHash).startsWith(\"$2\") && !String(rec.passwordHash).startsWith(\"$argon2\"))) {\n    rec.passwordHash = ctx.crypto.bcryptHash(rec.passwordHash);\n}\n\nif (!rec.passwordHash) {\n    throw new Error(\"Validation Failed: Field 'passwordHash' or 'password' is required.\");\n}\n\nif (rec.failedAttempts === undefined || rec.failedAttempts === null) {\n    rec.failedAttempts = 0;\n}\n\nif (rec.isActive === undefined || rec.isActive === null) {\n    rec.isActive = true;\n}\n\nif (!rec.status) {\n    rec.status = \"Active\";\n}\n\nrec.passwordChangedAt = new Date().toISOString();"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (rec.username && xRec.username && rec.username !== xRec.username) {\n    throw new Error(\"Mutation Rejected: Field 'username' is the immutable primary key and cannot be altered.\");\n}\n\nif (rec.email !== undefined) {\n    rec.email = String(rec.email).toLowerCase().trim();\n    if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(rec.email)) {\n        throw new Error(\"Validation Failed: Field 'email' must be a valid email format.\");\n    }\n}\n\nif (rec.password) {\n    const rawPassword = String(rec.password);\n    if (rawPassword.length < 6) {\n        throw new Error(\"Validation Failed: Password must be at least 6 characters.\");\n    }\n    rec.passwordHash = (rawPassword.startsWith(\"$2\") || rawPassword.startsWith(\"$argon2\"))\n        ? rawPassword\n        : ctx.crypto.bcryptHash(rawPassword);\n    rec.passwordChangedAt = new Date().toISOString();\n    delete rec.password;\n} else if (rec.passwordHash && rec.passwordHash !== xRec.passwordHash && (!String(rec.passwordHash).startsWith(\"$2\") && !String(rec.passwordHash).startsWith(\"$argon2\"))) {\n    rec.passwordHash = ctx.crypto.bcryptHash(rec.passwordHash);\n    rec.passwordChangedAt = new Date().toISOString();\n}"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.username === \"admin\") {\n    throw new Error(\"Deletion Rejected: The built-in root administrator account 'admin' cannot be deleted.\");\n}"
        }
      ],
      "version": "1.0.0",
      "feature": "UserManagement"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "RoleLogic",
      "object_type": "tablelogic",
      "package_name": "bos.core",
      "sql_table_name": "role",
      "target_table": "Role",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'code' is required for Role.\");\n}\nrec.code = String(rec.code).toUpperCase().trim();\n\nif (!/^[A-Z0-9_]{2,30}$/.test(rec.code)) {\n    throw new Error(\"Validation Failed: Role code must be uppercase alphanumeric/underscore between 2 and 30 characters.\");\n}\n\nif (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Field 'name' is required for Role.\");\n}\nrec.name = String(rec.name).trim();\n\nif (rec.isSystemRole === undefined) {\n    rec.isSystemRole = false;\n}"
        },
        {
          "actions": [],
          "name": "onModify",
          "params": [
            "rec",
            "xRec",
            "ctx"
          ],
          "script": "if (xRec.isSystemRole && rec.isActive === false) {\n    throw new Error(\"System Protection: Built-in system roles cannot be deactivated.\");\n}"
        },
        {
          "actions": [],
          "name": "onDelete",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (rec.isSystemRole || rec.code === \"SUPER\" || rec.code === \"ADMIN\") {\n    throw new Error(\"Deletion Blocked: System baseline roles cannot be deleted.\");\n}"
        }
      ],
      "version": "1.0.0",
      "feature": "UserManagement"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "UserRoleLogic",
      "object_type": "tablelogic",
      "package_name": "bos.core",
      "sql_table_name": "user_role",
      "target_table": "UserRole",
      "triggers": [
        {
          "actions": [],
          "name": "onInsert",
          "params": [
            "rec",
            "ctx"
          ],
          "script": "if (!rec.username || !rec.roleCode) {\n    throw new Error(\"Validation Failed: Both 'username' and 'roleCode' are required.\");\n}\nrec.username = String(rec.username).trim();\nrec.roleCode = String(rec.roleCode).toUpperCase().trim();"
        }
      ],
      "version": "1.0.0",
      "feature": "UserManagement"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "UserGroupLogic",
      "object_type": "tablelogic",
