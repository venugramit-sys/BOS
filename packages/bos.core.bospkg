          ],
          "script": "if (!rec.code || String(rec.code).trim().length === 0) {\n    throw new Error(\"Validation Failed: Group 'code' is required.\");\n}\nrec.code = String(rec.code).toUpperCase().trim();\nif (!rec.name || String(rec.name).trim().length === 0) {\n    throw new Error(\"Validation Failed: Group 'name' is required.\");\n}"
        }
      ],
      "version": "1.0.0",
      "feature": "UserManagement"
    },
    {
      "field_validations": [],
      "methods": [],
      "name": "UserGroupMemberLogic",
      "object_type": "tablelogic",
      "package_name": "bos.core",
      "sql_table_name": "user_group_member",
      "target_table": "UserGroupMember",
      "triggers": [
        {
          "actions": [],
