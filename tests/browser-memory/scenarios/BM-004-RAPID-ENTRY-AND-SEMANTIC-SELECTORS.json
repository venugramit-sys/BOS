    {
      "action": "navigate",
      "url": "/",
      "description": "Navigate to workspace"
    },
    {
      "action": "fill",
      "selector": "input[type='text'], input[placeholder*='user' i]",
      "value": "admin",
      "description": "Enter Super Admin user"
    },
    {
      "action": "fill",
      "selector": "input[type='password'], input[placeholder*='password' i]",
      "value": "Boss@123",
      "description": "Enter password"
    },
    {
      "action": "click",
      "selector": "button:has-text('Sign In')",
      "delayAfterMs": 1500,
      "description": "Sign in"
    },
    {
      "action": "assert_visible",
      "selector": "button:has-text('Company Transaction List')",
      "timeout": 20000,
      "description": "Wait for catalog pages to hydrate in navigation"
    },
    {
      "action": "click",
      "selector": "button:has-text('Company Transaction List')",
      "delayAfterMs": 1000,
      "description": "Open Company Transaction List tab"
    },
    {
      "action": "assert_visible",
      "selector": "[data-bos-page='CompanyTransactionList']",
      "timeout": 15000,
      "description": "Verify semantic data-bos-page AST attribute is rendered on PageFrame"
    },
    {
      "action": "assert_visible",
      "selector": "[data-bos-action='new']",
      "description": "Verify semantic data-bos-action attribute on New action button"
    },
    {
      "action": "click",
      "selector": "[data-bos-action='new']",
      "delayAfterMs": 500,
      "description": "Click New action button using semantic selector"
    },
    {
      "action": "assert_visible",
      "selector": "[data-bos-action='save']",
      "description": "Verify semantic data-bos-action='save' is active in dirty state"
    },
    {
      "action": "screenshot",
      "name": "semantic_ast_and_draft_active",
